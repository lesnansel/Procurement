\", _hoisted_4, [_cache[4] || (_cache[4] = _createElementVNode(\"label\", {\n    class: \"form-label\"\n  }, \"Supplier\", -1 /* HOISTED */)), _withDirectives(_createElementVNode(\"input\", {\n    \"onUpdate:modelValue\": _cache[0] || (_cache[0] = $event => $setup.newContract.supplier = $event),\n    type: \"text\",\n    class: \"input-field\",\n    placeholder: \"Enter supplier name\",\n    required: \"\"\n  }, null, 512 /* NEED_PATCH */), [[_vModelText, $setup.newContract.supplier]])]), _createElementVNode(\"div\", _hoisted_5, [_cache[5] || (_cache[5] = _createElementVNode(\"label\", {\n    class: \"form-label\"\n  }, \"PO Number\", -1 /* HOISTED */)), _withDirectives(_createElementVNode(\"input\", {\n    \"onUpdate:modelValue\": _cache[1] || (_cache[1] = $event => $setup.newContract.poNumber = $event),\n    type: \"text\",\n    class: \"input-field\",\n    placeholder: \"Enter PO number\",\n    required: \"\"\n  }, null, 512 /* NEED_PATCH */), [[_vModelText, $setup.newContract.poNumber]])]), _createElementVNode(\"div\", _hoisted_6, [_cache[7] || (_cache[7] = _createElementVNode(\"label\", {\n    class: \"form-label\"\n  }, \"Status\", -1 /* HOISTED */)), _withDirectives(_createElementVNode(\"select\", {\n    \"onUpdate:modelValue\": _cache[2] || (_cache[2] = $event => $setup.newContract.status = $event),\n    class: \"input-field\",\n    required: \"\"\n  }, _cache[6] || (_cache[6] = [_createElementVNode(\"option\", {\n    value: \"Pending\"\n  }, \"Pending\", -1 /* HOISTED */), _createElementVNode(\"option\", {\n    value: \"Active\"\n  }, \"Active\", -1 /* HOISTED */), _createElementVNode(\"option\", {\n    value: \"Completed\"\n  }, \"Completed\", -1 /* HOISTED */)]), 512 /* NEED_PATCH */), [[_vModelSelect, $setup.newContract.status]])]), _cache[8] || (_cache[8] = _createElementVNode(\"button\", {\n    type: \"submit\",\n    class: \"btn-primary\"\n  }, \"Add Contract\", -1 /* HOISTED */))], 32 /* NEED_HYDRATION */), $setup.contracts.length === 0 ? (_openBlock(), _createElementBlock(\"p\", _hoisted_7, \"No contracts available.\")) : _createCommentVNode(\"v-if\", true)])])]);\n}","map":{"version":3,"names":["_imports_0","class","key","_createElementBlock","_hoisted_1","_createCommentVNode","_createElementVNode","_hoisted_2","_createStaticVNode","_hoisted_3","onSubmit","_cache","_withModifiers","args","$setup","addContract","_hoisted_4","$event","newContract","supplier","type","placeholder","required","_hoisted_5","poNumber","_hoisted_6","status","value","contracts","length","_hoisted_7"],"sources":["C:\\laragon\\www\\Capstone\\Connected to github\\Procurement\\GovProcure\\src\\components\\ContractManagement.vue"],"sourcesContent":["<template>\r\n  <div class=\"admin-wrapper\">\r\n    <!-- Background Pattern -->\r\n    <div class=\"background-pattern\">\r\n      <div class=\"pattern-overlay\"></div>\r\n    </div>\r\n\r\n    <!-- Admin Card -->\r\n    <div class=\"admin-card contract-management-card\">\r\n      <div class=\"card-header\">\r\n        <div class=\"logo-container\">\r\n          <img src=\"@/assets/proculogo.png\" alt=\"Procurement System Logo\" class=\"logo\" />\r\n        </div>\r\n        <h1 class=\"title\">Contract Management</h1>\r\n        <p class=\"subtitle\">Manage all contracts efficiently</p>\r\n      </div>\r\n\r\n      <div class=\"card-content\">\r\n        <!-- Add Contract Form -->\r\n        <form @submit.prevent=\"addContract\" class=\"form\">\r\n          <div class=\"form-group\">\r\n            <label class=\"form-label\">Supplier</label>\r\n            <input v-model=\"newContract.supplier\" type=\"text\" class=\"input-field\" placeholder=\"Enter supplier name\" required />\r\n          </div>\r\n          <div class=\"form-group\">\r\n            <label class=\"form-label\">PO Number</label>\r\n            <input v-model=\"newContract.poNumber\" type=\"text\" class=\"input-field\" placeholder=\"Enter PO number\" required />\r\n          </div>\r\n          <div class=\"form-group\">\r\n            <label class=\"form-label\">Status</label>\r\n            <select v-model=\"newContract.status\" class=\"input-field\" required>\r\n              <option value=\"Pending\">Pending</option>\r\n              <option value=\"Active\">Active</option>\r\n              <option value=\"Completed\">Completed</option>\r\n            </select>\r\n          </div>\r\n          <button type=\"submit\" class=\"btn-primary\">Add Contract</button>\r\n        </form>\r\n        <p v-if=\"contracts.length === 0\" class=\"no-contracts\">No contracts available.</p>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted } from \"vue\";\r\nimport { db } from \"@/firebase\";\r\nimport { collection, addDoc, getDocs, updateDoc, deleteDoc, doc } from \"firebase/firestore\";\r\n\r\nexport default {\r\n  setup() {\r\n    const contracts = ref([]);\r\n    const newContract = ref({ supplier: \"\", poNumber: \"\", status: \"Pending\" });\r\n    const isEditing = ref(false);\r\n    const editContractData = ref({});\r\n    const editContractIndex = ref(null);\r\n\r\n    const fetchContracts = async () => {\r\n      const querySnapshot = await getDocs(collection(db, \"contracts\"));\r\n      contracts.value = querySnapshot.docs.map((doc) => ({ id: doc.id, ...doc.data() }));\r\n    };\r\n\r\n    const addContract = async () => {\r\n      try {\r\n        await addDoc(collection(db, \"contracts\"), newContract.value);\r\n        alert(\"Contract added successfully\");\r\n        newContract.value = { supplier: \"\", poNumber: \"\", status: \"Pending\" };\r\n        fetchContracts();\r\n      } catch (error) {\r\n        console.error(\"Error adding contract:\", error);\r\n        alert(\"Failed to add contract. Please try again.\");\r\n      }\r\n    };\r\n\r\n    const editContract = (index) => {\r\n      editContractIndex.value = index;\r\n      editContractData.value = { ...contracts.value[index] };\r\n      isEditing.value = true;\r\n    };\r\n\r\n    const updateContract = async () => {\r\n      try {\r\n        const contractRef = doc(db, \"contracts\", editContractData.value.id);\r\n        await updateDoc(contractRef, {\r\n          supplier: editContractData.value.supplier,\r\n          poNumber: editContractData.value.poNumber,\r\n          status: editContractData.value.status,\r\n        });\r\n        alert(\"Contract updated successfully\");\r\n        isEditing.value = false;\r\n        fetchContracts();\r\n      } catch (error) {\r\n        console.error(\"Error updating contract:\", error);\r\n        alert(\"Failed to update contract. Please try again.\");\r\n      }\r\n    };\r\n\r\n    const deleteContract = async (id) => {\r\n      if (confirm(\"Are you sure you want to delete this contract?\")) {\r\n        try {\r\n          await deleteDoc(doc(db, \"contracts\", id));\r\n          alert(\"Contract deleted successfully\");\r\n          fetchContracts();\r\n        } catch (error) {\r\n          console.error(\"Error deleting contract:\", error);\r\n          alert(\"Failed to delete contract. Please try again.\");\r\n        }\r\n      }\r\n    };\r\n\r\n    onMounted(fetchContracts);\r\n\r\n    return {\r\n      contracts,\r\n      newContract,\r\n      isEditing,\r\n      editContractData,\r\n      addContract,\r\n      editContract,\r\n      updateContract,\r\n      deleteContract,\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.admin-wrapper {\r\n  min-height: 100vh;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 20px;\r\n  position: relative;\r\n  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;\r\n}\r\n\r\n/* Background Pattern */\r\n.background-pattern {\r\n  position: fixed;\r\n  inset: 0;\r\n  background-color: #1a1a2e;\r\n  z-index: -1;\r\n  overflow: hidden;\r\n}\r\n\r\n.pattern-overlay {\r\n  position: absolute;\r\n  inset: 0;\r\n  background-image: \r\n    linear-gradient(30deg, rgba(16, 42, 66, 0.5) 12%, transparent 12.5%, transparent 87%, rgba(16, 42, 66, 0.5) 87.5%, rgba(16, 42, 66, 0.5)),\r\n    linear-gradient(150deg, rgba(16, 42, 66, 0.5) 12%, transparent 12.5%, transparent 87%, rgba(16, 42, 66, 0.5) 87.5%, rgba(16, 42, 66, 0.5)),\r\n    linear-gradient(30deg, rgba(16, 42, 66, 0.5) 12%, transparent 12.5%, transparent 87%, rgba(16, 42, 66, 0.5) 87.5%, rgba(16, 42, 66, 0.5)),\r\n    linear-gradient(150deg, rgba(16, 42, 66, 0.5) 12%, transparent 12.5%, transparent 87%, rgba(16, 42, 66, 0.5) 87.5%, rgba(16, 42, 66, 0.5)),\r\n    linear-gradient(60deg, rgba(0, 0, 0, 0.1) 25%, transparent 25.5%, transparent 75%, rgba(0, 0, 0, 0.1) 75%, rgba(0, 0, 0, 0.1)),\r\n    linear-gradient(60deg, rgba(0, 0, 0, 0.1) 25%, transparent 25.5%, transparent 75%, rgba(0, 0, 0, 0.1) 75%, rgba(0, 0, 0, 0.1));\r\n  background-size: 80px 140px;\r\n  background-position: 0 0, 0 0, 40px 70px, 40px 70px, 0 0, 40px 70px;\r\n  opacity: 0.2;\r\n}\r\n\r\n/* Card Design */\r\n.admin-card {\r\n  width: 100%;\r\n  max-width: 1200px;\r\n  background-color: #fff;\r\n  border-radius: 12px;\r\n  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);\r\n  overflow: hidden;\r\n  position: relative;\r\n}\r\n\r\n.contract-management-card {\r\n  max-width: 400px;\r\n  margin: auto;\r\n  border-radius: 16px;\r\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);\r\n}\r\n\r\n.card-header {\r\n  text-align: center;\r\n  padding: 20px;\r\n  background-color: #0f2942;\r\n  color: white;\r\n  border-top-left-radius: 16px;\r\n  border-top-right-radius: 16px;\r\n}\r\n\r\n.logo-container {\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.logo {\r\n  width: 70px;\r\n  height: 70px;\r\n  object-fit: contain;\r\n}\r\n\r\n.title {\r\n  font-size: 1.75rem;\r\n  font-weight: 700;\r\n  margin-bottom: 8px;\r\n}\r\n\r\n.subtitle {\r\n  font-size: 0.95rem;\r\n  opacity: 0.8;\r\n}\r\n\r\n.card-content {\r\n  padding: 20px;\r\n}\r\n\r\n/* Table Design */\r\n.table-container {\r\n  overflow-x: auto;\r\n}\r\n\r\n.contracts-table {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n}\r\n\r\n.contracts-table th,\r\n.contracts-table td {\r\n  padding: 12px;\r\n  text-align: left;\r\n  border-bottom: 1px solid #e2e8f0;\r\n}\r\n\r\n.contracts-table th {\r\n  background-color: #2c5282;\r\n  color: white;\r\n  font-weight: bold;\r\n  font-size: 15px;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.contracts-table td {\r\n  color: #4a5568;\r\n  font-size: 14px;\r\n}\r\n\r\n.contracts-table tr:hover td {\r\n  background-color: #ebf8ff;\r\n}\r\n\r\n.loading-state {\r\n  text-align: center;\r\n  color: #1a202c;\r\n  font-size: 16px;\r\n  font-weight: bold;\r\n}\r\n\r\n/* Enhanced Input Fields */\r\n.input-field {\r\n  width: 100%;\r\n  padding: 10px;\r\n  border: 1px solid #cbd5e0;\r\n  border-radius: 6px;\r\n  font-size: 14px;\r\n  color: #2d3748;\r\n  background-color: #f7fafc;\r\n  margin-top: 5px;\r\n}\r\n\r\n.input-field:focus {\r\n  border-color: #3182ce;\r\n  outline: none;\r\n  background-color: #ffffff;\r\n}\r\n\r\n/* Enhanced Buttons */\r\n.btn-primary {\r\n  width: 100%;\r\n  background-color: #3182ce;\r\n  color: white;\r\n  padding: 10px;\r\n  border-radius: 8px;\r\n  font-size: 14px;\r\n  font-weight: bold;\r\n  border: none;\r\n  cursor: pointer;\r\n  transition: background-color 0.3s ease;\r\n}\r\n\r\n.btn-primary:hover {\r\n  background-color: #2b6cb0;\r\n}\r\n\r\n.btn-danger {\r\n  background-color: #e53e3e;\r\n  color: white;\r\n  padding: 5px 10px;\r\n  border-radius: 6px;\r\n  font-size: 12px;\r\n  border: none;\r\n  cursor: pointer;\r\n  transition: background-color 0.3s ease;\r\n}\r\n\r\n.btn-danger:hover {\r\n  background-color: #c53030;\r\n}\r\n\r\n.btn-link {\r\n  background: none;\r\n  color: #3182ce;\r\n  font-size: 12px;\r\n  text-decoration: underline;\r\n  cursor: pointer;\r\n}\r\n\r\n.btn-link:hover {\r\n  color: #2b6cb0;\r\n}\r\n\r\n/* Enhanced Modal */\r\n.modal {\r\n  background-color: #ffffff;\r\n  padding: 20px;\r\n  border-radius: 8px;\r\n  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);\r\n  max-width: 500px;\r\n  width: 100%;\r\n}\r\n\r\n.modal-title {\r\n  font-size: 18px;\r\n  font-weight: bold;\r\n  color: #2d3748;\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.modal-actions button {\r\n  padding: 8px 16px;\r\n  font-size: 14px;\r\n}\r\n\r\n/* Form Label Styling */\r\n.form-label {\r\n  font-size: 14px;\r\n  font-weight: 600;\r\n  color: #2d3748;\r\n  margin-bottom: 5px;\r\n  display: block;\r\n}\r\n\r\n/* Input Placeholder Styling */\r\n.input-field::placeholder {\r\n  color: #a0aec0;\r\n  font-size: 14px;\r\n}\r\n\r\n.no-contracts {\r\n  text-align: center;\r\n  color: #666;\r\n  font-size: 14px;\r\n  margin-top: 20px;\r\n}\r\n</style>"],"mappings":";OAWeA,UAA4B;;EAVpCC,KAAK,EAAC;AAAe;;EAOnBA,KAAK,EAAC;AAAqC;;EASzCA,KAAK,EAAC;AAAc;;EAGhBA,KAAK,EAAC;AAAY;;EAIlBA,KAAK,EAAC;AAAY;;EAIlBA,KAAK,EAAC;AAAY;;EA5BjCC,GAAA;EAsCyCD,KAAK,EAAC;;;uBArC7CE,mBAAA,CAwCM,OAxCNC,UAwCM,GAvCJC,mBAAA,wBAA2B,E,4BAC3BC,mBAAA,CAEM;IAFDL,KAAK,EAAC;EAAoB,IAC7BK,mBAAA,CAAmC;IAA9BL,KAAK,EAAC;EAAiB,G,sBAG9BI,mBAAA,gBAAmB,EACnBC,mBAAA,CAgCM,OAhCNC,UAgCM,G,0BAxCVC,kBAAA,0GAAAR,UAAA,gOAiBMM,mBAAA,CAsBM,OAtBNG,UAsBM,GArBJJ,mBAAA,uBAA0B,EAC1BC,mBAAA,CAkBO;IAlBAI,QAAM,EAAAC,MAAA,QAAAA,MAAA,MAnBrBC,cAAA,KAAAC,IAAA,KAmB+BC,MAAA,CAAAC,WAAA,IAAAD,MAAA,CAAAC,WAAA,IAAAF,IAAA,CAAW;IAAEZ,KAAK,EAAC;MACxCK,mBAAA,CAGM,OAHNU,UAGM,G,0BAFJV,mBAAA,CAA0C;IAAnCL,KAAK,EAAC;EAAY,GAAC,UAAQ,sB,gBAClCK,mBAAA,CAAmH;IAtB/H,uBAAAK,MAAA,QAAAA,MAAA,MAAAM,MAAA,IAsB4BH,MAAA,CAAAI,WAAW,CAACC,QAAQ,GAAAF,MAAA;IAAEG,IAAI,EAAC,MAAM;IAACnB,KAAK,EAAC,aAAa;IAACoB,WAAW,EAAC,qBAAqB;IAACC,QAAQ,EAAR;iDAAxFR,MAAA,CAAAI,WAAW,CAACC,QAAQ,E,KAEtCb,mBAAA,CAGM,OAHNiB,UAGM,G,0BAFJjB,mBAAA,CAA2C;IAApCL,KAAK,EAAC;EAAY,GAAC,WAAS,sB,gBACnCK,mBAAA,CAA+G;IA1B3H,uBAAAK,MAAA,QAAAA,MAAA,MAAAM,MAAA,IA0B4BH,MAAA,CAAAI,WAAW,CAACM,QAAQ,GAAAP,MAAA;IAAEG,IAAI,EAAC,MAAM;IAACnB,KAAK,EAAC,aAAa;IAACoB,WAAW,EAAC,iBAAiB;IAACC,QAAQ,EAAR;iDAApFR,MAAA,CAAAI,WAAW,CAACM,QAAQ,E,KAEtClB,mBAAA,CAOM,OAPNmB,UAOM,G,0BANJnB,mBAAA,CAAwC;IAAjCL,KAAK,EAAC;EAAY,GAAC,Q