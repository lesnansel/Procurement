{"ast":null,"code":"import \"core-js/modules/esnext.iterator.map.js\";\nimport { ref, onMounted } from \"vue\";\nimport { db } from \"@/firebase\";\nimport { collection, addDoc, getDocs } from \"firebase/firestore\";\nexport default {\n  setup() {\n    const contracts = ref([]);\n    const newContract = ref({\n      supplier: \"\",\n      poNumber: \"\",\n      status: \"Active\"\n    });\n    const fetchContracts = async () => {\n      const querySnapshot = await getDocs(collection(db, \"contracts\"));\n      contracts.value = querySnapshot.docs.map(doc => ({\n        id: doc.id,\n        ...doc.data()\n      }));\n    };\n    const addContract = async () => {\n      try {\n        await addDoc(collection(db, \"contracts\"), newContract.value);\n        alert(\"Contract added successfully\");\n        newContract.value = {\n          supplier: \"\",\n          poNumber: \"\",\n          status: \"Active\"\n        };\n        fetchContracts();\n      } catch (error) {\n        console.error(\"Error adding contract:\", error);\n        alert(\"Failed to add contract. Please try again.\");\n      }\n    };\n    onMounted(fetchContracts);\n    return {\n      contracts,\n      newContract,\n      addContract\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","db","collection","addDoc","getDocs","setup","contracts","newContract","supplier","poNumber","status","fetchContracts","querySnapshot","value","docs","map","doc","id","data","addContract","alert","error","console"],"sources":["C:\\laragon\\www\\Capstone\\Connected to github\\Procurement\\GovProcure\\src\\components\\ContractManagement.vue"],"sourcesContent":["<template>\r\n  <div class=\"contract-management-wrapper\">\r\n    <!-- Header Section -->\r\n    <header class=\"header\">\r\n      <img src=\"@/assets/logo.png\" alt=\"Vue Logo\" class=\"vue-logo\" />\r\n      <h1 class=\"header-title\">Contract Management</h1>\r\n      <p class=\"header-subtitle\">Manage all contracts efficiently</p>\r\n    </header>\r\n\r\n    <!-- Form Section -->\r\n    <div class=\"form-container\">\r\n      <form @submit.prevent=\"addContract\" class=\"contract-form\">\r\n        <div class=\"form-group\">\r\n          <label for=\"supplier\" class=\"form-label\">Supplier</label>\r\n          <input v-model=\"newContract.supplier\" id=\"supplier\" type=\"text\" class=\"form-input\" placeholder=\"Enter supplier name\" required />\r\n        </div>\r\n        <div class=\"form-group\">\r\n          <label for=\"poNumber\" class=\"form-label\">PO Number</label>\r\n          <input v-model=\"newContract.poNumber\" id=\"poNumber\" type=\"text\" class=\"form-input\" placeholder=\"Enter PO number\" required />\r\n        </div>\r\n        <div class=\"form-group\">\r\n          <label class=\"form-label\">Status</label>\r\n          <div class=\"status-options\">\r\n            <label class=\"status-option\">\r\n              <input v-model=\"newContract.status\" type=\"radio\" value=\"Active\" /> Active\r\n            </label>\r\n            <label class=\"status-option\">\r\n              <input v-model=\"newContract.status\" type=\"radio\" value=\"Pending\" /> Pending\r\n            </label>\r\n          </div>\r\n        </div>\r\n        <button type=\"submit\" class=\"submit-button\">Add Contract</button>\r\n      </form>\r\n    </div>\r\n\r\n    <!-- No Contracts Message -->\r\n    <p v-if=\"!contracts.length\" class=\"no-contracts-message\">No contracts available.</p>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted } from \"vue\";\r\nimport { db } from \"@/firebase\";\r\nimport { collection, addDoc, getDocs } from \"firebase/firestore\";\r\n\r\nexport default {\r\n  setup() {\r\n    const contracts = ref([]);\r\n    const newContract = ref({ supplier: \"\", poNumber: \"\", status: \"Active\" });\r\n\r\n    const fetchContracts = async () => {\r\n      const querySnapshot = await getDocs(collection(db, \"contracts\"));\r\n      contracts.value = querySnapshot.docs.map((doc) => ({ id: doc.id, ...doc.data() }));\r\n    };\r\n\r\n    const addContract = async () => {\r\n      try {\r\n        await addDoc(collection(db, \"contracts\"), newContract.value);\r\n        alert(\"Contract added successfully\");\r\n        newContract.value = { supplier: \"\", poNumber: \"\", status: \"Active\" };\r\n        fetchContracts();\r\n      } catch (error) {\r\n        console.error(\"Error adding contract:\", error);\r\n        alert(\"Failed to add contract. Please try again.\");\r\n      }\r\n    };\r\n\r\n    onMounted(fetchContracts);\r\n\r\n    return {\r\n      contracts,\r\n      newContract,\r\n      addContract,\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.contract-management-wrapper {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  padding: 20px;\r\n  font-family: 'Arial', sans-serif;\r\n  background-color: #f9fafb;\r\n  min-height: 100vh;\r\n}\r\n\r\n/* Header Styles */\r\n.header {\r\n  text-align: center;\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.vue-logo {\r\n  width: 60px;\r\n  height: 60px;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.header-title {\r\n  font-size: 24px;\r\n  font-weight: bold;\r\n  color: #2c3e50;\r\n}\r\n\r\n.header-subtitle {\r\n  font-size: 14px;\r\n  color: #7f8c8d;\r\n}\r\n\r\n/* Form Section */\r\n.form-container {\r\n  background: #ffffff;\r\n  padding: 20px;\r\n  border-radius: 8px;\r\n  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);\r\n  width: 100%;\r\n  max-width: 400px;\r\n}\r\n\r\n.contract-form {\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.form-group {\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.form-label {\r\n  font-size: 14px;\r\n  font-weight: 600;\r\n  color: #34495e;\r\n  margin-bottom: 5px;\r\n  display: block;\r\n}\r\n\r\n.form-input {\r\n  width: 100%;\r\n  padding: 10px;\r\n  border: 1px solid #dcdfe6;\r\n  border-radius: 4px;\r\n  font-size: 14px;\r\n  color: #2c3e50;\r\n}\r\n\r\n.status-options {\r\n  display: flex;\r\n  gap: 10px;\r\n}\r\n\r\n.status-option {\r\n  font-size: 14px;\r\n  color: #34495e;\r\n}\r\n\r\n.submit-button {\r\n  background-color: #3498db;\r\n  color: #ffffff;\r\n  padding: 10px;\r\n  border: none;\r\n  border-radius: 4px;\r\n  font-size: 14px;\r\n  font-weight: bold;\r\n  cursor: pointer;\r\n  transition: background-color 0.3s ease;\r\n}\r\n\r\n.submit-button:hover {\r\n  background-color: #2980b9;\r\n}\r\n\r\n/* No Contracts Message */\r\n.no-contracts-message {\r\n  margin-top: 20px;\r\n  font-size: 14px;\r\n  color: #7f8c8d;\r\n}\r\n</style>"],"mappings":";AAyCA,SAASA,GAAG,EAAEC,SAAQ,QAAS,KAAK;AACpC,SAASC,EAAC,QAAS,YAAY;AAC/B,SAASC,UAAU,EAAEC,MAAM,EAAEC,OAAM,QAAS,oBAAoB;AAEhE,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN,MAAMC,SAAQ,GAAIP,GAAG,CAAC,EAAE,CAAC;IACzB,MAAMQ,WAAU,GAAIR,GAAG,CAAC;MAAES,QAAQ,EAAE,EAAE;MAAEC,QAAQ,EAAE,EAAE;MAAEC,MAAM,EAAE;IAAS,CAAC,CAAC;IAEzE,MAAMC,cAAa,GAAI,MAAAA,CAAA,KAAY;MACjC,MAAMC,aAAY,GAAI,MAAMR,OAAO,CAACF,UAAU,CAACD,EAAE,EAAE,WAAW,CAAC,CAAC;MAChEK,SAAS,CAACO,KAAI,GAAID,aAAa,CAACE,IAAI,CAACC,GAAG,CAAEC,GAAG,KAAM;QAAEC,EAAE,EAAED,GAAG,CAACC,EAAE;QAAE,GAAGD,GAAG,CAACE,IAAI,CAAC;MAAE,CAAC,CAAC,CAAC;IACpF,CAAC;IAED,MAAMC,WAAU,GAAI,MAAAA,CAAA,KAAY;MAC9B,IAAI;QACF,MAAMhB,MAAM,CAACD,UAAU,CAACD,EAAE,EAAE,WAAW,CAAC,EAAEM,WAAW,CAACM,KAAK,CAAC;QAC5DO,KAAK,CAAC,6BAA6B,CAAC;QACpCb,WAAW,CAACM,KAAI,GAAI;UAAEL,QAAQ,EAAE,EAAE;UAAEC,QAAQ,EAAE,EAAE;UAAEC,MAAM,EAAE;QAAS,CAAC;QACpEC,cAAc,CAAC,CAAC;MAClB,EAAE,OAAOU,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,wBAAwB,EAAEA,KAAK,CAAC;QAC9CD,KAAK,CAAC,2CAA2C,CAAC;MACpD;IACF,CAAC;IAEDpB,SAAS,CAACW,cAAc,CAAC;IAEzB,OAAO;MACLL,SAAS;MACTC,WAAW;MACXY;IACF,CAAC;EACH;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}