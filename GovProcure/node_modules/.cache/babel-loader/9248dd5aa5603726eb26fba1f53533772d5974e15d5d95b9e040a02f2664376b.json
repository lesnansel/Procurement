]), _createElementVNode(\"div\", _hoisted_12, [_cache[8] || (_cache[8] = _createElementVNode(\"span\", {\n    class: \"summary-label\"\n  }, \"On Time\", -1 /* HOISTED */)), _createElementVNode(\"span\", _hoisted_13, _toDisplayString($options.onTimeCount), 1 /* TEXT */)]), _createElementVNode(\"div\", _hoisted_14, [_cache[9] || (_cache[9] = _createElementVNode(\"span\", {\n    class: \"summary-label\"\n  }, \"Avg. Process Time\", -1 /* HOISTED */)), _createElementVNode(\"span\", _hoisted_15, _toDisplayString($options.avgProcessTime) + \" days\", 1 /* TEXT */)])]), _createElementVNode(\"div\", {\n    class: \"table-responsive zoom-container\",\n    style: _normalizeStyle({\n      transform: `scale(${$data.zoomLevel})`,\n      transformOrigin: 'top left',\n      width: `${100 / $data.zoomLevel}%`\n    })\n  }, [_createElementVNode(\"table\", null, [_createElementVNode(\"thead\", null, [_createElementVNode(\"tr\", null, [(_openBlock(true), _createElementBlock(_Fragment, null, _renderList($data.steps, step => {\n    return _openBlock(), _createElementBlock(\"th\", {\n      key: step\n    }, _toDisplayString(step), 1 /* TEXT */);\n  }), 128 /* KEYED_FRAGMENT */))])]), _createElementVNode(\"tbody\", null, [(_openBlock(true), _createElementBlock(_Fragment, null, _renderList($data.data, (row, rowIndex) => {\n    return _openBlock(), _createElementBlock(\"tr\", {\n      key: rowIndex\n    }, [(_openBlock(true), _createElementBlock(_Fragment, null, _renderList($data.steps, (step, i) => {\n      return _openBlock(), _createElementBlock(\"td\", {\n        key: step,\n        class: \"align-top min-w-[150px] p-2 border border-slate-200\"\n      }, [_createElementVNode(\"div\", _hoisted_16, [_createCommentVNode(\" 1. Step Date \"), _createElementVNode(\"div\", _hoisted_17, [_createElementVNode(\"span\", _hoisted_18, _toDisplayString(row[step] ? _ctx.dayjs(row[step]).format('MMM-DD HH:mm') : '—'), 1 /* TEXT */), _createCommentVNode(\" 2. Circle Indicator \"), _createElementVNode(\"span\", {\n        class: _normalizeClass([\"w-2 h-2 rounded-full ml-2\", {\n          'bg-green-500': $options.getStepStatus(row[step], row[$data.steps[i + 1]]).color === 'green',\n          'bg-yellow-400': $options.getStepStatus(row[step], row[$data.steps[i + 1]]).color === 'yellow',\n          'bg-red-500': $options.getStepStatus(row[step], row[$data.steps[i + 1]]).color === 'red',\n          'bg-blue-500': $options.getStepStatus(row[step], row[$data.steps[i + 1]]).color === 'blue',\n          'bg-gray-400': $options.getStepStatus(row[step], row[$data.steps[i + 1]]).color === 'gray'\n        }]),\n        title: $options.getStepStatus(row[step], row[$data.steps[i + 1]]).text\n      }, null, 10 /* CLASS, PROPS */, _hoisted_19)]), _createCommentVNode(\" 3. Duration Text \"), _createElementVNode(\"div\", _hoisted_20, _toDisplayString($options.getStepStatus(row[step], row[$data.steps[i + 1]]).text), 1 /* TEXT */), _createCommentVNode(\" 4. Progress Bar \"), _createElementVNode(\"div\", _hoisted_21, [_createElementVNode(\"div\", {\n        class: \"h-1 rounded bg-emerald-500 transition-all duration-300\",\n        style: _normalizeStyle({\n          width: $options.getStepStatus(row[step], row[$data.steps[i + 1]]).progress * 100 + '%'\n        })\n      }, null, 4 /* STYLE */)])])]);\n    }), 128 /* KEYED_FRAGMENT */))]);\n  }), 128 /* KEYED_FRAGMENT */))])])], 4 /* STYLE */), _createElementVNode(\"div\", _hoisted_22, [_cache[10] || (_cache[10] = _createElementVNode(\"label\", {\n    for: \"zoom-slider\"\n  }, \"Zoom:\", -1 /* HOISTED */)), _createElementVNode(\"span\", null, _toDisplayString(Math.round($data.zoomLevel * 100)) + \"%\", 1 /* TEXT */)]), $data.delays.length ? (_openBlock(), _createElementBlock(\"p\", _hoisted_23, \"Delays Detected: \" + _toDisplayString($data.delays.length), 1 /* TEXT */)) : _createCommentVNode(\"v-if\", true)])]);\n}","map":{"version":3,"names":["class","key","_createElementBlock","_hoisted_1","_createVNode","_component_AdminNavigationBar","_createElementVNode","_hoisted_2","_hoisted_3","_hoisted_4","type","onChange","_cache","args","$options","importExcel","accept","onClick","exportExcel","addNewRow","saveToFirestore","_hoisted_5","_hoisted_6","_hoisted_7","_toDisplayString","$data","data","length","_hoisted_8","_hoisted_9","delays","_hoisted_10","_hoisted_11","overdueCount","_hoisted_12","_hoisted_13","onTimeCount","_hoisted_14","_hoisted_15","avgProcessTime","style","_normalizeStyle","transform","zoomLevel","transformOrigin","width","_Fragment","_renderList","steps","step","row","rowIndex","i","_hoisted_16","_createCommentVNode","_hoisted_17","_hoisted_18","_ctx","dayjs","format","_normalizeClass","getStepStatus","color","title","text","_hoisted_19","_hoisted_20","_hoisted_21","progress","_hoisted_22","for","Math","round","_hoisted_23"],"sources":["C:\\laragon\\www\\Capstone\\Connected to github\\Procurement\\GovProcure\\src\\components\\Records.vue"],"sourcesContent":["<template>\r\n  <div class=\"main-content\">\r\n    <AdminNavigationBar />\r\n    <div class=\"records-container\">\r\n      <h1>Records Management</h1>\r\n      <div class=\"actions\">\r\n        <label class=\"custom-file-upload\">\r\n          <input type=\"file\" @change=\"importExcel\" accept=\".xlsx, .xls\" />\r\n          <span>Import Excel</span>\r\n        </label>\r\n        <button class=\"action-button export\" @click=\"exportExcel\">Export Excel</button>\r\n        <button class=\"action-button add\" @click=\"addNewRow\">Add New Row</button>\r\n        <button class=\"action-button save\" @click=\"saveToFirestore\">Save</button>\r\n      </div>\r\n      <div class=\"summary-bar\">\r\n        <div class=\"summary-item\">\r\n          <span class=\"summary-label\">Total Records</span>\r\n          <span class=\"summary-value\">{{ data.length }}</span>\r\n        </div>\r\n        <div class=\"summary-item\">\r\n          <span class=\"summary-label\">Delays Detected</span>\r\n          <span class=\"summary-value\">{{ delays.length }}</span>\r\n        </div>\r\n        <div class=\"summary-item\">\r\n          <span class=\"summary-label\">Overdue Steps</span>\r\n          <span class=\"summary-value\">{{ overdueCount }}</span>\r\n        </div>\r\n        <div class=\"summary-item\">\r\n          <span class=\"summary-label\">On Time</span>\r\n          <span class=\"summary-value\">{{ onTimeCount }}</span>\r\n        </div>\r\n        <div class=\"summary-item\">\r\n          <span class=\"summary-label\">Avg. Process Time</span>\r\n          <span class=\"summary-value\">{{ avgProcessTime }} days</span>\r\n        </div>\r\n      </div>\r\n      <div class=\"table-responsive zoom-container\" :style=\"{ transform: `scale(${zoomLevel})`, transformOrigin: 'top left', width: `${100 / zoomLevel}%` }\">\r\n        <table>\r\n          <thead>\r\n            <tr>\r\n              <th v-for=\"step in steps\" :key=\"step\">{{ step }}</th>\r\n            </tr>\r\n          </thead>\r\n          <tbody>\r\n            <tr v-for=\"(row, rowIndex) in data\" :key=\"rowIndex\">\r\n              <td v-for=\"(step, i) in steps\" :key=\"step\" class=\"align-top min-w-[150px] p-2 border border-slate-200\">\r\n                <div class=\"relative\">\r\n                  <!-- 1. Step Date -->\r\n                  <div class=\"flex items-center justify-between\">\r\n                    <span class=\"font-semibold text-sm\">\r\n                      {{ row[step] ? dayjs(row[step]).format('MMM-DD HH:mm') : '—' }}\r\n                    </span>\r\n                    <!-- 2. Circle Indicator -->\r\n                    <span\r\n                      class=\"w-2 h-2 rounded-full ml-2\"\r\n                      :class=\"{\r\n                        'bg-green-500': getStepStatus(row[step], row[steps[i + 1]]).color === 'green',\r\n                        'bg-yellow-400': getStepStatus(row[step], row[steps[i + 1]]).color === 'yellow',\r\n                        'bg-red-500': getStepStatus(row[step], row[steps[i + 1]]).color === 'red',\r\n                        'bg-blue-500': getStepStatus(row[step], row[steps[i + 1]]).color === 'blue',\r\n                        'bg-gray-400': getStepStatus(row[step], row[steps[i + 1]]).color === 'gray'\r\n                      }\"\r\n                      :title=\"getStepStatus(row[step], row[steps[i + 1]]).text\"\r\n                    ></span>\r\n                  </div>\r\n                  <!-- 3. Duration Text -->\r\n                  <div class=\"text-xs italic text-slate-500 mt-1\">\r\n                    {{ getStepStatus(row[step], row[steps[i + 1]]).text }}\r\n                  </div>\r\n                  <!-- 4. Progress Bar -->\r\n                  <div class=\"w-full h-1 mt-1 bg-slate-200 rounded\">\r\n                    <div\r\n                      class=\"h-1 rounded bg-emerald-500 transition-all duration-300\"\r\n                      :style=\"{ width: (getStepStatus(row[step], row[steps[i + 1]]).progress * 100) + '%' }\"\r\n                    ></div>\r\n                  </div>\r\n                </div>\r\n              </td>\r\n            </tr>\r\n          </tbody>\r\n        </table>\r\n      </div>\r\n      <div class=\"zoom-bar\">\r\n        <label for=\"zoom-slider\">Zoom:</label>\r\n        <span>{{ Math.round(zoomLevel * 100) }}%</span>\r\n      </div>\r\n      <p v-if=\"delays.length\">Delays Detected: {{ delays.length }}</p>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport * as XLSX from \"xlsx\";\r\nimport { ref, uploadBytes } from \"firebase/storage\";\r\nimport { storage } from \"@/firebase\";\r\nimport dayjs from \"dayjs\";\r\nimport duration from 'dayjs/plugin/duration';\r\ndayjs.extend(duration);\r\nimport AdminNavigationBar from \"./AdminNavigationBar.vue\";\r\n\r\nexport default {\r\n  name: \"RecordsManagement\",\r\n  components: {\r\n    AdminNavigationBar,\r\n  },\r\n  data() {\r\n    return {\r\n      headers: [],\r\n      data: [],\r\n      delays: [],\r\n      zoomLevel: 1,\r\n      // Define your ordered procurement steps (column keys)\r\n      steps: [\r\n        'prDate', 'rfqDate', 'poDate', 'deliveryDate', 'inspectionDate', 'acceptanceDate', 'paymentDate'\r\n        // Add or adjust step keys as needed to match your data columns\r\n      ],\r\n    };\r\n  },\r\n  computed: {\r\n    onTimeCount() {\r\n      if (!this.headers.length) return 0;\r\n      // Only count rows that do NOT have overdue steps\r\n      return this.data.filter(row => !row._overdueSteps || row._overdueSteps.length === 0).length;\r\n    },\r\n    avgProcessTime() {\r\n      if (!this.headers.length) return 0;\r\n      const dateIndex = this.headers.findIndex(h => {\r\n        const header = (h || '').toLowerCase();\r\n        return header.includes('date') || header.includes('deadline') || header.includes('due');\r\n      });\r\n      if (dateIndex === -1 || !this.data.length) return 0;\r\n      const today = dayjs();\r\n      const daysArr = this.data.map(row => {\r\n        const date = dayjs(row[dateIndex]);\r\n        return date.isValid() ? today.diff(date, 'day') : null;\r\n      }).filter(days => days !== null && days >= 0);\r\n      if (!daysArr.length) return 0;\r\n      const avg = daysArr.reduce((a, b) => a + b, 0) / daysArr.length;\r\n      return Math.round(avg);\r\n    },\r\n    overdueCount() {\r\n      return this.data.filter(row => row._overdueSteps && row._overdueSteps.length).length;\r\n    },\r\n  },\r\n  methods: {\r\n    importExcel(event) {\r\n      const file = event.target.files[0];\r\n      const reader = new FileReader();\r\n      reader.onload = (e) => {\r\n        const workbook = XLSX.read(e.target.result, { type: \"binary\" });\r\n        const sheetName = workbook.SheetNames[0];\r\n        const sheet = workbook.Sheets[sheetName];\r\n        const jsonData = XLSX.utils.sheet_to_json(sheet, { header: 1 });\r\n        this.headers = jsonData[0];\r\n        this.data = jsonData.slice(1).map((row) => {\r\n          return row.map((cell, index) => {\r\n            if (this.isDateColumn(index)) {\r\n              if (typeof cell === \"number\") {\r\n                return dayjs(\"1899-12-30\").add(cell, \"day\").format(\"YYYY-MM-DD\");\r\n              } else if (typeof cell === \"string\") {\r\n                const parsed = dayjs(cell, [\"DD/MM/YYYY\", \"MM/DD/YYYY\", \"YYYY-MM-DD\", \"YYYY/MM/DD\", \"MMM-DD\", \"MMMM D, YYYY\"], true);\r\n                if (parsed.isValid()) {\r\n                  return parsed.format(\"YYYY-MM-DD\");\r\n                }\r\n              }\r\n            } \r\n            return cell;\r\n          });\r\n        });\r\n        this.ensureDataConsistency();\r\n        this.detectDelays();\r\n        this.detectOverdueSteps();\r\n      };\r\n      reader.readAsBinaryString(file);\r\n    },\r\n    isDateColumn(index) {\r\n      const dateKeywords = [\"date\", \"deadline\", \"due\"];\r\n      return dateKeywords.some((keyword) =>\r\n        this.headers[index]?.toLowerCase().includes(keyword)\r\n      );\r\n    },\r\n    exportExcel() {\r\n      const worksheet = XLSX.utils.aoa_to_sheet([this.headers, ...this.data]);\r\n      const workbook = XLSX.utils.book_new();\r\n      XLSX.utils.book_append_sheet(workbook, worksheet, \"Sheet1\");\r\n      XLSX.writeFile(workbook, \"exported_data.xlsx\");\r\n    },\r\n    getStepStatus(fromDate, toDate) {\r\n      if (!fromDate) return { text: '—', color: 'gray', progress: 0 };\r\n      const from = dayjs(fromDate);\r\n      const to = toDate ? dayjs(toDate) : dayjs();\r\n      const diff = to.diff(from);\r\n      const dur = dayjs.duration(diff);\r\n      const human = `${dur.days()}d ${dur.hours()}h ${dur.minutes()}m`;\r\n      const isDone = !!toDate;\r\n      const isDelayed = diff > 86400000; // 1 day\r\n      const progress = Math.min(diff / 86400000, 1);\r\n      let color = '';\r\n      if (isDone && !isDelayed) color = 'green';\r\n      else if (isDone && isDelayed) color = 'yellow';\r\n      else if (!isDone && isDelayed) color = 'red';\r\n      else color = 'blue';\r\n      const text = isDone ? `✅ Done in ${human}` : `⏳ In progress for ${human}`;\r\n      return { text, color, progress };\r\n    },\r\n    detectDelays() {\r\n      const today = dayjs();\r\n      const currentYear = today.year();\r\n      const dateIndex = this.headers.findIndex(h =>\r\n        (h || \"\").toLowerCase().includes(\"as of\")\r\n      );\r\n      if (dateIndex === -1) {\r\n        this.delays = [];\r\n        return;\r\n      }\r\n      this.delays = this.data.filter(row => {\r\n        let raw = (row[dateIndex] || \"\").toString().trim();\r\n        if (/^[A-Za-z]{3,}[.\\-\\s]?\\d{1,2}$/.test(raw)) {\r\n          raw = raw.replace(/[.\\-\\s]+/g, \" \");\r\n          raw = `${raw}, ${currentYear}`;\r\n        }\r\n        let date = dayjs(raw, [\"MMM D, YYYY\", \"MMM D YYYY\", \"YYYY-MM-DD\"], true);\r\n        if (!date.isValid()) {\r\n          date = dayjs(raw);\r\n        }\r\n        return date.isValid() && today.diff(date, \"day\") > 10;\r\n      });\r\n      if (this.delays.length > 0) {\r\n        alert(`⚠ ${this.delays.length} record(s) are delayed (over 10 days from 'AS OF' date).`);\r\n      } else {\r\n        alert(\"✅ No delays detected.\");\r\n      }\r\n    },\r\n    async saveToFirestore() {\r\n      const file = new Blob([JSON.stringify({ headers: this.headers, data: this.data })], {\r\n        type: \"application/json\",\r\n      });\r\n      const storageRef = ref(storage, `excel-files/records_${Date.now()}.json`);\r\n      try {\r\n        await uploadBytes(storageRef, file);\r\n        alert(\"File saved to Firestore successfully!\");\r\n      } catch (error) {\r\n        console.error(\"Error saving file to Firestore:\", error);\r\n      }\r\n    },\r\n    addNewRow() {\r\n      // Add a new row as an array of empty strings, matching the headers length\r\n      const newRow = Array(this.headers.length).fill(\"\");\r\n      this.data.push(newRow);\r\n    },\r\n    ensureDataConsistency() {\r\n      this.data = this.data.map((row) => {\r\n        const adjustedRow = Array(this.headers.length).fill(\"\");\r\n        row.forEach((cell, index) => {\r\n          if (index < this.headers.length) {\r\n            adjustedRow[index] = cell;\r\n          }\r\n        });\r\n        return adjustedRow;\r\n      });\r\n      const maxRows = this.data.length;\r\n      while (this.data.length < maxRows) {\r\n        this.data.push(Array(this.headers.length).fill(\"\"));\r\n      }\r\n    },\r\n    detectOverdueSteps() {\r\n      const steps = [\r\n        \"RET TO BAC\",\r\n        \"FORWARDED TO END USER\",\r\n        \"RET TO BAC.1\",\r\n        \"FORWARDED TO END USER.1\",\r\n        \"RET TO BAC.2\",\r\n        \"FORWARDED TO END USER.2\",\r\n        \"RET TO BAC.3\",\r\n        \"FORWARDED TO END USER.3\",\r\n        \"PO/CONTRACT & NTP POSTED (50K above)\"\r\n      ];\r\n      function parseDate(val) {\r\n        if (!val) return null;\r\n        const d = new Date(val);\r\n        return isNaN(d.getTime()) ? null : d;\r\n      }\r\n      this.data.forEach(function (record) {\r\n        record._overdueSteps = [];\r\n        for (let i = 0; i < steps.length - 1; i++) {\r\n          const currDate = parseDate(record[steps[i]]);\r\n          const nextDate = parseDate(record[steps[i + 1]]);\r\n          if (currDate) {\r\n            if (!nextDate) {\r\n              record._overdueSteps.push(steps[i + 1] + \" missing after \" + steps[i]);\r\n            } else {\r\n              const diff = (nextDate - currDate) / (1000 * 60 * 60 * 24);\r\n              if (diff > 10) {\r\n                record._overdueSteps.push(steps[i + 1] + \" late by \" + Math.floor(diff - 10) + \" days\");\r\n              }\r\n            }\r\n          }\r\n        }\r\n      });\r\n    },\r\n    handleZoomKeys(e) {\r\n      if (e.ctrlKey && (e.key === '+' || e.key === '=')) {\r\n        e.preventDefault();\r\n        this.zoomLevel = Math.min(this.zoomLe