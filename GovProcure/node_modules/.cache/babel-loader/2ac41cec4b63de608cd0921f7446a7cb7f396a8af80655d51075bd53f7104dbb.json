{"ast":null,"code":"import \"core-js/modules/esnext.iterator.constructor.js\";\nimport \"core-js/modules/esnext.iterator.filter.js\";\nimport { ref, computed } from 'vue';\nimport AdminNavigationBar from './AdminNavigationBar.vue';\nexport default {\n  name: 'InvitationToBid',\n  components: {\n    AdminNavigationBar\n  },\n  setup() {\n    // State\n    const invitations = ref([{\n      id: 1,\n      projectName: 'Office Renovation Project',\n      description: 'Complete renovation of the main office building including electrical, plumbing, and interior design work.',\n      deadline: new Date('2024-02-15T17:00:00'),\n      status: 'Open',\n      createdAt: new Date('2024-01-01T09:00:00')\n    }, {\n      id: 2,\n      projectName: 'IT Equipment Procurement',\n      description: 'Purchase of computers, servers, and networking equipment for the new branch office.',\n      deadline: new Date('2024-02-20T17:00:00'),\n      status: 'Pending',\n      createdAt: new Date('2024-01-05T10:30:00')\n    }, {\n      id: 3,\n      projectName: 'Security System Installation',\n      description: 'Installation of CCTV cameras, access control systems, and alarm systems across all facilities.',\n      deadline: new Date('2024-01-30T17:00:00'),\n      status: 'Closed',\n      createdAt: new Date('2023-12-15T14:00:00')\n    }]);\n    const searchQuery = ref('');\n    const isViewing = ref(false);\n    const isEditing = ref(false);\n    const isDeleting = ref(false);\n    const selectedInvitation = ref(null);\n    const deleteId = ref(null);\n    const editForm = ref({\n      projectName: '',\n      description: '',\n      deadline: '',\n      status: 'Open'\n    });\n    const sidebarOpen = ref(true);\n    const toggleSidebar = () => {\n      sidebarOpen.value = !sidebarOpen.value;\n    };\n\n    // Computed\n    const filteredInvitations = computed(() => {\n      if (!searchQuery.value.trim()) {\n        return invitations.value;\n      }\n      const query = searchQuery.value.toLowerCase();\n      return invitations.value.filter(invitation => invitation.projectName.toLowerCase().includes(query) || invitation.description.toLowerCase().includes(query) || invitation.status.toLowerCase().includes(query));\n    });\n\n    // Methods\n    const formatDate = date => {\n      if (!date) return 'N/A';\n      return new Date(date).toLocaleDateString('en-US', {\n        year: 'numeric',\n        month: 'short',\n        day: 'numeric',\n        hour: '2-digit',\n        minute: '2-digit'\n      });\n    };\n    const truncateText = (text, maxLength) => {\n      if (!text) return 'N/A';\n      return text.length > maxLength ? text.substring(0, maxLength) + '...' : text;\n    };\n    const getStatusClass = status => {\n      switch (status?.toLowerCase()) {\n        case 'open':\n          return 'status-open';\n        case 'closed':\n          return 'status-closed';\n        case 'pending':\n          return 'status-pending';\n        default:\n          return 'status-default';\n      }\n    };\n\n    // Modal handlers\n    const handleView = invitation => {\n      selectedInvitation.value = invitation;\n      isViewing.value = true;\n    };\n    const closeViewModal = () => {\n      isViewing.value = false;\n      selectedInvitation.value = null;\n    };\n    const handleEdit = invitation => {\n      selectedInvitation.value = invitation;\n      editForm.value = {\n        projectName: invitation.projectName,\n        description: invitation.description,\n        deadline: new Date(invitation.deadline).toISOString().slice(0, 16),\n        status: invitation.status\n      };\n      isEditing.value = true;\n    };\n    const openEditModal = () => {\n      closeViewModal();\n      isEditing.value = true;\n    };\n    const closeEditModal = () => {\n      isEditing.value = false;\n      selectedInvitation.value = null;\n      editForm.value = {\n        projectName: '',\n        description: '',\n        deadline: '',\n        status: 'Open'\n      };\n    };\n    const handleEditSubmit = () => {\n      if (selectedInvitation.value) {\n        const index = invitations.value.findIndex(inv => inv.id === selectedInvitation.value.id);\n        if (index !== -1) {\n          invitations.value[index] = {\n            ...invitations.value[index],\n            projectName: editForm.value.projectName,\n            description: editForm.value.description,\n            deadline: new Date(editForm.value.deadline),\n            status: editForm.value.status\n          };\n        }\n      }\n      closeEditModal();\n    };\n    const handleDelete = id => {\n      deleteId.value = id;\n      isDeleting.value = true;\n    };\n    const openDeleteModal = () => {\n      deleteId.value = selectedInvitation.value.id;\n      closeViewModal();\n      isDeleting.value = true;\n    };\n    const closeDeleteModal = () => {\n      isDeleting.value = false;\n      deleteId.value = null;\n    };\n    const confirmDelete = () => {\n      if (deleteId.value) {\n        invitations.value = invitations.value.filter(inv => inv.id !== deleteId.value);\n      }\n      closeDeleteModal();\n    };\n    const openCreateModal = () => {\n      // This would open a create modal - for now just show an alert\n      alert('Create invitation modal would open here');\n    };\n    return {\n      invitations,\n      searchQuery,\n      filteredInvitations,\n      isViewing,\n      isEditing,\n      isDeleting,\n      selectedInvitation,\n      editForm,\n      formatDate,\n      truncateText,\n      getStatusClass,\n      handleView,\n      closeViewModal,\n      handleEdit,\n      openEditModal,\n      closeEditModal,\n      handleEditSubmit,\n      handleDelete,\n      openDeleteModal,\n      closeDeleteModal,\n      confirmDelete,\n      openCreateModal,\n      sidebarOpen,\n      toggleSidebar\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","AdminNavigationBar","name","components","setup","invitations","id","projectName","description","deadline","Date","status","createdAt","searchQuery","isViewing","isEditing","isDeleting","selectedInvitation","deleteId","editForm","sidebarOpen","toggleSidebar","value","filteredInvitations","trim","query","toLowerCase","filter","invitation","includes","formatDate","date","toLocaleDateString","year","month","day","hour","minute","truncateText","text","maxLength","length","substring","getStatusClass","handleView","closeViewModal","handleEdit","toISOString","slice","openEditModal","closeEditModal","handleEditSubmit","index","findIndex","inv","handleDelete","openDeleteModal","closeDeleteModal","confirmDelete","openCreateModal","alert"],"sources":["C:\\laragon\\www\\Capstone\\Connected to github\\Procurement\\GovProcure\\src\\components\\InvitationToBid.vue"],"sourcesContent":["<template>\r\n<!-- View Modal -->\r\n<div v-if=\"isViewing && selectedInvitation\" class=\"modal-overlay\" @click=\"closeViewModal\">\r\n  <div class=\"modal\" @click.stop>\r\n    <div class=\"modal-header\">\r\n      <h2 class=\"modal-title\">Invitation Details</h2>\r\n      <button @click=\"closeViewModal\" class=\"close-button\">\r\n        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\r\n          <line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"></line>\r\n          <line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"></line>\r\n        </svg>\r\n      </button>\r\n    </div>\r\n    <div class=\"modal-body\">\r\n      <div class=\"detail-group\">\r\n        <h3 class=\"detail-title\">Project Information</h3>\r\n        <div class=\"detail-row\">\r\n          <span class=\"detail-label\">Project Name:</span>\r\n          <span class=\"detail-value\">{{ selectedInvitation.projectName }}</span>\r\n        </div>\r\n        <div class=\"detail-row\">\r\n          <span class=\"detail-label\">Description:</span>\r\n          <span class=\"detail-value\">{{ selectedInvitation.description || 'No description provided' }}</span>\r\n        </div>\r\n        <div class=\"detail-row\">\r\n          <span class=\"detail-label\">Deadline:</span>\r\n          <span class=\"detail-value\">{{ formatDate(selectedInvitation.deadline) }}</span>\r\n        </div>\r\n        <div class=\"detail-row\">\r\n          <span class=\"detail-label\">Status:</span>\r\n          <span class=\"detail-value\">\r\n            <span :class=\"['status-badge', getStatusClass(selectedInvitation.status)]\">\r\n              {{ selectedInvitation.status }}\r\n            </span>\r\n          </span>\r\n        </div>\r\n        <div class=\"detail-row\">\r\n          <span class=\"detail-label\">Created:</span>\r\n          <span class=\"detail-value\">{{ formatDate(selectedInvitation.createdAt) }}</span>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    <div class=\"modal-footer\">\r\n      <button @click=\"openEditModal\" class=\"btn-primary\">Edit</button>\r\n      <button @click=\"openDeleteModal\" class=\"btn-danger\">Delete</button>\r\n      <button @click=\"closeViewModal\" class=\"btn-secondary\">Close</button>\r\n    </div>\r\n  </div>\r\n</div>\r\n\r\n<!-- Edit Modal -->\r\n<div v-if=\"isEditing\" class=\"modal-overlay\" @click=\"closeEditModal\">\r\n  <div class=\"modal\" @click.stop>\r\n    <div class=\"modal-header\">\r\n      <h2 class=\"modal-title\">Edit Invitation</h2>\r\n      <button @click=\"closeEditModal\" class=\"close-button\">\r\n        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\r\n          <line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"></line>\r\n          <line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"></line>\r\n        </svg>\r\n      </button>\r\n    </div>\r\n    <div class=\"modal-body\">\r\n      <form @submit.prevent=\"handleEditSubmit\">\r\n        <div class=\"form-group\">\r\n          <label for=\"editProjectName\" class=\"form-label\">Project Name</label>\r\n          <input\r\n            id=\"editProjectName\"\r\n            v-model=\"editForm.projectName\"\r\n            type=\"text\"\r\n            class=\"form-input\"\r\n            required\r\n          />\r\n        </div>\r\n        <div class=\"form-group\">\r\n          <label for=\"editDescription\" class=\"form-label\">Description</label>\r\n          <textarea\r\n            id=\"editDescription\"\r\n            v-model=\"editForm.description\"\r\n            class=\"form-textarea\"\r\n            rows=\"4\"\r\n          ></textarea>\r\n        </div>\r\n        <div class=\"form-group\">\r\n          <label for=\"editDeadline\" class=\"form-label\">Deadline</label>\r\n          <input\r\n            id=\"editDeadline\"\r\n            v-model=\"editForm.deadline\"\r\n            type=\"datetime-local\"\r\n            class=\"form-input\"\r\n            required\r\n          />\r\n        </div>\r\n        <div class=\"form-group\">\r\n          <label for=\"editStatus\" class=\"form-label\">Status</label>\r\n          <select id=\"editStatus\" v-model=\"editForm.status\" class=\"form-select\">\r\n            <option value=\"Open\">Open</option>\r\n            <option value=\"Closed\">Closed</option>\r\n            <option value=\"Pending\">Pending</option>\r\n          </select>\r\n        </div>\r\n      </form>\r\n    </div>\r\n    <div class=\"modal-footer\">\r\n      <button @click=\"handleEditSubmit\" class=\"btn-primary\">Save Changes</button>\r\n      <button @click=\"closeEditModal\" class=\"btn-secondary\">Cancel</button>\r\n    </div>\r\n  </div>\r\n</div>\r\n\r\n<!-- Delete Confirmation Modal -->\r\n<div v-if=\"isDeleting\" class=\"modal-overlay\" @click=\"closeDeleteModal\">\r\n  <div class=\"modal modal-small\" @click.stop>\r\n    <div class=\"modal-header\">\r\n      <h2 class=\"modal-title\">Confirm Delete</h2>\r\n      <button @click=\"closeDeleteModal\" class=\"close-button\">\r\n        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\r\n          <line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"></line>\r\n          <line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"></line>\r\n        </svg>\r\n      </button>\r\n    </div>\r\n    <div class=\"modal-body\">\r\n      <div class=\"delete-confirmation\">\r\n        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"warning-icon\">\r\n          <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\r\n          <line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"></line>\r\n          <line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"></line>\r\n        </svg>\r\n        <p>Are you sure you want to delete this invitation?</p>\r\n        <p class=\"delete-warning\">This action cannot be undone.</p>\r\n      </div>\r\n    </div>\r\n    <div class=\"modal-footer\">\r\n      <button @click=\"confirmDelete\" class=\"btn-danger\">Delete</button>\r\n      <button @click=\"closeDeleteModal\" class=\"btn-secondary\">Cancel</button>\r\n    </div>\r\n  </div>\r\n</div>\r\n\r\n<div class=\"app-container\">\r\n  <!-- Main Content Area (Sidebar removed) -->\r\n  <div class=\"main-content\">\r\n    <!-- Background Pattern -->\r\n    <div class=\"background-pattern\">\r\n      <div class=\"pattern-overlay\"></div>\r\n    </div>\r\n    <!-- Invitation to Bid Content -->\r\n    <div class=\"content-wrapper\">\r\n      <div class=\"admin-card\">\r\n        <div class=\"card-header\">\r\n          <div class=\"logo-container\">\r\n            <img src=\"/placeholder.svg?height=70&width=70\" alt=\"Procurement System Logo\" class=\"logo\" />\r\n          </div>\r\n          <h1 class=\"title\">Invitation to Bid</h1>\r\n          <p class=\"subtitle\">Manage and track bidding invitations</p>\r\n        </div>\r\n\r\n        <div class=\"card-content\">\r\n          <!-- Controls -->\r\n          <div class=\"controls-container\">\r\n            <div class=\"search-container\">\r\n              <input \r\n                type=\"text\" \r\n                v-model=\"searchQuery\" \r\n                placeholder=\"Search invitations...\" \r\n                class=\"search-input\"\r\n              />\r\n              <button class=\"search-button\">\r\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\r\n                  <circle cx=\"11\" cy=\"11\" r=\"8\"></circle>\r\n                  <line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"></line>\r\n                </svg>\r\n              </button>\r\n            </div>\r\n            \r\n            <button @click=\"openCreateModal\" class=\"btn-primary\">\r\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\r\n                <line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"></line>\r\n                <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\r\n              </svg>\r\n              Create Invitation\r\n            </button>\r\n          </div>\r\n\r\n          <!-- Invitations Table -->\r\n          <div class=\"table-container\">\r\n            <table class=\"invitations-table\">\r\n              <thead>\r\n                <tr>\r\n                  <th>Project Name</th>\r\n                  <th>Description</th>\r\n                  <th>Deadline</th>\r\n                  <th>Status</th>\r\n                  <th>Created</th>\r\n                  <th>Actions</th>\r\n                </tr>\r\n              </thead>\r\n              <tbody>\r\n                <tr v-for=\"invitation in filteredInvitations\" :key=\"invitation.id\">\r\n                  <td class=\"project-name\">{{ invitation.projectName }}</td>\r\n                  <td class=\"description\">{{ truncateText(invitation.description, 50) }}</td>\r\n                  <td>{{ formatDate(invitation.deadline) }}</td>\r\n                  <td>\r\n                    <span :class=\"['status-badge', getStatusClass(invitation.status)]\">\r\n                      {{ invitation.status }}\r\n                    </span>\r\n                  </td>\r\n                  <td>{{ formatDate(invitation.createdAt) }}</td>\r\n                  <td>\r\n                    <div class=\"action-buttons\">\r\n                      <button \r\n                        @click=\"handleView(invitation)\" \r\n                        class=\"action-button view\"\r\n                        title=\"View Details\"\r\n                      >\r\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\r\n                          <path d=\"M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z\"></path>\r\n                          <circle cx=\"12\" cy=\"12\" r=\"3\"></circle>\r\n                        </svg>\r\n                      </button>\r\n                      <button \r\n                        @click=\"handleEdit(invitation)\" \r\n                        class=\"action-button edit\"\r\n                        title=\"Edit\"\r\n                      >\r\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\r\n                          <path d=\"M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7\"></path>\r\n                          <path d=\"M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z\"></path>\r\n                        </svg>\r\n                      </button>\r\n                      <button \r\n                        @click=\"handleDelete(invitation.id)\" \r\n                        class=\"action-button delete\"\r\n                        title=\"Delete\"\r\n                      >\r\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\r\n                          <polyline points=\"3 6 5 6 21 6\"></polyline>\r\n                          <path d=\"M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2\"></path>\r\n                        </svg>\r\n                      </button>\r\n                    </div>\r\n                  </td>\r\n                </tr>\r\n              </tbody>\r\n            </table>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed } from 'vue'\r\nimport AdminNavigationBar from './AdminNavigationBar.vue'\r\n\r\nexport default {\r\n  name: 'InvitationToBid',\r\n  components: {\r\n    AdminNavigationBar\r\n  },\r\n  setup() {\r\n    // State\r\n    const invitations = ref([\r\n      {\r\n        id: 1,\r\n        projectName: 'Office Renovation Project',\r\n        description: 'Complete renovation of the main office building including electrical, plumbing, and interior design work.',\r\n        deadline: new Date('2024-02-15T17:00:00'),\r\n        status: 'Open',\r\n        createdAt: new Date('2024-01-01T09:00:00')\r\n      },\r\n      {\r\n        id: 2,\r\n        projectName: 'IT Equipment Procurement',\r\n        description: 'Purchase of computers, servers, and networking equipment for the new branch office.',\r\n        deadline: new Date('2024-02-20T17:00:00'),\r\n        status: 'Pending',\r\n        createdAt: new Date('2024-01-05T10:30:00')\r\n      },\r\n      {\r\n        id: 3,\r\n        projectName: 'Security System Installation',\r\n        description: 'Installation of CCTV cameras, access control systems, and alarm systems across all facilities.',\r\n        deadline: new Date('2024-01-30T17:00:00'),\r\n        status: 'Closed',\r\n        createdAt: new Date('2023-12-15T14:00:00')\r\n      }\r\n    ])\r\n\r\n    const searchQuery = ref('')\r\n    const isViewing = ref(false)\r\n    const isEditing = ref(false)\r\n    const isDeleting = ref(false)\r\n    const selectedInvitation = ref(null)\r\n    const deleteId = ref(null)\r\n\r\n    const editForm = ref({\r\n      projectName: '',\r\n      description: '',\r\n      deadline: '',\r\n      status: 'Open'\r\n    })\r\n\r\n    const sidebarOpen = ref(true)\r\n    const toggleSidebar = () => {\r\n      sidebarOpen.value = !sidebarOpen.value\r\n    }\r\n\r\n    // Computed\r\n    const filteredInvitations = computed(() => {\r\n      if (!searchQuery.value.trim()) {\r\n        return invitations.value\r\n      }\r\n      \r\n      const query = searchQuery.value.toLowerCase()\r\n      return invitations.value.filter(invitation =>\r\n        invitation.projectName.toLowerCase().includes(query) ||\r\n        invitation.description.toLowerCase().includes(query) ||\r\n        invitation.status.toLowerCase().includes(query)\r\n      )\r\n    })\r\n\r\n    // Methods\r\n    const formatDate = (date) => {\r\n      if (!date) return 'N/A'\r\n      return new Date(date).toLocaleDateString('en-US', {\r\n        year: 'numeric',\r\n        month: 'short',\r\n        day: 'numeric',\r\n        hour: '2-digit',\r\n        minute: '2-digit'\r\n      })\r\n    }\r\n\r\n    const truncateText = (text, maxLength) => {\r\n      if (!text) return 'N/A'\r\n      return text.length > maxLength ? text.substring(0, maxLength) + '...' : text\r\n    }\r\n\r\n    const getStatusClass = (status) => {\r\n      switch (status?.toLowerCase()) {\r\n        case 'open': return 'status-open'\r\n        case 'closed': return 'status-closed'\r\n        case 'pending': return 'status-pending'\r\n        default: return 'status-default'\r\n      }\r\n    }\r\n\r\n    // Modal handlers\r\n    const handleView = (invitation) => {\r\n      selectedInvitation.value = invitation\r\n      isViewing.value = true\r\n    }\r\n\r\n    const closeViewModal = () => {\r\n      isViewing.value = false\r\n      selectedInvitation.value = null\r\n    }\r\n\r\n    const handleEdit = (invitation) => {\r\n      selectedInvitation.value = invitation\r\n      editForm.value = {\r\n        projectName: invitation.projectName,\r\n        description: invitation.description,\r\n        deadline: new Date(invitation.deadline).toISOString().slice(0, 16),\r\n        status: invitation.status\r\n      }\r\n      isEditing.value = true\r\n    }\r\n\r\n    const openEditModal = () => {\r\n      closeViewModal()\r\n      isEditing.value = true\r\n    }\r\n\r\n    const closeEditModal = () => {\r\n      isEditing.value = false\r\n      selectedInvitation.value = null\r\n      editForm.value = {\r\n        projectName: '',\r\n        description: '',\r\n        deadline: '',\r\n        status: 'Open'\r\n      }\r\n    }\r\n\r\n    const handleEditSubmit = () => {\r\n      if (selectedInvitation.value) {\r\n        const index = invitations.value.findIndex(inv => inv.id === selectedInvitation.value.id)\r\n        if (index !== -1) {\r\n          invitations.value[index] = {\r\n            ...invitations.value[index],\r\n            projectName: editForm.value.projectName,\r\n            description: editForm.value.description,\r\n            deadline: new Date(editForm.value.deadline),\r\n            status: editForm.value.status\r\n          }\r\n        }\r\n      }\r\n      closeEditModal()\r\n    }\r\n\r\n    const handleDelete = (id) => {\r\n      deleteId.value = id\r\n      isDeleting.value = true\r\n    }\r\n\r\n    const openDeleteModal = () => {\r\n      deleteId.value = selectedInvitation.value.id\r\n      closeViewModal()\r\n      isDeleting.value = true\r\n    }\r\n\r\n    const closeDeleteModal = () => {\r\n      isDeleting.value = false\r\n      deleteId.value = null\r\n    }\r\n\r\n    const confirmDelete = () => {\r\n      if (deleteId.value) {\r\n        invitations.value = invitations.value.filter(inv => inv.id !== deleteId.value)\r\n      }\r\n      closeDeleteModal()\r\n    }\r\n\r\n    const openCreateModal = () => {\r\n      // This would open a create modal - for now just show an alert\r\n      alert('Create invitation modal would open here')\r\n    }\r\n\r\n    return {\r\n      invitations,\r\n      searchQuery,\r\n      filteredInvitations,\r\n      isViewing,\r\n      isEditing,\r\n      isDeleting,\r\n      selectedInvitation,\r\n      editForm,\r\n      formatDate,\r\n      truncateText,\r\n      getStatusClass,\r\n      handleView,\r\n      closeViewModal,\r\n      handleEdit,\r\n      openEditModal,\r\n      closeEditModal,\r\n      handleEditSubmit,\r\n      handleDelete,\r\n      openDeleteModal,\r\n      closeDeleteModal,\r\n      confirmDelete,\r\n      openCreateModal,\r\n      sidebarOpen,\r\n      toggleSidebar\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n/* Main App Container */\r\n.app-container {\r\n  display: flex;\r\n  height: 100vh;\r\n  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;\r\n}\r\n\r\n/* Main Content Area */\r\n.main-content {\r\n  flex: 1;\r\n  position: relative;\r\n  overflow-y: auto;\r\n  min-width: 0;\r\n  transition: width 0.3s ease;\r\n  background: transparent;\r\n  /* Removed margin-left, let flexbox handle layout */\r\n}\r\n.main-content.collapsed {\r\n  /* No margin-left here either */\r\n}\r\n\r\n/* Background Pattern */\r\n.background-pattern {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  right: 0;\r\n