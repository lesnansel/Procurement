{"ast":null,"code":"export default {\n  name: \"ProcurementStatusBar\",\n  props: {\n    currentStep: {\n      type: String,\n      required: true\n    },\n    statusHistory: {\n      type: Array,\n      default: () => []\n    }\n  },\n  computed: {\n    steps() {\n      return [\"PR\", \"APP\", \"RFQ\", \"Evaluation\", \"Award\", \"NTP\"];\n    },\n    currentStepIndex() {\n      return this.steps.indexOf(this.currentStep);\n    }\n  },\n  methods: {\n    formatDate(dateStr) {\n      if (!dateStr) return \"\";\n      const date = typeof dateStr === 'object' && dateStr.toDate ? dateStr.toDate() : new Date(dateStr);\n      return date.toLocaleDateString(\"en-US\", {\n        year: \"numeric\",\n        month: \"short\",\n        day: \"numeric\"\n      });\n    }\n  }\n};","map":{"version":3,"names":["name","props","currentStep","type","String","required","statusHistory","Array","default","computed","steps","currentStepIndex","indexOf","methods","formatDate","dateStr","date","toDate","Date","toLocaleDateString","year","month","day"],"sources":["C:\\laragon\\www\\Capstone\\Connected to github\\Procurement\\GovProcure\\src\\components\\ProcurementStatusBar.vue"],"sourcesContent":["<template>\r\n  <div class=\"status-bar\">\r\n    <div v-for=\"(step, idx) in steps\" :key=\"step\" class=\"status-step\" :class=\"{ active: idx <= currentStepIndex }\">\r\n      <span class=\"step-label\">{{ step }}</span>\r\n      <span v-if=\"statusHistory && statusHistory[idx]\" class=\"step-date\">\r\n        ({{ formatDate(statusHistory[idx].updatedAt) }})\r\n      </span>\r\n      <span v-if=\"idx < steps.length - 1\" class=\"status-arrow\">→</span>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: \"ProcurementStatusBar\",\r\n  props: {\r\n    currentStep: { type: String, required: true },\r\n    statusHistory: { type: Array, default: () => [] }\r\n  },\r\n  computed: {\r\n    steps() {\r\n      return [\"PR\", \"APP\", \"RFQ\", \"Evaluation\", \"Award\", \"NTP\"];\r\n    },\r\n    currentStepIndex() {\r\n      return this.steps.indexOf(this.currentStep);\r\n    }\r\n  },\r\n  methods: {\r\n    formatDate(dateStr) {\r\n      if (!dateStr) return \"\";\r\n      const date = typeof dateStr === 'object' && dateStr.toDate ? dateStr.toDate() : new Date(dateStr);\r\n      return date.toLocaleDateString(\"en-US\", {\r\n        year: \"numeric\",\r\n        month: \"short\",\r\n        day: \"numeric\"\r\n      });\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.status-bar {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  margin: 18px 0;\r\n  padding: 12px 18px;\r\n  background: #f8fafc;\r\n  border-radius: 10px;\r\n  box-shadow: 0 2px 8px rgba(16, 42, 66, 0.07);\r\n}\r\n.status-step {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  padding: 8px 16px;\r\n  border-radius: 16px;\r\n  background: #e5eaf5;\r\n  color: #0f2942;\r\n  font-weight: 500;\r\n  font-size: 15px;\r\n  transition: background 0.2s, color 0.2s;\r\n  box-shadow: 0 1px 3px rgba(16, 42, 66, 0.04);\r\n}\r\n.status-step.active {\r\n  background: linear-gradient(135deg, #4a9fff 0%, #2563eb 100%);\r\n  color: #fff;\r\n  box-shadow: 0 2px 8px rgba(74, 159, 255, 0.12);\r\n}\r\n.step-label {\r\n  font-weight: 600;\r\n  letter-spacing: 0.5px;\r\n}\r\n.step-date {\r\n  font-size: 12px;\r\n  color: #64748b;\r\n  margin-left: 2px;\r\n}\r\n.status-arrow {\r\n  margin: 0 4px;\r\n  color: #94a3b8;\r\n  font-size: 18px;\r\n  font-weight: bold;\r\n}\r\n@media (max-width: 600px) {\r\n  .status-bar {\r\n    flex-direction: column;\r\n    gap: 8px;\r\n    padding: 10px;\r\n  }\r\n  .status-step {\r\n    width: 100%;\r\n    justify-content: flex-start;\r\n    font-size: 14px;\r\n    padding: 8px 10px;\r\n  }\r\n}\r\n</style>"],"mappings":"AAaA,eAAe;EACbA,IAAI,EAAE,sBAAsB;EAC5BC,KAAK,EAAE;IACLC,WAAW,EAAE;MAAEC,IAAI,EAAEC,MAAM;MAAEC,QAAQ,EAAE;IAAK,CAAC;IAC7CC,aAAa,EAAE;MAAEH,IAAI,EAAEI,KAAK;MAAEC,OAAO,EAAEA,CAAA,KAAM;IAAG;E