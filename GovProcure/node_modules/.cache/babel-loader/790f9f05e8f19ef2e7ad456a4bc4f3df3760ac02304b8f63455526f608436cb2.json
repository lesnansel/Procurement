reviousUid = user.uid;\r\n      unloadTawk(); // Fully reset Tawk widget\r\n\r\n      setTimeout(() => {\r\n        try {\r\n          loadTawk(); // Re-inject after cleanup delay\r\n        } catch (e) {\r\n          console.warn('Tawk load error:', e.message);\r\n        }\r\n      }, 500); // ⏱ Delay to prevent race condition\r\n    }\r\n  } else {\r\n    previousUid = null;\r\n    unloadTawk(); // Clean up if no user or excluded route\r\n  }\r\n};\r\n\r\n// 🔁 React to route changes\r\nwatch(() => route.path, checkTawkStatus, { immediate: true });\r\n\r\n// 👤 React to auth state changes\r\nonAuthStateChanged(auth, checkTawkStatus);\r\n</script>\r\n\r\n<script>\r\nexport default {\r\n  name: 'App',\r\n};\r\n</script>\r\n\r\n<style>\r\n#app {\r\n  font-family: Avenir, Helvetica, Arial, sans-serif;\r\n  -webkit-font-smoothing: antialiased;\r\n  -moz-osx-font-smoothing: grayscale;\r\n  text-align: center;\r\n  color: #e2e5e8;\r\n}\r\n\r\nmain {\r\n  padding: 20px;\r\n  max-width: 1200px;\r\n  margin: 0 auto;\r\n}\r\n</style>\r\n"],"mappings":";OAGSA,UAA4B;;EAG9BC,EAAE,EAAC;AAAK;;;uBANfC,mBAAA,CAAAC,SAAA,S,0BAEAC,mBAAA,CAGW,iBAFPA,mBAAA,CAA4D;IAAvDC,GAA4B,EAA5BL,UAA4B;IAACM,GAAG,EAAC,MAAM;IAACC,KAAK,EAAC;MACnDH,mBAAA,CAA2B,YAAvB,oBAAkB,E,sBAExBA,mBAAA,CAEM,OAFNI,UAEM,GADJC,YAAA,CAA2BC,sBAAA,E","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}