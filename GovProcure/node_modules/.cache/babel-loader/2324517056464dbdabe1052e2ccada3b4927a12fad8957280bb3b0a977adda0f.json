tion\"></textarea>\r\n        </div>\r\n\r\n        <div v-else>\r\n          <p>Are you sure you want to delete the bid titled <strong>{{ selectedBid.title }}</strong>?</p>\r\n        </div>\r\n\r\n        <div class=\"flex justify-end space-x-3\">\r\n          <button @click=\"closeModal\" class=\"btn-cancel\">Cancel</button>\r\n          <button v-if=\"modalMode === 'edit'\" @click=\"saveBid\" class=\"btn-primary\">Save</button>\r\n          <button v-if=\"modalMode === 'delete'\" @click=\"confirmDeleteBid\" class=\"btn-danger\">Delete</button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </section>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref } from 'vue';\r\n\r\nconst bids = ref([\r\n  { id: '1', title: 'Bid A', description: 'Description for Bid A' },\r\n  { id: '2', title: 'Bid B', description: 'Description for Bid B' },\r\n]);\r\n\r\nconst showModal = ref(false);\r\nconst modalMode = ref('view'); // 'view', 'edit', 'delete'\r\nconst selectedBid = ref({});\r\n\r\nconst viewBid = (bid) => {\r\n  selectedBid.value = { ...bid };\r\n  modalMode.value = 'view';\r\n  showModal.value = true;\r\n};\r\n\r\nconst editBid = (bid) => {\r\n  selectedBid.value = { ...bid };\r\n  modalMode.value = 'edit';\r\n  showModal.value = true;\r\n};\r\n\r\nconst deleteBid = (bid) => {\r\n  selectedBid.value = { ...bid };\r\n  modalMode.value = 'delete';\r\n  showModal.value = true;\r\n};\r\n\r\nconst closeModal = () => {\r\n  showModal.value = false;\r\n  selectedBid.value = {};\r\n};\r\n\r\nconst saveBid = () => {\r\n  const index = bids.value.findIndex(b => b.id === selectedBid.value.id);\r\n  if (index !== -1) bids.value[index] = { ...selectedBid.value };\r\n  closeModal();\r\n};\r\n\r\nconst confirmDeleteBid = () => {\r\n  bids.value = bids.value.filter(b => b.id !== selectedBid.value.id);\r\n  closeModal();\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.input {\r\n  width: 100%;\r\n  border: 1px solid #d1d5db;\r\n  border-radius: 0.375rem;\r\n  padding: 0.5rem;\r\n}