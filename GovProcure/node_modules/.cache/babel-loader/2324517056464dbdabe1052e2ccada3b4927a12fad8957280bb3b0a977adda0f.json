{"ast":null,"code":"import \"core-js/modules/esnext.iterator.constructor.js\";\nimport \"core-js/modules/esnext.iterator.filter.js\";\nimport { ref } from 'vue';\nexport default {\n  __name: 'InvitationToBid',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const bids = ref([{\n      id: '1',\n      title: 'Bid A',\n      description: 'Description for Bid A'\n    }, {\n      id: '2',\n      title: 'Bid B',\n      description: 'Description for Bid B'\n    }]);\n    const showModal = ref(false);\n    const modalMode = ref('view'); // 'view', 'edit', 'delete'\n    const selectedBid = ref({});\n    const viewBid = bid => {\n      selectedBid.value = {\n        ...bid\n      };\n      modalMode.value = 'view';\n      showModal.value = true;\n    };\n    const editBid = bid => {\n      selectedBid.value = {\n        ...bid\n      };\n      modalMode.value = 'edit';\n      showModal.value = true;\n    };\n    const deleteBid = bid => {\n      selectedBid.value = {\n        ...bid\n      };\n      modalMode.value = 'delete';\n      showModal.value = true;\n    };\n    const closeModal = () => {\n      showModal.value = false;\n      selectedBid.value = {};\n    };\n    const saveBid = () => {\n      const index = bids.value.findIndex(b => b.id === selectedBid.value.id);\n      if (index !== -1) bids.value[index] = {\n        ...selectedBid.value\n      };\n      closeModal();\n    };\n    const confirmDeleteBid = () => {\n      bids.value = bids.value.filter(b => b.id !== selectedBid.value.id);\n      closeModal();\n    };\n    const __returned__ = {\n      bids,\n      showModal,\n      modalMode,\n      selectedBid,\n      viewBid,\n      editBid,\n      deleteBid,\n      closeModal,\n      saveBid,\n      confirmDeleteBid,\n      ref\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","bids","id","title","de