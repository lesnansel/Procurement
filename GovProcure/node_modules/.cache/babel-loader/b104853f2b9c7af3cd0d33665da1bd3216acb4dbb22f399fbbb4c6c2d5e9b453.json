D USER\", \"NOTICE TO PROCEED\",\r\n        \"PREPARATION\", \"REVIEW\", \"FORWARDED TO EA\", \"NTP APPROVED\",\r\n        \"FORWARDED TO END USER (NTP)\", \"PO/CONTRACT & NTP POSTED\", \"REMARKS\"\r\n      ];\r\n    },\r\n    currentStepIndex() {\r\n      return this.steps.indexOf(this.currentStep);\r\n    },\r\n    statusHistoryMap() {\r\n      const map = {};\r\n      this.statusHistory.forEach(entry => {\r\n        if (entry.step && entry.updatedAt) {\r\n          map[entry.step] = entry.updatedAt;\r\n        }\r\n      });\r\n      return map;\r\n    }\r\n  },\r\n  methods: {\r\n    formatDate(dateStr) {\r\n      if (!dateStr) return \"\";\r\n      const date = typeof dateStr === \"object\" && dateStr.toDate\r\n        ? dateStr.toDate()\r\n        : new Date(dateStr);\r\n      return date.toLocaleDateString(\"en-US\", {\r\n        year: \"numeric\",\r\n        month: \"short\",\r\n        day: \"numeric\"\r\n      });\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.status-bar-container {\r\n  overflow-x: auto;\r\n  padding: 12px;\r\n  background: #f0f4f8;\r\n  border-radius: 8px;\r\n  border: 1px solid #ccc;\r\n}\r\n\r\n.status-bar {\r\n  display: flex;\r\n  align-items: center;\r\n  flex-wrap: nowrap;\r\n  gap: 12px;\r\n  min-width: max-content;\r\n}\r\n\r\n.status-step {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  gap: 4px;\r\n  padding: 8px 12px;\r\n  border-radius: 16px;\r\n  font-size: 0.75rem;\r\n  text-align: center;\r\n  white-space: nowrap;\r\n  background: #e5e7eb;\r\n  color: #1f2937;\r\n  min-width: 120px;\r\n  transition: background-color 0.3s;\r\n}\r\n\r\n.status-step.active {\r\n  background: #d1fae5;\r\n  border: 1px solid #10b981;\r\n  font-weight: bold;\r\n}\r\n\r\n.status-step.current {\r\n  background: #fef9c3;\r\n  border: 1px solid #facc15;\r\n  font-weight: bold;\r\n}\r\n\r\n.status-step.pending {\r\n  background: #f3f4f6;\r\n  color: #9ca3af;\r\n}\r\n\r\n.step-label {\r\n  font-weight: 500;\r\n}\r\n\r\n.step-date {\r\n  font-size: 0.7rem;\r\n  color: #6b7280;\r\n}\r\n\r\n.status-arrow {\r\n  font-weight: bold;\r\n  color: #9ca3af;\r\n}\r\n</style>\r\n"],"mappings":";;EACOA,KAAK,EAAC,sBAAsB;EAACC,IAAI,EAAC,OAAO;EAAC,YAAU,EAAC;;;EACnDD,KAAK,EAAC;AAAY;;EAWbA,KAAK,EAAC;AAAY;;EAbhCE,GAAA;EAc4CF,KAAK,EAAC;;;EAdlDE,GAAA;EAiB4CF,KAAK,EAAC;;;uBAhBhDG,mBAAA,CAmBM,OAnBNC,UAmBM,GAlBJC,mBAAA,CAiBM,OAjBNC,UAiBM,I,kBAhBJH,mBAAA,CAeMI,SAAA,QAlBZC,WAAA,CAI8BC,QAAA,CAAAC,KAAK,EAJnC,CAIgBC,IAAI,EAAEC,GAAG;yBADnBT,mBAAA,CAeM;MAbHD,GAAG,EAAES,IAAI;MACVX,KAAK,EANba,eAAA,EAMc,aAAa;gBACUD,GAAG,GAAGH,QAAA,CAAAK,gBAAgB;iBAAsBF,GAAG,KAAKH,QAAA,CAAAK,gBAAgB;iBAAsBF,GAAG,GAAGH,QAAA,CAAAK;;QAM7HT,mBAAA,CAA0C,QAA1CU,UAA0C,EAAAC,gBAAA,CAAdL,IAAI,kBACpBF,QAAA,CAAAQ,gBAAgB,CAACN,IAAI,K,cAAjCR,mBAAA,CAEO,QAFPe,UAEO,EAF+C,IACnD,GAAAF,gBAAA,CAAGP,QAAA,CAAAU,UAAU,CAACV,QAAA,CAAAQ,gBAAgB,CAACN,IAAI,MAAK,IAC3C,mBAhBRS,mBAAA,gBAiBoBR,GAAG,GAAGH,QAAA,CAAAC,KAAK,CAACW,MAAM,Q,cAA9BlB,mBAAA,CAAiE,QAAjEmB,UAAiE,EAAR,GAAC,KAjBlEF,mBAAA,e","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}