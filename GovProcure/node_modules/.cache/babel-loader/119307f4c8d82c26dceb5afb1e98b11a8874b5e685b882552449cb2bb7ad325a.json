cript>\r\n\r\n<style scoped>\r\n.status-bar-container {\r\n  overflow-x: auto;\r\n  padding-bottom: 10px;\r\n}\r\n\r\n.status-bar {\r\n  display: flex;\r\n  align-items: center;\r\n  flex-wrap: nowrap;\r\n  gap: 12px;\r\n  background: #f8fafc;\r\n  padding: 12px 18px;\r\n  border-radius: 12px;\r\n  box-shadow: 0 2px 8px rgba(16, 42, 66, 0.07);\r\n  min-width: max-content;\r\n}\r\n\r\n.status-step {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  padding: 8px 16px;\r\n  border-radius: 16px;\r\n  background: #e5eaf5;\r\n  color: #0f2942;\r\n  font-weight: 500;\r\n  font-size: 15px;\r\n  transition: background 0.2s, color 0.2s, transform 0.2s;\r\n  box-shadow: 0 1px 3px rgba(16, 42, 66, 0.04);\r\n  position: relative;\r\n}\r\n\r\n.status-step.active {\r\n  background: linear-gradient(135deg, #4a9fff 0%, #2563eb 100%);\r\n  color: #fff;\r\n  box-shadow: 0 2px 8px rgba(74, 159, 255, 0.12);\r\n}\r\n\r\n.status-step.current::before {\r\n  content: \"\";\r\n  position: absolute;\r\n  top: -6px;\r\n  right: -6px;\r\n  width: 10px;\r\n  height: 10px;\r\n  background: #38bdf8;\r\n  border-radius: 50%;\r\n  animation: pulse 1.4s infinite;\r\n}\r\n\r\n.step-label {\r\n  font-weight: 600;\r\n  letter-spacing: 0.5px;\r\n}\r\n\r\n.step-date {\r\n  font-size: 12px;\r\n  color: #d1d5db;\r\n  margin-left: 2px;\r\n}\r\n\r\n.status-arrow {\r\n  margin: 0 4px;\r\n  color: #94a3b8;\r\n  font-size: 18px;\r\n  font-weight: bold;\r\n}\r\n\r\n@keyframes pulse {\r\n  0% {\r\n    transform: scale(0.9);\r\n    opacity: 1;\r\n  }\r\n  70% {\r\n    transform: scale(1.3);\r\n    opacity: 0.5;\r\n  }\r\n  100% {\r\n    transform: scale(0.9);\r\n    opacity: 1;\r\n  }\r\n}\r\n\r\n@media (max-width: 600px) {\r\n  .status-bar {\r\n    flex-direction: column;\r\n    align-items: flex-start;\r\n    gap: 8px;\r\n    padding: 10px;\r\n  }\r\n\r\n  .status-step {\r\n    width: 100%;\r\n    justify-content: flex-start;\r\n    font-size: 14px;\r\n    padding: 8px 10px;\r\n  }\r\n\r\n  .statu