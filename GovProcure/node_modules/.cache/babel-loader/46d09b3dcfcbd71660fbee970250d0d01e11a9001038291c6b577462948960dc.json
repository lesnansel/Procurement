: white;\r\n}\r\n.danger {\r\n  color: #dc2626;\r\n}\r\n</style>"],"mappings":"AAqDA,SAASA,GAAG,QAAQ,KAAK;;;;;;;IAEzB,MAAMC,WAAW,GAAGD,GAAG,CAAC,IAAI,CAAC;IAE7B,MAAME,YAAY,GAAGF,GAAG,CAAC;MACvBG,QAAQ,EAAE,eAAe;MACzBC,QAAQ,EAAE,OAAO;MACjBC,MAAM,EAAE;IACV,CAAC,CAAC;IAEF,SAASC,SAASA,CAACC,IAAI,EAAE;MACvBN,WAAW,CAACO,KAAK,GAAGD,IAAI;IAC1B;IAEA,SAASE,UAAUA,CAAA,EAAG;MACpBR,WAAW,CAACO,KAAK,GAAG,IAAI;IAC1B;IAEA,SAASE,WAAWA,CAAA,EAAG;MACrBC,OAAO,CAACC,GAAG,CAAC,SAAS,EAAEV,YAAY,CAACM,KAAK,CAAC;MAC1CC,UAAU,CAAC,CAAC;IACd;IAEA,SAASI,aAAaA,CAAA,EAAG;MACvBF,OAAO,CAACC,GAAG,CAAC,WAAW,EAAEV,YAAY,CAACM,KAAK,CAAC;MAC5CC,UAAU,CAAC,CAAC;IACd","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}