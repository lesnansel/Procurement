{"ast":null,"code":"import { ref } from 'vue';\nexport default {\n  __name: 'ContractManagement',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const activeModal = ref(null);\n    const contractData = ref({\n      supplier: 'LeZna Devices',\n      poNumber: '01543',\n      status: 'Pending'\n    });\n    function openModal(type) {\n      activeModal.value = type;\n    }\n    function closeModal() {\n      activeModal.value = null;\n    }\n    function saveChanges() {\n      console.log('Saving:', contractData.value);\n      closeModal();\n    }\n    function confirmDelete() {\n      console.log('Deleting:', contractData.value);\n      closeModal();\n    }\n    const __returned__ = {\n      activeModal,\n      contractData,\n      openModal,\n      closeModal,\n      saveChanges,\n      confirmDelete,\n      ref\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","activeModal","contractData","supplier","poNumber","status","openModal","type","value","closeModal","saveChanges","console","log","confirmDelete"],"sources":["C:/laragon/www/Capstone/Connected to github/Procurement/GovProcure/src/components/ContractManagement.vue"],"sourcesContent":["<template>\r\n  <div class=\"contract-page\">\r\n    <!-- Contract Card -->\r\n    <div class=\"contract-card\">\r\n      <div class=\"contract-header\">\r\n        <h2>LeZna Devices</h2>\r\n        <span class=\"status-badge\">Pending</span>\r\n      </div>\r\n      <div class=\"contract-info\">\r\n        <span class=\"po-number\">PO: 01543</span>\r\n      </div>\r\n      <div class=\"contract-actions\">\r\n        <button @click=\"openModal('view')\">👁️ View</button>\r\n        <button @click=\"openModal('edit')\">✏️ Edit</button>\r\n        <button @click=\"openModal('delete')\">🗑️ Delete</button>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Modal -->\r\n    <div v-if=\"activeModal\" class=\"modal-overlay\">\r\n      <div class=\"modal-box\">\r\n        <button class=\"modal-close\" @click=\"closeModal\">&times;</button>\r\n\r\n        <!-- View Modal -->\r\n        <div v-if=\"activeModal === 'view'\">\r\n          <h3>View Contract</h3>\r\n          <p><strong>Supplier:</strong> LeZna Devices</p>\r\n          <p><strong>PO Number:</strong> 01543</p>\r\n          <p><strong>Status:</strong> Pending</p>\r\n        </div>\r\n\r\n        <!-- Edit Modal -->\r\n        <div v-else-if=\"activeModal === 'edit'\">\r\n          <h3>Edit Contract</h3>\r\n          <input type=\"text\" v-model=\"contractData.supplier\" />\r\n          <button @click=\"saveChanges\">Save</button>\r\n        </div>\r\n\r\n        <!-- Delete Modal -->\r\n        <div v-else-if=\"activeModal === 'delete'\">\r\n          <h3 class=\"danger\">Confirm Deletion</h3>\r\n          <p>Are you sure you want to delete <strong>{{ contractData.supplier }}</strong>?</p>\r\n          <div class=\"modal-actions\">\r\n            <button @click=\"closeModal\">Cancel</button>\r\n            <button class=\"danger\" @click=\"confirmDelete\">Delete</button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref } from 'vue'\r\n\r\nconst activeModal = ref(null)\r\n\r\nconst contractData = ref({\r\n  supplier: 'LeZna Devices',\r\n  poNumber: '01543',\r\n  status: 'Pending'\r\n})\r\n\r\nfunction openModal(type) {\r\n  activeModal.value = type\r\n}\r\n\r\nfunction closeModal() {\r\n  activeModal.value = null\r\n}\r\n\r\nfunction saveChanges() {\r\n  console.log('Saving:', contractData.value)\r\n  closeModal()\r\n}\r\n\r\nfunction confirmDelete() {\r\n  console.log('Deleting:', contractData.value)\r\n  closeModal()\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.contract-page {\r\n  padding: 24px;\r\n}\r\n\r\n.contract-card {\r\n  border: 2px solid #facc15;\r\n  border-radius: 12px;\r\n  padding: 1