{"ast":null,"code":"export default {\n  name: \"AdminNavigationBar\",\n  data() {\n    return {\n      defaultAvatar: \"https://via.placeholder.com/150\",\n      sidebarVisible: true,\n      showLogoutModal: false // State for showing the logout confirmation modal\n    };\n  },\n  methods: {\n    handleLogout() {\n      this.showLogoutModal = true; // Show the modal\n    },\n    confirmLogout() {\n      console.log(\"Logout confirmed\");\n      this.showLogoutModal = false; // Hide the modal\n      // Implement actual logout logic here\n    },\n    cancelLogout() {\n      console.log(\"Logout canceled\");\n      this.showLogoutModal = false; // Hide the modal\n    },\n    toggleSidebar() {\n      this.sidebarVisible = !this.sidebarVisible;\n      this.$emit('sidebar-toggle', this.sidebarVisible);\n      localStorage.setItem('sidebarVisible', this.sidebarVisible);\n    }\n  },\n  mounted() {\n    // Restore sidebar state from localStorage if available\n    const savedState = localStorage.getItem('sidebarVisible');\n    if (savedState !== null) {\n      this.sidebarVisible = savedState === 'true';\n    }\n\n    // Add keyboard shortcut (Ctrl+B) to toggle sidebar\n    document.addEventListener('keydown', e => {\n      if (e.ctrlKey && e.key === 'b') {\n        e.preventDefault();\n        this.toggleSidebar();\n      }\n    });\n  }\n};","map":{"version":3,"names":["name","data","defaultAvatar","sidebarVisible","showLogoutModal","methods","handleLogout","confirmLogout","console","log","cancelLogout","toggleSidebar","$emit","localStorage","setItem","mounted","savedState","getItem","document","addEventListener","e","ctrlKey","key","preventDefault"],"sources":["C:\\laragon\\www\\Capstone\\Connected to github\\Procurement\\GovProcure\\src\\components\\AdminNavigationBar.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <!-- Toggle button that's always visible -->\r\n    <button \r\n      class=\"sidebar-toggle-btn\" \r\n      @click=\"toggleSidebar\"\r\n      aria-labe