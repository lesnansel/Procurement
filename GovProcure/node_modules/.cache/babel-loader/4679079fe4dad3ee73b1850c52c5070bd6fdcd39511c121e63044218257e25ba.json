ns.detectDelays(...args))\n  }, \" Detect Delays \"), _createElementVNode(\"button\", {\n    class: \"btn btn-add\",\n    onClick: _cache[3] || (_cache[3] = (...args) => $options.addNewRow && $options.addNewRow(...args))\n  }, \" Add New Row \")])]), $data.delays.length ? (_openBlock(), _createElementBlock(\"div\", _hoisted_5, [_createElementVNode(\"div\", _hoisted_6, \" Delays Detected: \" + _toDisplayString($data.delays.length), 1 /* TEXT */)])) : _createCommentVNode(\"v-if\", true), _createElementVNode(\"div\", _hoisted_7, [_createElementVNode(\"table\", null, [_createElementVNode(\"thead\", null, [_createElementVNode(\"tr\", null, [(_openBlock(true), _createElementBlock(_Fragment, null, _renderList($data.headers, header => {\n    return _openBlock(), _createElementBlock(\"th\", {\n      key: header\n    }, _toDisplayString(header), 1 /* TEXT */);\n  }), 128 /* KEYED_FRAGMENT */))])]), _createElementVNode(\"tbody\", null, [(_openBlock(true), _createElementBlock(_Fragment, null, _renderList($data.data, (row, rowIndex) => {\n    return _openBlock(), _createElementBlock(\"tr\", {\n      key: rowIndex\n    }, [(_openBlock(true), _createElementBlock(_Fragment, null, _renderList(row, (cell, cellIndex) => {\n      return _openBlock(), _createElementBlock(\"td\", {\n        key: cellIndex\n      }, [_withDirectives(_createElementVNode(\"input\", {\n        \"onUpdate:modelValue\": $event => $data.data[rowIndex][cellIndex] = $event,\n        class: \"cell-input\"\n      }, null, 8 /* PROPS */, _hoisted_8), [[_vModelText, $data.data[rowIndex][cellIndex]]])]);\n    }), 128 /* KEYED_FRAGMENT */))]);\n  }), 128 /* KEYED_FRAGMENT */))])])]), !$data.data.length ? (_openBlock(), _createElementBlock(\"div\", _hoisted_9, _cache[6] || (_cache[6] = [_createElementVNode(\"p\", null, \"No records found. Import an Excel file or add a new row to get started.\", -1 /* HOISTED */)]))) : _createCommentVNode(\"v-if\", true)]);\n}","map":{"version":3,"names":["class","key","_createElementBlock","_hoisted_1","_createElementVNode","_hoisted_2","_hoisted_3","_hoisted_4","for","id","type","onChange","_cache","args","$options","importExcel","accept","onClick","exportExcel","detectDelays","addNewRow","$data","delays","length","_hoisted_5","_hoisted_6","_toDisplayString","_createCommentVNode","_hoisted_7","_Fragment","_renderList","headers","header","data","row","rowIndex","cell","cellIndex","$event","_hoisted_8","_hoisted_9"],"sources":["C:\\laragon\\www\\Capstone\\Connected to github\\Procurement\\GovProcure\\src\\components\\Records.vue"],"sourcesContent":["<template>\r\n  <div class=\"records-container\">\r\n    <div class=\"records-header\">\r\n      <h1>Records Management</h1>\r\n      <div class=\"actions\">\r\n        <div class=\"file-input-wrapper\">\r\n          <label for=\"file-upload\" class=\"btn btn-import\">\r\n            Import Excel\r\n          </label>\r\n          <input id=\"file-upload\" type=\"file\" @change=\"importExcel\" accept=\".xlsx, .xls\" />\r\n        </div>\r\n        <button class=\"btn btn-export\" @click=\"exportExcel\">\r\n          Export Excel\r\n        </button>\r\n        <button class=\"btn btn-detect\" @click=\"detectDelays\">\r\n          Detect Delays\r\n        </button>\r\n        <button class=\"btn btn-add\" @click=\"addNewRow\">\r\n          Add New Row\r\n        </button>\r\n      </div>\r\n    </div>\r\n    \r\n    <div class=\"notification\" v-if=\"delays.length\">\r\n      <div class=\"notification-content\">\r\n        Delays Detected: {{ delays.length }}\r\n      </div>\r\n    </div>\r\n    \r\n    <div class=\"table-container\">\r\n      <table>\r\n        <thead>\r\n          <tr>\r\n            <th v-for=\"header in headers\" :key=\"header\">{{ header }}</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr v-for=\"(row, rowIndex) in data\" :key=\"rowIndex\">\r\n            <td v-for=\"(cell, cellIndex) in row\" :key=\"cellIndex\">\r\n              <input v-model=\"data[rowIndex][cellIndex]\" class=\"cell-input\" />\r\n            </td>\r\n          </tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n    \r\n    <div class=\"empty-state\" v-if=\"!data.length\">\r\n      <p>No records found. Import an Excel file or add a new row to get started.</p>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport * as XLSX from \"xlsx\";\r\nimport { ref, uploadBytes } from \"firebase/storage\";\r\nimport { storage } from \"@/firebase\";\r\nimport dayjs from \"dayjs\";\r\n\r\nexport default {\r\n  name: \"RecordsManagement\",\r\n  data() {\r\n    return {\r\n      headers: [],\r\n      data: [],\r\n      delays: [],\r\n    };\r\n  },\r\n  methods: {\r\n    importExcel(event) {\r\n      const file = event.target.files[0];\r\n      const reader = new FileReader();\r\n      reader.onload = (e) => {\r\n        const workbook = XLSX.read(e.target.result, { type: \"binary\" });\r\n        const sheetName = workbook.SheetNames[0];\r\n        const sheet = workbook.Sheets[sheetName];\r\n        const jsonData = XLSX.utils.sheet_to_json(sheet, { header: 1 });\r\n        this.headers = jsonData[0];\r\n        this.data = jsonData.slice(1);\r\n        this.ensureDataConsistency(); // Ensure data consistency after importing\r\n      };\r\n      reader.readAsBinaryString(file);\r\n    },\r\n    exportExcel() {\r\n      const worksheet = XLSX.utils.aoa_to_sheet([this.headers, ...this.data]);\r\n      const workbook = XLSX.utils.book_new();\r\n      XLSX.utils.book_append_sheet(workbook, worksheet, \"Sheet1\");\r\n      XLSX.writeFile(workbook, \"exported_data.xlsx\");\r\n    },\r\n    detectDelays() {\r\n      const today = dayjs();\r\n      this.delays = this.data.filter((row) => {\r\n        const dateIndex = this.headers.indexOf(\"Date\");\r\n        if (dateIndex !== -1) {\r\n          const date = dayjs(row[dateIndex]);\r\n          return today.diff(date, \"day\") > 10;\r\n        }\r\n        return false;\r\n      });\r\n      console.log(\"Delays Detected:\", this.delays);\r\n    },\r\n    async saveToFirestore() {\r\n      const file = new Blob([JSON.stringify({ headers: this.headers, data: this.data })], {\r\n        type: \"application/json\",\r\n      });\r\n      const storageRef = ref(storage, `excel-files/records_${Date.now()}.json`);\r\n      try {\r\n        await uploadBytes(storageRef, file);\r\n        alert(\"File saved to Firestore successfully!\");\r\n      } catch (error) {\r\n        console.error(\"Error saving file to Firestore:\", error);\r\n      }\r\n    },\r\n    addNewRow() {\r\n      const newRow = Array(this.headers.length).fill(\"\"); // Ensure the new row matches the number of headers\r\n      this.data.push(newRow);\r\n      this.ensureDataConsistency(); // Ensure data consistency after adding a new row\r\n    },\r\n    ensureDataConsistency() {\r\n      // Ensure all rows have the same number of cells as headers\r\n      this.data = this.data.map((row) => {\r\n        const adjustedRow = Array(this.headers.length).fill(\"\");\r\n        row.forEach((cell, index) => {\r\n          if (index < this.headers.length) {\r\n            adjustedRow[index] = cell;\r\n          }\r\n        });\r\n        return adjustedRow;\r\n      });\r\n\r\n      // Ensure all columns have the same number of rows\r\n      const maxRows = this.data.length;\r\n      while (this.data.length < maxRows) {\r\n        this.data.push(Array(this.headers.length).fill(\"\"));\r\n      }\r\n    },\r\n  },\r\n  mounted() {\r\n    this.ensureDataConsistency();\r\n  },\r\n  watch: {\r\n    data: {\r\n      handler() {\r\n        // Removed ensureDataConsistency to prevent recursive updates\r\n      },\r\n      deep: true,\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* Basic reset and container */\r\n.records-container {\r\n  padding: 10px;\r\n  font-family: Arial, sans-serif;\r\n  width: 100%;\r\n  box-sizing: border-box;\r\n}\r\n\r\n/* Header and title */\r\n.records-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  margin-bottom: 15px;\r\n  flex-wrap: wrap;\r\n  gap: 10px;\r\n}\r\n\r\n.records-header h1 {\r\n  font-size: 20px;\r\n  margin: 0;\r\n  color: #333;\r\n}\r\n\r\n/* Action buttons */\r\n.actions {\r\n  display: flex;\r\n  gap: 8px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.btn {\r\n  padding: 6px 12px;\r\n  border: 1px solid #ccc;\r\n  border-radius: 3px;\r\n  background-color: #f8f8f8;\r\n  color: #333;\r\n  font-size: 14px;\r\n  cursor: pointer;\r\n  white-space: nowrap;\r\n}\r\n\r\n.btn:hover {\r\n  background-color: #e8e8e8;\r\n}\r\n\r\n.btn-import {\r\n  background-color: #f8f8f8;\r\n  display: inline-block;\r\n}\r\n\r\n/* File input styling */\r\n.file-input-wrapper {\r\n  position: relative;\r\n  display: inline-block;\r\n}\r\n\r\ninput[type=\"file\"] {\r\n  position: absolute;\r\n  left: 0;\r\n  top: 0;\r\n  opacity: 0;\r\n  width: 0;\r\n  height: 0;\r\n}\r\n\r\n/* Table styling to match the screenshot */\r\n.table-container {\r\n  overflow-x: auto;\r\n  width: 100%;\r\n}\r\n\r\ntable {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n  table-layout: fixed;\r\n}\r\n\r\nth, td {\r\n  border: 1px solid #ddd;\r\n  padding: 0;\r\n  text-align: left;\r\n  font-weight: normal;\r\n  background-color: #f9f9f9;\r\n  height: 30px;\r\n  position: relative;\r\n}\r\n\r\nth {\r\n  background-color: #f1f1f1;\r\n  padding: 8px;\r\n  font-weight: bold;\r\n  text-transform: uppercase;\r\n  font-size: 12px;\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n}\r\n\r\n/* Input styling to match the screenshot */\r\n.cell-input {\r\n  width: 100%;\r\n  height: 100%;\r\n  padding: 6px 8px;\r\n  border: none;\r\n  box-sizing: border-box;\r\n  font-family: inherit;\r\n  font-size: 14px;\r\n  background-color: white;\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  right: 0;\r\n  bottom: 0;\r\n}\r\n\r\n.cell-input:focus {\r\n  outline: 2px solid #4d90fe;\r\n  z-index: 1;\r\n}\r\n\r\n/* Notification */\r\n.notification {\r\n  margin: 10px 0;\r\n  padding: 8px 12px;\r\n  background-color: #fff3cd;\r\n  border: 1px solid #ffeeba;\r\n  border-radius: 3px;\r\n  color: #856404;\r\n}\r\n\r\n/* Empty state */\r\n.empty-state {\r\n  padding: 20px;\r\n  text-align: center;\r\n  background-color: #f8f9fa;\r\n  border: 1px dashed #ddd;\r\n  margin-top: 15px;\r\n  color: #6c757d;\r\n}\r\n\r\n/* Responsive adjustments */\r\n@media (max-width: 768px) {\r\n  .records-header {\r\n    flex-direction: column;\r\n    align-items: flex-start;\r\n  }\r\n  \r\n  .actions {\r\n    width: 100%;\r\n  }\r\n}\r\n\r\n/* Make sure the table is responsive and adapts to zoom */\r\n@media screen and (max-width: 1200px) {\r\n  th, td {\r\n    min-width: 120px; /* Ensure minimum width for cells */\r\n  }\r\n}\r\n\r\n/* Ensure table adapts to zoom by using viewport units */\r\n@media screen and (min-width: 1201px) {\r\n  .table-container {\r\n    max-width: 100vw;\r\n  }\r\n  \r\n  th, td {\r\n    min-width: 120px;\r\n  }\r\n}\r\n</style>"],"mappings":";;EACOA,KAAK,EAAC;AAAmB;;EACvBA,KAAK,EAAC;AAAgB;;EAEpBA,KAAK,EAAC;AAAS;;EACbA,KAAK,EAAC;AAAoB;;EALvCC,GAAA;EAuBSD,KAAK,EAAC;;;EACJA,KAAK,EAAC;AAAsB;;EAK9BA,KAAK,EAAC;AAAiB;mBA7BhC;;EAAAC,GAAA;EA8CSD,KAAK,EAAC;;;uBA7CbE,mBAAA,CAgDM,OAhDNC,UAgDM,GA/CJC,mBAAA,CAmBM,OAnBNC,UAmBM,G,0BAlBJD,mBAAA,CAA2B,YAAvB,oBAAkB,sBACtBA,mBAAA,CAgBM,OAhBNE,UAgBM,GAfJF,mBAAA,CAKM,OALNG,UAKM,G,0BAJJH,mBAAA,CAEQ;IAFDI,GAAG,EAAC,aAAa;IAACR,KAAK,EAAC;KAAiB,gBAEhD,sBACAI,mBAAA,CAAiF;IAA1EK,EAAE,EAAC,aAAa;IAACC,IAAI,EAAC,MAAM;IAAEC,QAAM,EAAAC,MAAA,QAAAA,MAAA,UAAAC,IAAA,KAAEC,QAAA,CAAAC,WAAA,IAAAD,QAAA,CAAAC,WAAA,IAAAF,IAAA,CAAW;IAAEG,MAAM,EAAC;uCAEnEZ,mBAAA,CAES;IAFDJ,KAAK,EAAC,gBAAgB;IAAEiB,OAAK,EAAAL,MAAA,QAAAA,MAAA,UAAAC,IAAA,KAAEC,QAAA,CAAAI,WAAA,IAAAJ,QAAA,CAAAI,WAAA,IAAAL,IAAA,CAAW;KAAE,gBAEpD,GACAT,mBAAA,CAES;IAFDJ,KAAK,EAAC,gBAAgB;IAAEiB,OAAK,EAAAL,MAAA,QAAAA,MAAA,UAAAC,IAAA,KAAEC,QAAA,CAAAK,YAAA,IAAAL,QAAA,CAAAK,YAAA,IAAAN,IAAA,CAAY;