{"ast":null,"code":"import \"core-js/modules/esnext.iterator.map.js\";\nimport { ref, onMounted } from \"vue\";\nimport { db } from \"@/firebase\";\nimport { collection, addDoc, getDocs, deleteDoc, doc } from \"firebase/firestore\"; // Removed updateDoc\n\nexport default {\n  setup() {\n    const contracts = ref([]);\n    const newContract = ref({\n      supplier: \"\",\n      poNumber: \"\",\n      status: \"Pending\"\n    });\n    const fetchContracts = async () => {\n      const querySnapshot = await getDocs(collection(db, \"contracts\"));\n      contracts.value = querySnapshot.docs.map(doc => ({\n        id: doc.id,\n        ...doc.data()\n      }));\n    };\n    const addContract = async () => {\n      try {\n        await addDoc(collection(db, \"contracts\"), newContract.value);\n        alert(\"Contract added successfully\");\n        newContract.value = {\n          supplier: \"\",\n          poNumber: \"\",\n          status: \"Pending\"\n        };\n        fetchContracts();\n      } catch (error) {\n        console.error(\"Error adding contract:\", error);\n        alert(\"Failed to add contract. Please try again.\");\n      }\n    };\n    const editContract = () => {\n      // Logic for editing a contract\n    }; // Removed unused parameter 'index'\n\n    const deleteContract = async id => {\n      if (confirm(\"Are you sure you want to delete this contract?\")) {\n        try {\n          await deleteDoc(doc(db, \"contracts\", id));\n          alert(\"Contract deleted successfully\");\n          fetchContracts();\n        } catch (error) {\n          console.error(\"Error deleting contract:\", error);\n          alert(\"Failed to delete contract. Please try again.\");\n        }\n      }\n    };\n    onMounted(fetchContracts);\n    return {\n      contracts,\n      newContract,\n      addContract,\n      editContract,\n      deleteContract\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","db","collection","addDoc","getDocs","deleteDoc","doc","setup","contracts","newContract","supplier","poNumber","status","fetchContracts","querySnapshot","value","docs","map","id","data","addContract","alert","error","console","editContract","deleteContract","confirm"],"sources":["C:\\laragon\\www\\Capstone\\Connected to github\\Procurement\\GovProcure\\src\\components\\ContractManagement.vue"],"sourcesContent":["<template>\r\n  <div class=\"contract-management\">\r\n    <!-- Header Section -->\r\n    <div class=\"header\">\r\n      <h1>Contract Management</h1>\r\n      <p>Manage all contracts efficiently</p>\r\n    </div>\r\n\r\n    <!-- Form Section -->\r\n    <div class=\"form-section\">\r\n      <form @submit.prevent=\"addContract\" class=\"form\">\r\n        <div class=\"form-group\">\r\n          <label for=\"supplier\">Supplier</label>\r\n          <input v-model=\"newContract.supplier\" id=\"supplier\" type=\"text\" placeholder=\"Enter supplier name\" required />\r\n        </div>\r\n        <div class=\"form-group\">\r\n          <label for=\"poNumber\">PO Number</label>\r\n          <input v-model=\"newContract.poNumber\" id=\"poNumber\" type=\"text\" placeholder=\"Enter PO number\" required />\r\n        </div>\r\n        <div class=\"form-group\">\r\n          <label>Status</label>\r\n          <div class=\"status-options\">\r\n            <label>\r\n              <input type=\"radio\" value=\"Active\" v-model=\"newContract.status\" /> Active\r\n            </label>\r\n            <label>\r\n              <input type=\"radio\" value=\"Pending\" v-model=\"newContract.status\" /> Pending\r\n            </label>\r\n          </div>\r\n        </div>\r\n        <button type=\"submit\" class=\"btn-primary\">Add Contract</button>\r\n      </form>\r\n    </div>\r\n\r\n    <!-- Contracts Table -->\r\n    <div class=\"table-section\" v-if=\"contracts.length\">\r\n      <table class=\"contracts-table\">\r\n        <thead>\r\n          <tr>\r\n            <th>Supplier</th>\r\n            <th>PO Number</th>\r\n            <th>Status</th>\r\n            <th>Actions</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr v-for=\"(contract, index) in contracts\" :key=\"contract.id\">\r\n            <td>{{ contract.supplier }}</td>\r\n            <td>{{ contract.poNumber }}</td>\r\n            <td>{{ contract.status }}</td>\r\n            <td>\r\n              <button @click=\"editContract(index)\" class=\"btn-link\">Edit</button>\r\n              <button @click=\"deleteContract(contract.id)\" class=\"btn-danger\">Delete</button>\r\n            </td>\r\n          </tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n    <p v-else class=\"no-contracts\">No contracts available.</p>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted } from \"vue\";\r\nimport { db } from \"@/firebase\";\r\nimport { collection, addDoc, getDocs, deleteDoc, doc } from \"firebase/firestore\"; // Removed updateDoc\r\n\r\nexport default {\r\n  setup() {\r\n    const contracts = ref([]);\r\n    const newContract = ref({ supplier: \"\", poNumber: \"\", status: \"Pending\" });\r\n\r\n    const fetchContracts = async () => {\r\n      const querySnapshot = await getDocs(collection(db, \"contracts\"));\r\n      contracts.value = querySnapshot.docs.map((doc) => ({ id: doc.id, ...doc.data() }));\r\n    };\r\n\r\n    const addContract = async () => {\r\n      try {\r\n        await addDoc(collection(db, \"contracts\"), newContract.value);\r\n        alert(\"Contract added successfully\");\r\n        newContract.value = { supplier: \"\", poNumber: \"\", status: \"Pending\" };\r\n        fetchContracts();\r\n      } catch (error) {\r\n        console.error(\"Error adding contract:\", error);\r\n        alert(\"Failed to add contract. Please try again.\");\r\n      }\r\n    };\r\n\r\n    const editContract = () => {\r\n      // Logic for editing a contract\r\n    }; // Removed unused parameter 'index'\r\n\r\n    const deleteContract = async (id) => {\r\n      if (confirm(\"Are you sure you want to delete this contract?\")) {\r\n        try {\r\n          await deleteDoc(doc(db, \"contracts\", id));\r\n          alert(\"Contract deleted successfully\");\r\n          fetchContracts();\r\n        } catch (error) {\r\n          console.error(\"Error deleting contract:\", error);\r\n          alert(\"Failed to delete contract. Please try again.\");\r\n        }\r\n      }\r\n    };\r\n\r\n    onMounted(fetchContracts);\r\n\r\n    return {\r\n      contracts,\r\n      newContract,\r\n      addContract,\r\n      editContract,\r\n      deleteContract,\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.contract-management {\r\n  font-family: 'Inter', sans-serif;\r\n  padding: 20px;\r\n  max-width: 600px;\r\n  margin: 0 auto;\r\n  position: relative;\r\n  min-height: 100vh;\r\n  background: linear-gradient(135deg, #0b1e33 0%, #0f2942 100%); /* Darkened the background */\r\n  color: #7a2929;\r\n  overflow: hidden;\r\n}\r\n\r\n.contract-management::before {\r\n  content: '';\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  background-image: \r\n    linear-gradient(30deg, rgba(11, 30, 51, 0.5) 12%, transparent 12.5%, transparent 87%, rgba(11, 30, 51, 0.5) 87.5%, rgba(11, 30, 51, 0.5)),\r\n    linear-gradient(150deg, rgba(11, 30, 51, 0.5) 12%, transparent 12.5%, transparent 87%, rgba(11, 30, 51, 0.5) 87.5%, rgba(11, 30, 51, 0.5)),\r\n    linear-gradient(60deg, rgba(0, 0, 0, 0.1) 25%, transparent 25.5%, transparent 75%, rgba(0, 0, 0, 0.1) 75%, rgba(0, 0, 0, 0.1)),\r\n    linear-gradient(60deg, rgba(0, 0, 0, 0.1) 25%, transparent 25.5%, transparent 75%, rgba(0, 0, 0, 0.1) 75%, rgba(0, 0, 0, 0.1));\r\n  background-size: 80px 140px;\r\n  opacity: 0.2;\r\n  z-index: -1;\r\n}\r\n\r\n.header {\r\n  text-align: center;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.header h1 {\r\n  font-size: 24px;\r\n  font-weight: bold;\r\n  color: #ffffff;\r\n}\r\n\r\n.header p {\r\n  font-size: 14px;\r\n  color: rgba(255, 255, 255, 0.8);\r\n}\r\n\r\n.form-section {\r\n  background: rgba(255, 255, 255, 0.1);\r\n  padding: 20px;\r\n  border-radius: 8px;\r\n  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.form-group {\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.form-group label {\r\n  display: block;\r\n  font-size: 14px;\r\n  font-weight: 500;\r\n  color: #ffffff;\r\n  margin-bottom: 5px;\r\n}\r\n\r\n.form-group input {\r\n  width: 100%;\r\n  padding: 10px;\r\n  border: 1px solid #2d3748;\r\n  border-radius: 4px;\r\n  font-size: 14px;\r\n  background-color: #2d3748;\r\n  color: #ffffff;\r\n}\r\n\r\n.form-group input:focus {\r\n  border-color: #3182ce;\r\n  outline: none;\r\n}\r\n\r\n.status-options {\r\n  gap: 10px;\r\n}\r\n\r\n.status-options label {\r\n  font-size: 14px;\r\n  color: #ffffff;\r\n}\r\n\r\n.btn-primary {\r\n  background-color: #3182ce;\r\n  color: white;\r\n  padding: 10px 20px;\r\n  border: none;\r\n  border-radius: 4px;\r\n  font-size: 14px;\r\n  cursor: pointer;\r\n  transition: background-color 0.3s ease;\r\n}\r\n\r\n.btn-primary:hover {\r\n  background-color: #2b6cb0;\r\n}\r\n\r\n.table-section {\r\n  margin-top: 20px;\r\n}\r\n\r\n.contracts-table {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n}\r\n\r\n.contracts-table th,\r\n.contracts-table td {\r\n  padding: 10px;\r\n  text-align: left;\r\n  border-bottom: 1px solid #2d3748;\r\n}\r\n\r\n.contracts-table th {\r\n  background-color: #0f2942;\r\n  color: white;\r\n  font-size: 14px;\r\n  font-weight: 600;\r\n}\r\n\r\n.contracts-table td {\r\n  font-size: 14px;\r\n  color: #ffffff;\r\n}\r\n\r\n.contracts-table tr:hover td {\r\n  background-color: #2d3748;\r\n}\r\n\r\n.btn-link {\r\n  background: none;\r\n  color: #3182ce;\r\n  font-size: 14px;\r\n  text-decoration: underline;\r\n  cursor: pointer;\r\n}\r\n\r\n.btn-link:hover {\r\n  color: #2b6cb0;\r\n}\r\n\r\n.btn-danger {\r\n  background-color: #e53e3e;\r\n  color: white;\r\n  padding: 5px 10px;\r\n  border: none;\r\n  border-radius: 4px;\r\n  font-size: 14px;\r\n  cursor: pointer;\r\n  transition: background-color 0.3s ease;\r\n}\r\n\r\n.btn-danger:hover {\r\n  background-color: #c53030;\r\n}\r\n\r\n.no-contracts {\r\n  text-align: center;\r\n  color: rgba(255, 255, 255, 0.8);\r\n  font-size: 14px;\r\n}\r\n</style>"],"mappings":";AA+DA,SAASA,GAAG,EAAEC,SAAQ,QAAS,KAAK;AACpC,SAASC,EAAC,QAAS,YAAY;AAC/B,SAASC,UAAU,EAAEC,MAAM,EAAEC,OAAO,EAAEC,SAAS,EAAEC,GAAE,QAAS,oBAAoB,EAAE;;AAElF,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN,MAAMC,SAAQ,GAAIT,GAAG,CAAC,EAAE,CAAC;IACzB,MAAMU,WAAU,GAAIV,GAAG,CAAC;MAAEW,QAAQ,EAAE,EAAE;MAAEC,QAAQ,EAAE,EAAE;MAAEC,MAAM,EAAE;IAAU,CAAC,CAAC;IAE1E,MAAMC,cAAa,GAAI,MAAAA,CAAA,KAAY;MACjC,MAAMC,aAAY,GAAI,MAAMV,OAAO,CAACF,UAAU,CAACD,EAAE,EAAE,WAAW,CAAC,CAAC;MAChEO,SAAS,CAACO,KAAI,GAAID,aAAa,CAACE,IAAI,CAACC,GAAG,CAAEX,GAAG,KAAM;QAAEY,EAAE,EAAEZ,GAAG,CAACY,EAAE;QAAE,GAAGZ,GAAG,CAACa,IAAI,CAAC;MAAE,CAAC,CAAC,CAAC;IACpF,CAAC;IAED,MAAMC,WAAU,GAAI,MAAAA,CAAA,KAAY;MAC9B,IAAI;QACF,MAAMjB,MAAM,CAACD,UAAU,CAACD,EAAE,EAAE,WAAW,CAAC,EAAEQ,WAAW,CAACM,KAAK,CAAC;QAC5DM,KAAK,CAAC,6BAA6B,CAAC;QACpCZ,WAAW,CAACM,KAAI,GAAI;UAAEL,QAAQ,EAAE,EAAE;UAAEC,QAAQ,EAAE,EAAE;UAAEC,MAAM,EAAE;QAAU,CAAC;QACrEC,cAAc,CAAC,CAAC;MAClB,EAAE,OAAOS,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,wBAAwB,EAAEA,KAAK,CAAC;QAC9CD,KAAK,CAAC,2CAA2C,CAAC;MACpD;IACF,CAAC;IAED,MAAMG,YAAW,GAAIA,CAAA,KAAM;MACzB;IAAA,CACD,EAAE;;IAEH,MAAMC,cAAa,GAAI,MAAOP,EAAE,IAAK;MACnC,IAAIQ,OAAO,CAAC,gDAAgD,CAAC,EAAE;QAC7D,IAAI;UACF,MAAMrB,SAAS,CAACC,GAAG,CAACL,EAAE,EAAE,WAAW,EAAEiB,EAAE,CAAC,CAAC;UACzCG,KAAK,CAAC,+BAA+B,CAAC;UACtCR,cAAc,CAAC,CAAC;QAClB,EAAE,OAAOS,KAAK,EAAE;UACdC,OAAO,CAACD,KAAK,CAAC,0BAA0B,EAAEA,KAAK,CAAC;UAChDD,KAAK,CAAC,8CAA8C,CAAC;QACvD;MACF;IACF,CAAC;IAEDrB,SAAS,CAACa,cAAc,CAAC;IAEzB,OAAO;MACLL,SAAS;MACTC,WAAW;MACXW,WAAW;MACXI,YAAY;MACZC;IACF,CAAC;EACH;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}