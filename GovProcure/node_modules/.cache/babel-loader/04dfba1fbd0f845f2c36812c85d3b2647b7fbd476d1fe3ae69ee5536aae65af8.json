l = false; } catch (e) { console.error('Error loading file:', e); alert('Failed to load records from storage.'); } }, \")), _createElementVNode(\"button\", {\n    class: \"action-button export\",\n    onClick: _cache[3] || (_cache[3] = (...args) => $options.exportExcel && $options.exportExcel(...args))\n  }, \"Export Excel\"), _createElementVNode(\"button\", {\n    class: \"action-button add\",\n    onClick: _cache[4] || (_cache[4] = (...args) => $options.addNewRow && $options.addNewRow(...args))\n  }, \"Add New Row\"), _createElementVNode(\"button\", {\n    class: \"action-button save\",\n    onClick: _cache[5] || (_cache[5] = (...args) => $options.saveToFirestore && $options.saveToFirestore(...args))\n  }, \"Save\")]), _createElementVNode(\"div\", _hoisted_11, [_createElementVNode(\"div\", _hoisted_12, [_cache[9] || (_cache[9] = _createElementVNode(\"span\", {\n    class: \"summary-label\"\n  }, \"Total Records\", -1 /* HOISTED */)), _createElementVNode(\"span\", _hoisted_13, _toDisplayString($data.data.length), 1 /* TEXT */)]), _createElementVNode(\"div\", _hoisted_14, [_cache[10] || (_cache[10] = _createElementVNode(\"span\", {\n    class: \"summary-label\"\n  }, \"Delays Detected\", -1 /* HOISTED */)), _createElementVNode(\"span\", _hoisted_15, _toDisplayString($data.delays.length), 1 /* TEXT */)]), _createElementVNode(\"div\", _hoisted_16, [_cache[11] || (_cache[11] = _createElementVNode(\"span\", {\n    class: \"summary-label\"\n  }, \"Overdue Steps\", -1 /* HOISTED */)), _createElementVNode(\"span\", _hoisted_17, _toDisplayString($options.overdueCount), 1 /* TEXT */)]), _createElementVNode(\"div\", _hoisted_18, [_cache[12] || (_cache[12] = _createElementVNode(\"span\", {\n    class: \"summary-label\"\n  }, \"On Time\", -1 /* HOISTED */)), _createElementVNode(\"span\", _hoisted_19, _toDisplayString($options.onTimeCount), 1 /* TEXT */)]), _createElementVNode(\"div\", _hoisted_20, [_cache[13] || (_cache[13] = _createElementVNode(\"span\", {\n    class: \"summar