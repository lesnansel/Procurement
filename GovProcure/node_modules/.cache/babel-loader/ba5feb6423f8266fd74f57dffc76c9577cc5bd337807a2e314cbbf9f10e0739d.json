le \"), _createElementVNode(\"div\", _hoisted_5, [_createElementVNode(\"table\", _hoisted_6, [_cache[1] || (_cache[1] = _createElementVNode(\"thead\", null, [_createElementVNode(\"tr\", null, [_createElementVNode(\"th\", null, \"Request ID\"), _createElementVNode(\"th\", null, \"Item Name\"), _createElementVNode(\"th\", null, \"Quantity\"), _createElementVNode(\"th\", null, \"Approved By\"), _createElementVNode(\"th\", null, \"Date Approved\")])], -1 /* HOISTED */)), _createElementVNode(\"tbody\", null, [(_openBlock(true), _createElementBlock(_Fragment, null, _renderList($setup.approvedPurchases, purchase => {\n    return _openBlock(), _createElementBlock(\"tr\", {\n      key: purchase.id\n    }, [_createElementVNode(\"td\", null, _toDisplayString(purchase.requestId), 1 /* TEXT */), _createElementVNode(\"td\", null, _toDisplayString(purchase.itemName), 1 /* TEXT */), _createElementVNode(\"td\", null, _toDisplayString(purchase.quantity), 1 /* TEXT */), _createElementVNode(\"td\", null, _toDisplayString(purchase.approvedBy), 1 /* TEXT */), _createElementVNode(\"td\", null, _toDisplayString($setup.formatDate(purchase.dateApproved)), 1 /* TEXT */)]);\n  }), 128 /* KEYED_FRAGMENT */))])])])], 64 /* STABLE_FRAGMENT */))])])]);\n}","map":{"version":3,"names":["_imports_0","class","key","_createElementBlock","_hoisted_1","_createCommentVNode","_createElementVNode","_hoisted_2","_createStaticVNode","_hoisted_3","$setup","approvedPurchases","length","_hoisted_4","_cache","_Fragment","_hoisted_5","_hoisted_6","_renderList","purchase","id","_toDisplayString","requestId","itemName","quantity","approvedBy","formatDate","dateApproved"],"sources":["C:\\laragon\\www\\Capstone\\Connected to github\\Procurement\\GovProcure\\src\\components\\Approved_Purchases.vue"],"sourcesContent":["<template>\r\n  <div class=\"admin-wrapper\">\r\n    <!-- Background Pattern -->\r\n    <div class=\"background-pattern\">\r\n      <div class=\"pattern-overlay\"></div>\r\n    </div>\r\n\r\n    <!-- Admin Card -->\r\n    <div class=\"admin-card\">\r\n      <div class=\"card-header\">\r\n        <div class=\"logo-container\">\r\n          <img src=\"@/assets/proculogo.png\" alt=\"Procurement System Logo\" class=\"logo\" />\r\n        </div>\r\n        <h1 class=\"title\">Approved Purchases</h1>\r\n        <p class=\"subtitle\">View all approved purchase requests</p>\r\n      </div>\r\n\r\n      <div class=\"card-content\">\r\n        <!-- Loading State -->\r\n        <div v-if=\"approvedPurchases.length === 0\" class=\"loading-state\">\r\n          <p>No approved purchases available.</p>\r\n        </div>\r\n\r\n        <template v-else>\r\n          <!-- Approved Purchases Table -->\r\n          <div class=\"table-container\">\r\n            <table class=\"purchases-table\">\r\n              <thead>\r\n                <tr>\r\n                  <th>Request ID</th>\r\n                  <th>Item Name</th>\r\n                  <th>Quantity</th>\r\n                  <th>Approved By</th>\r\n                  <th>Date Approved</th>\r\n                </tr>\r\n              </thead>\r\n              <tbody>\r\n                <tr v-for=\"purchase in approvedPurchases\" :key=\"purchase.id\">\r\n                  <td>{{ purchase.requestId }}</td>\r\n                  <td>{{ purchase.itemName }}</td>\r\n                  <td>{{ purchase.quantity }}</td>\r\n                  <td>{{ purchase.approvedBy }}</td>\r\n                  <td>{{ formatDate(purchase.dateApproved) }}</td>\r\n                </tr>\r\n              </tbody>\r\n            </table>\r\n          </div>\r\n        </template>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted } from \"vue\";\r\nimport { db } from \"@/firebase\";\r\nimport { collection, getDocs, query, where } from \"firebase/firestore\";\r\n\r\nexport default {\r\n  setup() {\r\n    const approvedPurchases = ref([]);\r\n\r\n    const fetchApprovedPurchases = async () => {\r\n      try {\r\n        const q = query(\r\n          collection(db, \"purchaseRequests\"),\r\n          where(\"status\", \"==\", \"Approved\")\r\n        );\r\n        const querySnapshot = await getDocs(q);\r\n        approvedPurchases.value = querySnapshot.docs.map((doc) => ({ id: doc.id, ...doc.data() }));\r\n      } catch (error) {\r\n        console.error(\"Error fetching approved purchases:\", error);\r\n      }\r\n    };\r\n\r\n    const formatDate = (date) => {\r\n      return new Date(date).toLocaleDateString(\"en-US\", {\r\n        year: \"numeric\",\r\n        month: \"long\",\r\n        day: \"numeric\",\r\n      });\r\n    };\r\n\r\n    onMounted(fetchApprovedPurchases);\r\n\r\n    return {\r\n      approvedPurchases,\r\n      formatDate,\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.admin-wrapper {\r\n  min-height: 100vh;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 20px;\r\n  position: relative;\r\n  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;\r\n}\r\n\r\n/* Background Pattern */\r\n.background-pattern {\r\n  position: fixed;\r\n  inset: 0;\r\n  background-color: #1a1a2e;\r\n  z-index: -1;\r\n  overflow: hidden;\r\n}\r\n\r\n.pattern-overlay {\r\n  position: absolute;\r\n  inset: 0;\r\n  background-image: \r\n    linear-gradient(30deg, rgba(16, 42, 66, 0.5) 12%, transparent 12.5%, transparent 87%, rgba(16, 42, 66, 0.5) 87.5%, rgba(16, 42, 66, 0.5)),\r\n    linear-gradient(150deg, rgba(16, 42, 66, 0.5) 12%, transparent 12.5%, transparent 87%, rgba(16, 42, 66, 0.5) 87.5%, rgba(16, 42, 66, 0.5)),\r\n    linear-gradient(30deg, rgba(16, 42, 66, 0.5) 12%, transparent 12.5%, transparent 87%, rgba(16, 42, 66, 0.5) 87.5%, rgba(16, 42, 66, 0.5)),\r\n    linear-gradient(150deg, rgba(16, 42, 66, 0.5) 12%, transparent 12.5%, transparent 87%, rgba(16, 42, 66, 0.5) 87.5%, rgba(16, 42, 66, 0.5)),\r\n    linear-gradient(60deg, rgba(0, 0, 0, 0.1) 25%, transparent 25.5%, transparent 75%, rgba(0, 0, 0, 0.1) 75%, rgba(0, 0, 0, 0.1)),\r\n    linear-gradient(60deg, rgba(0, 0, 0, 0.1) 25%, transparent 25.5%, transparent 75%, rgba(0, 0, 0, 0.1) 75%, rgba(0, 0, 0, 0.1));\r\n  background-size: 80px 140px;\r\n  background-position: 0 0, 0 0, 40px 70px, 40px 70px, 0 0, 40px 70px;\r\n  opacity: 0.2;\r\n}\r\n\r\n/* Card Design */\r\n.admin-card {\r\n  width: 100%;\r\n  max-width: 1200px;\r\n  background-color: #fff;\r\n  border-radius: 12px;\r\n  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);\r\n  overflow: hidden;\r\n  position: relative;\r\n}\r\n\r\n.card-header {\r\n  background: linear-gradient(135deg, #0f2942 0%, #102a42 100%);\r\n  padding: 30px;\r\n  text-align: center;\r\n  color: white;\r\n}\r\n\r\n.logo-container {\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.logo {\r\n  width: 70px;\r\n  height: 70px;\r\n  object-fit: contain;\r\n}\r\n\r\n.title {\r\n  font-size: 1.75rem;\r\n  font-weight: 700;\r\n  margin-bottom: 8px;\r\n}\r\n\r\n.subtitle {\r\n  font-size: 0.95rem;\r\n  opacity: 0.8;\r\n}\r\n\r\n.card-content {\r\n  padding: 30px;\r\n}\r\n\r\n/* Table Design */\r\n.table-container {\r\n  overflow-x: auto;\r\n}\r\n\r\n.purchases-table {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n}\r\n\r\n.purchases-table th,\r\n.purchases-table td {\r\n  padding: 12px;\r\n  text-align: center;\r\n  border-bottom: 1px solid #e2e8f0;\r\n}\r\n\r\n.purchases-table th {\r\n  background-color: #2b6cb0;\r\n  color: white;\r\n  font-weight: bold;\r\n  font-size: 15px;\r\n}\r\n\r\n.purchases-table td {\r\n  color: #2d3748;\r\n  font-size: 14px;\r\n}\r\n\r\n.purchases-table tr:hover td {\r\n  background-color: #ebf8ff;\r\n}\r\n\r\n.loading-state {\r\n  text-align: center;\r\n  color: #1a202c;\r\n  font-size: 16px;\r\n  font-weight: bold;\r\n}\r\n</style>"],"mappings":";OAWeA,UAA4B;;EAVpCC,KAAK,EAAC;AAAe;;EAOnBA,KAAK,EAAC;AAAY;;EAShBA,KAAK,EAAC;AAAc;;EAjB/BC,GAAA;EAmBmDD,KAAK,EAAC;;;EAM1CA,KAAK,EAAC;AAAiB;;EACnBA,KAAK,EAAC;AAAiB;;uBAzBxCE,mBAAA,CAiDM,OAjDNC,UAiDM,GAhDJC,mBAAA,wBAA2B,E,0BAC3