 $event => $options.loadSelectedFirebaseFile(file),\n      class: \"file-select-btn\"\n    }, _toDisplayString(file.name), 9, _hoisted_9)]);\n  }), 128))])), _createElementVNode(\"button\", {\n    class: \"modal-close-btn\",\n    onClick: _cache[2] || (_cache[2] = $event => $data.showFirebaseFileModal = false)\n  }, \"Cancel\")])])) : _createCommentVNode(\"\", true), _createElementVNode(\"button\", {\n    class: \"action-button export\",\n    onClick: _cache[3] || (_cache[3] = (...args) => $options.exportExcel && $options.exportExcel(...args))\n  }, \"Export Excel\"), _createElementVNode(\"button\", {\n    class: \"action-button add\",\n    onClick: _cache[4] || (_cache[4] = (...args) => $options.addNewRow && $options.addNewRow(...args))\n  }, \"Add New Row\"), _createElementVNode(\"button\", {\n    class: \"action-button save\",\n    onClick: _cache[5] || (_cache[5] = (...args) => $options.saveToFirestore && $options.saveToFirestore(...args))\n  }, \"Save\")]), _createElementVNode(\"div\", _hoisted_10, [_createElementVNode(\"div\", _hoisted_11, [_cache[8] || (_cache[8] = _createElementVNode(\"span\", {\n    class: \"summary-label\"\n  }, \"Total Records\", -1)), _createElementVNode(\"span\", _hoisted_12, _toDisplayString($data.data.length), 1)]), _createElementVNode(\"div\", _hoisted_13, [_cache[9] || (_cache[9] = _createElementVNode(\"span\", {\n    class: \"summary-label\"\n  }, \"Delays Detected\", -1)), _createElementVNode(\"span\", _hoisted_14, _toDisplayString($data.delays.length), 1)]), _createElementVNode(\"div\", _hoisted_15, [_cache[10] || (_cache[10] = _createElementVNode(\"span\", {\n    class: \"summary-label\"\n  }, \"Overdue Steps\", -1)), _createElementVNode(\"span\", _hoisted_16, _toDisplayString($options.overdueCount), 1)]), _createElementVNode(\"div\", _hoisted_17, [_cache[11] || (_cache[11] = _createElementVNode(\"span\", {\n    class: \"summary-label\"\n  }, \"On Time\", -1)), _createElementVNode(\"span\", _hoisted_18, _toDisplayString($options.onTimeCount), 1)]), _createElementVNode(\"div\", _hoisted_19, [_cache[12] || (_cache[12] = _createElementVNode(\"span\", {\n    class: \"summary-label\"\n  }, \"Avg. Process Time\", -1)), _createElementVNode(\"span\", _hoisted_20, _toDisplayString($options.avgProcessTime) + \" days\", 1)])]), _createElementVNode(\"div\", {\n    class: \"table-responsive zoom-container\",\n    style: _normalizeStyle({\n      transform: `scale(${$data.zoomLevel})`,\n      transformOrigin: 'top left',\n      width: `${100 / $data.zoomLevel}%`\n    })\n  }, [_createElementVNode(\"table\", null, [_createElementVNode(\"thead\", null, [_createElementVNode(\"tr\", null, [(_openBlock(true), _createElementBlock(_Fragment, null, _renderList($data.headers, header => {\n    return _openBlock(), _createElementBlock(\"th\", {\n      key: header\n    }, _toDisplayString(header), 1);\n  }), 128)), _cache[13] || (_cache[13] = _createElementVNode(\"th\", null, \"Status\", -1))])]), _createElementVNode(\"tbody\", null, [(_openBlock(true), _createElementBlock(_Fragment, null, _renderList($data.data, (row, rowIndex) => {\n    return _openBlock(), _createElementBlock(\"tr\", {\n      key: rowIndex\n    }, [(_openBlock(true), _createElementBlock(_Fragment, null, _renderList(row, (cell, cellIndex) => {\n      return _openBlock(), _createElementBlock(\"td\", {\n        key: cellIndex\n      }, [_createElementVNode(\"div\", _hoisted_21, [_withDirectives(_createElementVNode(\"input\", {\n        \"onUpdate:modelValue\": $event => $data.data[rowIndex][cellIndex] = $event,\n        onInput: $event => $options.onCellInput(rowIndex, cellIndex)\n      }, null, 40, _hoisted_22), [[_vModelText, $data.data[rowIndex][cellIndex]]]), $data.headers.length > 1 && cellIndex < $data.headers.length ? (_openBlock(), _createElementBlock(\"div\", _hoisted_23, [_createElementVNode(\"span\", _hoisted_24, _toDisplayString($options.getCellStatus(cell, row[cellIndex + 1], rowIndex, cellIndex)?.text), 1), _createElementVNode(\"div\", _hoisted_25, [_createElementVNode(\"div\", {\n        class: \"h-1 rounded bg-emerald-500 transition-all duration-300\",\n        style: _normalizeStyle({\n          width: $options.getCellStatus(cell, row[cellIndex + 1], rowIndex, cellIndex).progress * 100 + '%'\n        })\n      }, null, 4)])])) : _createCommentVNode(\"\", true)])]);\n    }), 128)), _createElementVNode(\"td\", null, [row._overdueSteps && row._overdueSteps.length ? (_openBlock(), _createElementBlock(\"span\", _hoisted_26, \" Overdue: \" + _toDisplayString(row._overdueSteps.join('; ')), 1)) : (_openBlock(), _createElementBlock(\"span\", _hoisted_27, \"On Time\"))])]);\n  }), 128))])])], 4), _createElementVNode(\"div\", _hoisted_28, [_cache[14] || (_cache[14] = _createElementVNode(\"label\", {\n    for: \"zoom-slider\"\n  }, \"Zoom:\", -1)), _createElementVNode(\"span\", null, _toDisplayString(Math.round($data.zoomLevel * 100)) + \"%\", 1)]), $data.delays.length ? (_openBlock(), _createElementBlock(\"p\", _hoisted_29, \"Delays Detected: \" + _toDisplayString($data.delays.length), 1)) : _createCommentVNode(\"\", true)])]);\n}","map":{"version":3,"names":["class","key","style","_createElementBlock","_hoisted_1","_createVNode","_component_AdminNavigationBar","_createElementVNode","_hoisted_2","_hoisted_3","_hoisted_4","type","onChange","_cache","args","$options","importExcel","accept","onClick","openFirebaseFileModal","$data","showFirebaseFileModal","_hoisted_5","_hoisted_6","firebaseFileList","length","_hoisted_7","_hoisted_8","_Fragment","_renderList","file","name","$event","loadSelectedFirebaseFile","_hoisted_9","_createCommentVNode","exportExcel","addNewRow","saveToFirestore","_hoisted_10","_hoisted_11","_hoisted_12","_toDisplayString","data","_hoisted_13","_hoisted_14","delays","_hoisted_15","_hoisted_16","overdueCount","_hoisted_17","_hoisted_18","onTimeCount","_hoisted_19","_hoisted_20","avgProcessTime","_normalizeStyle","transform","zoomLevel","transformOrigin","width","headers","header","row","rowIndex","cell","cellIndex","_hoisted_21","onInput","onCellInput","_hoisted_22","_hoisted_23","_hoisted_24","getCellStatus","text","_hoisted_25","progress","_overdueSteps","_hoisted_26","join","_hoisted_27","_hoisted_28","for","Math","round","_hoisted_29"],"sources":["C:\\laragon\\www\\Capstone\\Connected to github\\Procurement\\GovProcure\\src\\components\\Records.vue"],"sourcesContent":["<template>\r\n  <div class=\"main-content\">\r\n    <AdminNavigationBar />\r\n    <div class=\"records-container\">\r\n      <h1>Records Management</h1>\r\n      <div class=\"actions\">\r\n        <label class=\"custom-file-upload\">\r\n          <input type=\"file\" @change=\"importExcel\" accept=\".xlsx, .xls\" />\r\n          <span>Import Excel</span>\r\n        </label>\r\n        <button class=\"action-button open\" style=\"margin-bottom:0;\" @click=\"openFirebaseFileModal\">Open File</button>\r\n        <!-- Modal for selecting file from Firebase Storage -->\r\n        <div v-if=\"showFirebaseFileModal\" class=\"modal-overlay\">\r\n          <div class=\"modal-content\">\r\n            <h2>Select a file from Firebase Storage</h2>\r\n            <div v-if=\"firebaseFileList.length === 0\" style=\"margin-bottom: 1em;\">Loading files...</div>\r\n            <ul v-else class=\"file-list\">\r\n              <li v-for=\"file in firebaseFileList\" :key=\"file.name\" class=\"file-list-item\">\r\n                <button @click=\"loadSelectedFirebaseFile(file)\" class=\"file-select-btn\">{{ file.name }}</button>\r\n              </li>\r\n            </ul>\r\n            <button class=\"modal-close-btn\" @click=\"showFirebaseFileModal = false\">Cancel</button>\r\n          </div>\r\n        </div>\r\n        <button class=\"action-button export\" @click=\"exportExcel\">Export Excel</button>\r\n        <button class=\"action-button add\" @click=\"addNewRow\">Add New Row</button>\r\n        <button class=\"action-button save\" @click=\"saveToFirestore\">Save</button>\r\n      </div>\r\n      <div class=\"summary-bar\">\r\n        <div class=\"summary-item\">\r\n          <span class=\"summary-label\">Total Records</span>\r\n          <span class=\"summary-value\">{{ data.length }}</span>\r\n        </div>\r\n        <div class=\"summary-item\">\r\n          <span class=\"summary-label\">Delays Detected</span>\r\n          <span class=\"summary-value\">{{ delays.length }}</span>\r\n        </div>\r\n        <div class=\"summary-item\">\r\n          <span class=\"summary-label\">Overdue Steps</span>\r\n          <span class=\"summary-value\">{{ overdueCount }}</span>\r\n        </div>\r\n        <div class=\"summary-item\">\r\n          <span class=\"summary-label\">On Time</span>\r\n          <span class=\"summary-value\">{{ onTimeCount }}</span>\r\n        </div>\r\n        <div class=\"summary-item\">\r\n          <span class=\"summary-label\">Avg. Process Time</span>\r\n          <span class=\"summary-value\">{{ avgProcessTime }} days</span>\r\n        </div>\r\n      </div>\r\n      <div class=\"table-responsive zoom-container\" :style=\"{ transform: `scale(${zoomLevel})`, transformOrigin: 'top left', width: `${100 / zoomLevel}%` }\">\r\n        <table>\r\n          <thead>\r\n            <tr>\r\n              <th v-for=\"header in headers\" :key=\"header\">{{ header }}</th>\r\n              <th>Status</th>\r\n            </tr>\r\n          </thead>\r\n          <tbody>\r\n            <tr v-for=\"(row, rowIndex) in data\" :key=\"rowIndex\">\r\n              <td v-for=\"(cell, cellIndex) in row\" :key=\"cellIndex\">\r\n                <div style=\"display: flex; flex-direction: column; align-items: stretch;\">\r\n                  <input v-model=\"data[rowIndex][cellIndex]\" @input=\"onCellInput(rowIndex, cellIndex)\" />\r\n                  <!-- Status indicator below cell -->\r\n                  <div v-if=\"headers.length > 1 && cellIndex < headers.length\" style=\"margin-top: 2px;\">\r\n                    <span class=\"text-xs italic text-slate-500\" style=\"display: block;\">\r\n                      {{ getCellStatus(cell, row[cellIndex + 1], rowIndex, cellIndex)?.text }}\r\n                    </span>\r\n                    <div class=\"w-full h-1 mt-1 bg-slate-200 rounded\">\r\n                      <div\r\n                        class=\"h-1 rounded bg-emerald-500 transition-all duration-300\"\r\n                        :style=\"{ width: (getCellStatus(cell, row[cellIndex + 1], rowIndex, cellIndex).progress * 100) + '%' }\"\r\n                      ></div>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              </td>\r\n              <td>\r\n  <span v-if=\"row._overdueSteps && row._overdueSteps.length\" class=\"overdue\">\r\n    Overdue: {{ row._overdueSteps.join('; ') }}\r\n  </span>\r\n  <span v-else class=\"on-time\">On Time</span>\r\n  <!-- Status bar removed; only STATUS field is used for process step -->\r\n</td>\r\n            </tr>\r\n          </tbody>\r\n        </table>\r\n      </div>\r\n      <div class=\"zoom-bar\">\r\n        <label for=\"zoom-slider\">Zoom:</label>\r\n        <span>{{ Math.round(zoomLevel * 100) }}%</span>\r\n      </div>\r\n      <p v-if=\"delays.length\">Delays Detected: {{ delays.length }}</p>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport * as XLSX from \"xlsx\";\r\nimport { ref, uploadBytes } from \"firebase/storage\";\r\nimport { storage } from \"@/firebase\";\r\nimport { listAll, getDownloadURL } from \"firebase/storage\";\r\nimport dayjs from \"dayjs\";\r\nimport duration from 'dayjs/plugin/duration';\r\nimport customParseFormat from 'dayjs/plugin/customParseFormat';\r\ndayjs.extend(duration);\r\ndayjs.extend(customParseFormat);\r\nimport AdminNavigationBar from \"./AdminNavigationBar.vue\";\r\n// import ProcurementStatusBar from \"./ProcurementStatusBar.vue\";\r\n\r\n\r\nexport default {\r\n  name: \"RecordsManagement\",\r\n  components: {\r\n    AdminNavigationBar,\r\n    // ProcurementStatusBar removed\r\n  },\r\n  data() {\r\n    return {\r\n      headers: [],\r\n      data: [],\r\n      delays: [],\r\n      zoomLevel: 1,\r\n      steps: [], // not used for dynamic, but kept for compatibility\r\n      cellTimestamps: [], // NEW: stores edit timestamps for each cell\r\n      showFirebaseFileModal: false,\r\n      firebaseFileList: [],\r\n    };\r\n  },\r\n  computed: {\r\n    onTimeCount() {\r\n      if (!this.headers.length) return 0;\r\n      return this.data.filter(row => !row._overdueSteps || row._overdueSteps.length === 0).length;\r\n    },\r\n    avgProcessTime() {\r\n      if (!this.headers.length) return 0;\r\n      const dateIndex = this.headers.findIndex(h => {\r\n        const header = (h || '').toLowerCase();\r\n        return header.includes('date') || header.includes('deadline') || header.includes('due');\r\n      });\r\n      if (dateIndex === -1 || !this.data.length) return 0;\r\n      const today = dayjs();\r\n      const daysArr = this.data.map(row => {\r\n        const date = dayjs(row[dateIndex]);\r\n        return date.isValid() ? today.diff(date, 'day') : null;\r\n      }).filter(days => days !== null && days >= 0);\r\n      if (!daysArr.length) return 0;\r\n      const avg = daysArr.reduce((a, b) => a + b, 0) / daysArr.length;\r\n      return Math.round(avg);\r\n    },\r\n    overdueCount() {\r\n      return this.data.filter(row => row._overdueSteps && row._overdueSteps.length).length;\r\n    },\r\n  },\r\n  methods: {\r\n    async openFirebaseFileModal() {\r\n      this.showFirebaseFileModal = true;\r\n      this.firebaseFileList = [];\r\n      try {\r\n        const listRef = ref(storage, 'excel-files');\r\n        const res = await listAll(listRef);\r\n        this.firebaseFileList = res.items.map(item => ({\r\n          name: item.name,\r\n          fullPath: item.fullPath\r\n        }));\r\n      } catch (e) {\r\n        console.error('Error fetching file list:', e);\r\n        alert('Failed to fetch file list from Firebase Storage.');\r\n        this.showFirebaseFileModal = false;\r\n      }\r\n    },\r\n    async loadSelectedFirebaseFile(file) {\r\n      try {\r\n        const fileRef = ref(storage, file.fullPath);\r\n        const url = await getDownloadURL(fileRef);\r\n        const response = await fetch(url);\r\n        const json = await response.json();\r\n        if (Array.isArray(json) && json.length > 0 && typeof json[0] === 'object' && !Array.isArray(json[0])) {\r\n          this.headers = Object.keys(json[0]);\r\n          this.data = json.map(row => this.headers.map(h => row[h]));\r\n        } else if (Array.isArray(json)) {\r\n          this.data = json;\r\n          this.headers = json[0]?.map((_, i) => `Column ${i + 1}`) || [];\r\n        } else if (json.headers && json.data) {\r\n          this.headers = json.headers;\r\n          this.data = json.data;\r\n        } else {\r\n          console.warn('Unrecognized format', json);\r\n          alert('Unrecognized file format.');\r\n          return;\r\n        }\r\n        this.ensureDataConsistency();\r\n        this.detectDelays();\r\n        this.detectOverdueSteps();\r\n        this.showFirebaseFileModal = false;\r\n      } catch (e) {\r\n        console.error('Error loading file:', e);\r\n        alert('Failed to load file from Firebase Storage.');\r\n      }\r\n    },\r\n    importExcel(event) {\r\n      const file = event.target.files[0];\r\n      const reader = new FileReader();\r\n      reader.onload = (e) => {\r\n        const workbook = XLSX.read(e.target.result, { type: \"binary\" });\r\n        const sheetName = workbook.SheetNames[0];\r\n        const sheet = workbook.Sheets[sheetName];\r\n        const jsonData = XLSX.utils.sheet_to_json(sheet, { header: 1 });\r\n        this.headers = jsonData[0];\r\n        this.data = jsonData.slice(1).map((row) => {\r\n          return row.map((cell, index) => {\r\n            if (this.isDateColumn(index)) {\r\n              if (typeof cell === \"number\") {\r\n                return dayjs(\"1899-12-30\").add(cell, \"day\").format(\"YYYY-MM-DD\");\r\n              } else if (typeof cell === \"string\") {\r\n                const parsed = dayjs(cell, [\"DD/MM/YYYY\", \"MM/DD/YYYY\", \"YYYY-MM-DD\", \"YYYY/MM/DD\", \"MMM-DD\", \"MMMM D, YYYY\"], true);\r\n                if (parsed.isValid()) {\r\n                  return parsed.format(\"YYYY-MM-DD\");\r\n                }\r\n              }\r\n            } \r\n            return cell;\r\n          });\r\n        });\r\n        this.ensureDataConsistency();\r\n        this.detectDelays();\r\n        this.detectOverdueSteps();\r\n      };\r\n      reader.readAsBinaryString(file);\r\n    },\r\n\r\n\r\n    // generateStatusHistory removed; now only STATUS field is used for process step\r\n    isDateColumn(index) {\r\n      const dateKeywords = [\"date\", \"deadline\", \"due\"];\r\n      return dateKeywords.some((keyword) =>\r\n        this.headers[index]?.toLowerCase().includes(keyword)\r\n      );\r\n    },\r\n    exportExcel() {\r\n      const worksheet = XLSX.utils.aoa_to_sheet([this.headers, ...this.data]);\r\n      const workbook = XLSX.utils.book_new();\r\n      XLSX.utils.book_append_sheet(workbook, worksheet, \"Sheet1\");\r\n      XLSX.writeFile(workbook, \"exported_data.xlsx\");\r\n    },\r\n    // --- DYNAMIC STATUS INDICATOR LOGIC ---\r\n    parseDate(value) {\r\n      if (!value || typeof value !== 'string' || value.includes('#')) return null;\r\n      const parsed = dayjs(value.trim(), [\r\n        'YYYY-MM-DD', 'YYYY/MM/DD', 'DD/MM/YYYY', 'MM/DD/YYYY', 'MMM-DD', 'MMM D', 'MMMM D, YYYY', 'MMM D, YYYY'\r\n      ], true);\r\n      return parsed.isValid() ? parsed : null;\r\n    },\r\n    onCellInput(rowIndex, cellIndex) {\r\n      // Called on input event for a cell\r\n      if (!this.cellTimestamps) this.cellTimestamps = [];\r\n      if (!this.cellTimestamps[rowIndex]) this.cellTimestamps[rowIndex] = [];\r\n      this.cellTimestamps[rowIndex][cellIndex] = Date.now();\r\n    },\r\n    getNextNonEmptyDate(row, startIdx) {\r\n      for (let i = startIdx + 1; i < row.length; i++) {\r\n        const d = this.parseDate(row[i]);\r\n        if (d) return row[i];\r\n      }\r\n      return null;\r\n    },\r\n    getCellStatus(currentValue, nextValue, rowIndex, cellIndex) {\r\n      // Use next non-empty cell for status\r\n      const row = this.data[rowIndex];\r\n      const nextNonEmpty = this.getNextNonEmptyDate(row, cellIndex);\r\n      const from = this.parseDate(currentValue);\r\n      const to = this.parseDate(nextNonEmpty) || dayjs();\r\n      if (!from) return { text: '—', color: 'gray', progress: 0 };\r\n      let diff, dur, human, isDone, isDelayed, progress, color;\r\n      if (!nextNonEmpty) {\r\n        // Next step is empty, so use edit timestamp if available\r\n        let ts = this.cellTimestamps?.[rowIndex]?.[cellIndex];\r\n        if (ts) {\r\n          diff = Date.now() - ts;\r\n          dur = dayjs.duration(diff);\r\n          human = `${dur.days()}d ${dur.hours()}h ${dur.minutes()}m`;\r\n          isDone = false;\r\n          isDelayed = diff > 86400000; // 1 day\r\n          progress = Math.min(diff / 86400000, 1);\r\n          if (!isDelayed) color = 'blue';\r\n          else color = 'red';\r\n        } else {\r\n          diff = dayjs().diff(from);\r\n          dur = dayjs.duration(diff);\r\n          human = `${dur.days()}d ${dur.hours()}h ${dur.minutes()}m`;\r\n          isDone = false;\r\n          isDelayed = diff > 86400000; // 1 day\r\n          progress = Math.min(diff / 86400000, 1);\r\n          if (!isDelayed) color = 'blue';\r\n          else color = 'red';\r\n        }\r\n      } else {\r\n        diff = to.diff(from);\r\n        dur = dayjs.duration(diff);\r\n        human = `${dur.days()}d ${dur.hours()}h ${dur.minutes()}m`;\r\n        isDone = !!nextNonEmpty && this.parseDate(nextNonEmpty)?.isValid();\r\n        isDelayed = diff > 86400000; // 1 day\r\n        progress = Math.min(diff / 86400000, 1)