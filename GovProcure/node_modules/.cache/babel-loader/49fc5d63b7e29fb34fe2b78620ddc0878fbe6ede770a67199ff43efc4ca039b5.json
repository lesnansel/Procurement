{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { ref } from \"vue\";\nimport { useRouter } from \"vue-router\";\nimport { db } from \"@/firebase\";\nimport { collection, addDoc } from \"firebase/firestore\";\nexport default {\n  setup() {\n    const router = useRouter();\n    const contractTitle = ref(\"\");\n    const contractorName = ref(\"\");\n    const contractAmount = ref(\"\");\n    const startDate = ref(\"\");\n    const endDate = ref(\"\");\n    const contractDescription = ref(\"\");\n    const submitContract = async () => {\n      try {\n        const contractData = {\n          supplier: contractorName.value,\n          // maps contractor name\n          poNumber: contractTitle.value,\n          // maps contract title as PO number\n          value: parseFloat(contractAmount.value),\n          startDate: startDate.value,\n          endDate: endDate.value,\n          description: contractDescription.value,\n          status: \"Pending\",\n          // default status\n          createdAt: new Date()\n        };\n        await addDoc(collection(db, \"contracts\"), contractData);\n        alert(\"Contract added successfully!\");\n        router.push(\"/contract-management\");\n      } catch (error) {\n        console.error(\"Error adding contract:\", error);\n        alert(\"Failed to add contract. Please try again.\");\n      }\n    };\n    const goBack = () => {\n      router.back();\n    };\n    return {\n      contractTitle,\n      contractorName,\n      contractAmount,\n      startDate,\n      endDate,\n      contractDescription,\n      submitContract,\n      goBack\n    };\n  }\n};","map":{"version":3,"names":["ref","useRouter","db","collection","addDoc","setup","router","contractTitle","contractorName","contractAmount","startDate","endDate","contractDescription","submitContract","contractData","supplier","value","poNumber","parseFloat","description","status","createdAt","Date","alert","push","error","console","goBack","back"],"sources":["C:\\laragon\\www\\Capstone\\Connected to github\\Procurement\\GovProcure\\src\\components\\AddContract.vue"],"sourcesContent":["<template>\r\n  <div class=\"admin-wrapper\">\r\n    <!-- Background Pattern -->\r\n    <div class=\"background-pattern\">\r\n      <div class=\"pattern-overlay\"></div>\r\n    </div>\r\n\r\n    <!-- Admin Card -->\r\n    <div class=\"admin-card\">\r\n      <div class=\"card-header\">\r\n        <div class=\"header-content\">\r\n          <div class=\"logo-container\">\r\n            <img src=\"@/assets/proculogo.png\" alt=\"Procurement System Logo\" class=\"logo\" />\r\n          </div>\r\n          <div class=\"header-text align-left\">\r\n            <h1 class=\"title\">Add Contract</h1>\r\n            <p class=\"subtitle\">Record a new contract for a procurement process</p>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"card-content\">\r\n        <form @submit.prevent=\"submitContract\">\r\n          <!-- Contract Details -->\r\n          <div class=\"form-group\">\r\n            <label for=\"contractTitle\" class=\"form-label\">Contract Title</label>\r\n            <input\r\n              id=\"contractTitle\"\r\n              v-model=\"contractTitle\"\r\n              type=\"text\"\r\n              class=\"input-field\"\r\n              placeholder=\"Enter contract title\"\r\n              required\r\n            />\r\n          </div>\r\n\r\n          <div class=\"form-group\">\r\n            <label for=\"contractorName\" class=\"form-label\">Contractor Name</label>\r\n            <input\r\n              id=\"contractorName\"\r\n              v-model=\"contractorName\"\r\n              type=\"text\"\r\n              class=\"input-field\"\r\n              placeholder=\"Enter contractor name\"\r\n              required\r\n            />\r\n          </div>\r\n\r\n          <div class=\"form-group\">\r\n            <label for=\"contractAmount\" class=\"form-label\">Contract Amount</label>\r\n            <input\r\n              id=\"contractAmount\"\r\n              v-model=\"contractAmount\"\r\n              type=\"number\"\r\n              class=\"input-field\"\r\n              placeholder=\"Enter contract amount\"\r\n              required\r\n            />\r\n          </div>\r\n\r\n          <div class=\"form-group\">\r\n            <label for=\"startDate\" class=\"form-label\">Start Date</label>\r\n            <input\r\n              id=\"startDate\"\r\n              v-model=\"startDate\"\r\n              type=\"date\"\r\n              class=\"input-field\"\r\n              required\r\n            />\r\n          </div>\r\n\r\n          <div class=\"form-group\">\r\n            <label for=\"endDate\" class=\"form-label\">End Date</label>\r\n            <input\r\n              id=\"endDate\"\r\n              v-model=\"endDate\"\r\n              type=\"date\"\r\n              class=\"input-field\"\r\n              required\r\n            />\r\n          </div>\r\n\r\n          <div class=\"form-group\">\r\n            <label for=\"contractDescription\" class=\"form-label\">Description</label>\r\n            <textarea\r\n              id=\"contractDescription\"\r\n              v-model=\"contractDescription\"\r\n              class=\"input-field textarea\"\r\n              placeholder=\"Add a description for the contract (optional)\"\r\n            ></textarea>\r\n          </div>\r\n\r\n          <!-- Action Buttons -->\r\n          <div class=\"action-buttons\">\r\n            <button type=\"button\" @click=\"goBack\" class=\"btn-back\">\r\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"15 18 9 12 15 6\"></polyline></svg>\r\n              Back\r\n            </button>\r\n            <button type=\"submit\" class=\"btn-submit\">\r\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6 9 17l-5-5\"></path></svg>\r\n              Submit Contract\r\n            </button>\r\n          </div>\r\n        </form>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref } from \"vue\";\r\nimport { useRouter } from \"vue-router\";\r\nimport { db } from \"@/firebase\";\r\nimport { collection, addDoc } from \"firebase/firestore\";\r\n\r\nexport default {\r\n  setup() {\r\n    const router = useRouter();\r\n    const contractTitle = ref(\"\");\r\n    const contractorName = ref(\"\");\r\n    const contractAmount = ref(\"\");\r\n    const startDate = ref(\"\");\r\n    const endDate = ref(\"\");\r\n    const contractDescription = ref(\"\");\r\n\r\n    const submitContract = async () => {\r\n      try {\r\n        const contractData = {\r\n          supplier: contractorName.value, // maps contractor name\r\n          poNumber: contractTitle.value, // maps contract title as PO number\r\n          value: parseFloat(contractAmount.value),\r\n          startDate: startDate.value,\r\n          endDate: endDate.value,\r\n          description: contractDescription.value,\r\n          status: \"Pending\", // default status\r\n          createdAt: new Date(),\r\n        };\r\n\r\n        await addDoc(collection(db, \"contracts\"), contractData);\r\n        alert(\"Contract added successfully!\");\r\n        router.push(\"/contract-management\");\r\n      } catch (error) {\r\n        console.error(\"Error adding contract:\", error);\r\n        alert(\"Failed to add contract. Please try again.\");\r\n      }\r\n    };\r\n\r\n    const goBack = () => {\r\n      router.back();\r\n    };\r\n\r\n    return {\r\n      contractTitle,\r\n      contractorName,\r\n      contractAmount,\r\n      startDate,\r\n      endDate,\r\n      contractDescription,\r\n      submitContract,\r\n      goBack,\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* Admin Wrapper */\r\n.admin-wrapper {\r\n  min-height: 100vh;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 20px;\r\n  position: relative;\r\n  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;\r\n}\r\n\r\n/* Background Pattern */\r\n.background-pattern {\r\n  position: fixed;\r\n  inset: 0;\r\n  background-color: #1a1a2e;\r\n  z-index: -1;\r\n  overflow: hidden;\r\n}\r\n\r\n.pattern-overlay {\r\n  position: absolute;\r\n  inset: 0;\r\n  background-image: \r\n    linear-gradient(30deg, rgba(16, 42, 66, 0.5) 12%, transparent 12.5%, transparent 87%, rgba(16, 42, 66, 0.5) 87.5%, rgba(16, 42, 66, 0.5)),\r\n    linear-gradient(150deg, rgba(16, 42, 66, 0.5) 12%, transparent 12.5%, transparent 87%, rgba(16, 42, 66, 0.5) 87.5%, rgba(16, 42, 66, 0.5)),\r\n    linear-gradient(30deg, rgba(16, 42, 66, 0.5) 12%, transparent 12.5%, transparent 87%, rgba(16, 42, 66, 0.5) 87.5%, rgba(16, 42, 66, 0.5)),\r\n    linear-gradient(150deg, rgba(16, 42, 66, 0.5) 12%, transparent 12.5%, transparent 87%, rgba(16, 42, 66, 0.5) 87.5%, rgba(16, 42, 66, 0.5)),\r\n    linear-gradient(60deg, rgba(0, 0, 0, 0.1) 25%, transparent 25.5%, transparent 75%, rgba(0, 0, 0, 0.1) 75%, rgba(0, 0, 0, 0.1)),\r\n    linear-gradient(60deg, rgba(0, 0, 0, 0.1) 25%, transparent 25.5%, transparent 75%, rgba(0, 0, 0, 0.1) 75%, rgba(0, 0, 0, 0.1));\r\n  background-size: 80px 140px;\r\n  background-position: 0 0, 0 0, 40px 70px, 40px 70px, 0 0, 40px 70px;\r\n  opacity: 0.2;\r\n}\r\n\r\n/* Admin Card */\r\n.admin-card {\r\n  width: 100%;\r\n  max-width: 600px;\r\n  background-color: #fff;\r\n  border-radius: 12px;\r\n  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);\r\n  overflow: hidden;\r\n}\r\n\r\n.card-header {\r\n  background: linear-gradient(135deg, #0f2942 0%, #102a42 100%);\r\n  padding: 30px;\r\n  color: white;\r\n  text-align: center;\r\n}\r\n\r\n.logo-containe