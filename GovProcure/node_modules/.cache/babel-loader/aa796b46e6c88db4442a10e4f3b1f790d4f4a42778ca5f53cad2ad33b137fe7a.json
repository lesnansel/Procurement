querySelector(\".main-content\");\r\n    if (mainContent) {\r\n      mainContent.classList.toggle(\"collapsed\", !this.sidebarVisible);\r\n    }\r\n\r\n    document.addEventListener('keydown', (e) => {\r\n      if (e.ctrlKey && e.key === 'b') {\r\n        e.preventDefault();\r\n        this.toggleSidebar();\r\n      }\r\n    });\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.sidebar {\r\n  display: flex;\r\n  flex-direction: column;\r\n  width: 280px;\r\n  height: 100vh;\r\n  background-color: #0c2340;\r\n  color: white;\r\n  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;\r\n  position: fixed;\r\n  left: 0;\r\n  top: 0;\r\n  bottom: 0;\r\n  z-index: 100;\r\n  box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);\r\n  transition: transform 0.3s ease, box-shadow 0.3s ease;\r\n}\r\n\r\n.sidebar-hidden {\r\n  transform: translateX(-100%);\r\n  box-shadow: none;\r\n}\r\n\r\n.sidebar-toggle-btn {\r\n  position: fixed;\r\n  top: 15px;\r\n  left: 15px;\r\n  z-index: 101;\r\n  width: 40px;\r\n  height: 40px;\r\n  border-radius: 50%;\r\n  background-color: #9acd32; /* Yellow-green color */\r\n  color: white;\r\n  border: none;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  cursor: pointer;\r\n  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);\r\n  transition: left 0.3s ease, background-color 0.2s;\r\n}\r\n\r\n.sidebar-toggle-btn:hover {\r\n  background-color: #7fbf2e; /* Slightly darker yellow-green on hover */\r\n}\r\n\r\n.sidebar-toggle-btn.sidebar-hidden {\r\n  left: 15px;\r\n}\r\n\r\n.sidebar-header {\r\n  padding: 20px;\r\n  border-bottom: 1px solid rgba(255, 255, 255, 0.1);\r\n}\r\n\r\n.sidebar-logo {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n}\r\n\r\n.logo-circle {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 40px;\r\n  height: 40px;\r\n  border-radius: 50%;\r\n  background-color: transparent;\r\n  border: 2px solid #4a9fff;\r\n  color: #4a9fff;\r\n}\r\n\r\n.logo-icon {\r\n  width: 20px;\r\n  height: 20px;\r\n}\r\n\r\n.sidebar-logo-text {\r\n  font-size: 22px;\r\n  font-weight: 600;\r\n  color: white;\r\n}\r\n\r\n.sidebar-user {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  padding: 20px;\r\n  border-bottom: 1px solid rgba(255, 255, 255, 0.1);\r\n  background-color: #0a1c30;\r\n}\r\n\r\n.sidebar-user-avatar {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 45px;\r\n  height: 45px;\r\n  border-radius: 50%;\r\n  background-color: #1e3a5c;\r\n  color: white;\r\n  border: 1px solid rgba(255, 255, 255, 0.2);\r\n}\r\n\r\n.user-initials {\r\n  font-size: 18px;\r\n  font-weight: 500;\r\n}\r\n\r\n.sidebar-user-info {\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.sidebar-user-name {\r\n  font-size: 16px;\r\n  font-weight: 500;\r\n}\r\n\r\n.sidebar-user-role {\r\n  font-size: 13px;\r\n  color: rgba(255, 255, 255, 0.7);\r\n  margin-top: 2px;\r\n}\r\n\r\n.sidebar-nav {\r\n  flex: 1;\r\n  overflow-y: auto;\r\n  padding: 10px 0;\r\n}\r\n\r\n.sidebar-menu {\r\n  list-style: none;\r\n  padding: 0;\r\n  margin: 0;\r\n}\r\n\r\n.sidebar-menu-item {\r\n  margin: 2px 0;\r\n}\r\n\r\n.sidebar-menu-link {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  padding: 12px 20px;\r\n  color: white;\r\n  text-decoration: none;\r\n  transition: background-color 0.2s;\r\n}\r\n\r\n.sidebar-menu-link:hover {\r\n  background-color: rgba(255, 255, 255, 0.05);\r\n}\r\n\r\n.sidebar-menu-link.active {\r\n  background-color: rgba(255, 255, 255, 0.1);\r\n  border-left: 3px solid #4a9fff;\r\n}\r\n\r\n.sidebar-menu-link svg {\r\n  min-width: 20px;\r\n  color: rgba(255, 255, 255, 0.8);\r\n}\r\n\r\n.sidebar-footer {\r\n  padding: 20px;\r\n  border-top: 1px solid rgba(255, 255, 255, 0.1);\r\n}\r\n\r\n.sidebar-logout-btn {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  width: 100%;\r\n  padding: 12px;\r\n  background-color: rgba(255, 255, 255, 0.1);\r\n  border: none;\r\n  border-radius: 6px;\r\n  color: white;\r\n  font-size: 16px;\r\n  cursor: pointer;\r\n  transition: background-color 0.2s;\r\n}\r\n\r\n.sidebar-logout-btn:hover {\r\n  background-color: rgba(255, 255, 255, 0.15);\r\n}\r\n\r\n.sidebar-logout-btn svg {\r\n  min-width: 20px;\r\n}\r\n\r\n/* Custom scrollbar for the sidebar */\r\n.sidebar-nav::-webkit-scrollbar {\r\n  width: 6px;\r\n}\r\n\r\n.sidebar-nav::-webkit-scrollbar-track {\r\n  background: transparent;\r\n}\r\n\r\n.sidebar-nav::-webkit-scrollbar-thumb {\r\n  background-color: rgba(255, 255, 255, 0.2);\r\n  border-radius: 3px;\r\n}\r\n\r\n.sidebar-nav::-webkit-scrollbar-thumb:hover {\r\n  background-color: rgba(255, 255, 255, 0.3);\r\n}\r\n\r\n/* Add margin to the main content to accommodate the sidebar */\r\n:deep(main) {\r\n  margin-left: 280px;\r\n  transition: margin-left 0.3s ease;\r\n}\r\n\r\n:deep(body.sidebar-hidden main) {\r\n  margin-left: 0;\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .sidebar {\r\n    width: 260px;\r\n  }\r\n  \r\n  :deep(main) {\r\n    margin-left: 0;\r\n  }\r\n  \r\n  .sidebar-toggle-btn {\r\n    left: 10px;\r\n  }\r\n}\r\n</style>"],"mappings":";AA2HA,eAAe;EACbA,IAAI,EAAE,oBAAoB;EAC1BC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,aAAa,EAAE,iCAAiC;MAChDC,cAAc,EAAE;IAClB,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACPC,YAAYA,CAAA,EAAG;MACb;MACAC,YAAY,CAACC,UAAU,CAAC,WAAW,CAAC;MACpCD,YAAY,CAACC,UAAU,CAAC,UAAU,CAAC;;MAEnC;MACA,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC,QAAQ,CAAC;IAC7B,CAAC;IACDC,aAAaA,CAAA,EAAG;MACd,IAAI,CAACP,cAAa,GAAI,CAAC,IAAI,CAACA,cAAc;MAC1C,IAAI,CAACQ,KAAK,CAAC,gBAAgB,EAAE,IAAI,CAACR,cAAc,CAAC;MACjDG,YAAY,CAACM,OAAO,CAAC,gBAAgB,EAAE,IAAI,CAACT,cAAc,CAAC;;MAE3D;MACA,MAAMU,WAAU,GAAIC,QAAQ,CAACC,aAAa,CAAC,eAAe,CAAC;MAC3D,IAAIF,WAAW,EAAE;QACfA,WAAW,CAACG,SAAS,CAACC,MAAM,CAAC,WAAW,EAAE,CAAC,IAAI,CAACd,cAAc,CAAC;MACjE;IACF;EACF,CAAC;EACDe,OAAOA,CAAA,EAAG;IACR,MAAMC,UAAS,GAAIb,YAAY,CAACc,OAAO,CAAC,gBAAgB,CAAC;IACzD,IAAID,UAA