{"ast":null,"code":"import \"core-js/modules/esnext.iterator.constructor.js\";\nimport \"core-js/modules/esnext.iterator.filter.js\";\nimport * as XLSX from \"xlsx\";\nimport { ref, uploadBytes } from \"firebase/storage\";\nimport { storage } from \"@/firebase\";\nimport dayjs from \"dayjs\";\nexport default {\n  name: \"RecordsManagement\",\n  data() {\n    return {\n      headers: [],\n      data: [],\n      delays: []\n    };\n  },\n  methods: {\n    importExcel(event) {\n      const file = event.target.files[0];\n      const reader = new FileReader();\n      reader.onload = e => {\n        const workbook = XLSX.read(e.target.result, {\n          type: \"binary\"\n        });\n        const sheetName = workbook.SheetNames[0];\n        const sheet = workbook.Sheets[sheetName];\n        const jsonData = XLSX.utils.sheet_to_json(sheet, {\n          header: 1\n        });\n        this.headers = jsonData[0];\n        this.data = jsonData.slice(1);\n      };\n      reader.readAsBinaryString(file);\n    },\n    exportExcel() {\n      const worksheet = XLSX.utils.aoa_to_sheet([this.headers, ...this.data]);\n      const workbook = XLSX.utils.book_new();\n      XLSX.utils.book_append_sheet(workbook, worksheet, \"Sheet1\");\n      XLSX.writeFile(workbook, \"exported_data.xlsx\");\n    },\n    detectDelays() {\n      const today = dayjs();\n      this.delays = this.data.filter(row => {\n        const dateIndex = this.headers.indexOf(\"Date\");\n        if (dateIndex !== -1) {\n          const date = dayjs(row[dateIndex]);\n          return today.diff(date, \"day\") > 10;\n        }\n        return false;\n      });\n      console.log(\"Delays Detected:\", this.delays);\n    },\n    async saveToFirestore() {\n      const file = new Blob([JSON.stringify({\n        headers: this.headers,\n        data: this.data\n      })], {\n        type: \"application/json\"\n      });\n      const storageRef = ref(storage, `excel-files/records_${Date.now()}.json`);\n      try {\n        await uploadBytes(storageRef, file);\n        alert(\"File saved to Firestore successfully!\");\n      } catch (error) {\n        console.error(\"Error saving file to Firestore:\", error);\n      }\n    }\n  }\n};","map":{"version":3,"names":["XLSX","ref","uploadBytes","storage","dayjs","name","data","headers","delays","methods","importExcel","event","file","target","files","reader","FileReader","onload","e","workbook","read","result","type","sheetName","SheetNames","sheet","Sheets","jsonData","utils","sheet_to_json","header","slice","readAsBinaryString","exportExcel","worksheet","aoa_to_sheet","book_new","book_append_sheet","writeFile","detectDelays","today","filter","row","dateIndex","indexOf","date","diff","console","log","saveToFirestore","Blob","JSON","stringify","storageRef","Date","now","alert","error"],"sources":["C:\\laragon\\www\\Capstone\\Connected to github\\Procurement\\GovProcure\\src\\components\\Records.vue"],"sourcesContent":["<template>\r\n  <div class=\"records-container\">\r\n    <h1>Records Management</h1>\r\n    <div class=\"actions\">\r\n      <input type=\"file\" @change=\"importExcel\" accept=\".xlsx, .xls\" />\r\n      <button @click=\"exportExcel\">Export Excel</button>\r\n      <button @click=\"detectDelays\">Detect Delays</button>\r\n    </div>\r\n    <table>\r\n      <thead>\r\n        <tr>\r\n          <th v-for=\"header in headers\" :key=\"header\">{{ header }}</th>\r\n        </tr>\r\n      </thead>\r\n      <tbody>\r\n        <tr v-for=\"(row, rowIndex) in data\" :key=\"rowIndex\">\r\n          <td v-for=\"(cell, cellIndex) in row\" :key=\"cellIndex\">\r\n            <input v-model=\"data[rowIndex][cellIndex]\" />\r\n          </td>\r\n        </tr>\r\n      </tbody>\r\n    </table>\r\n    <p v-if=\"delays.length\">Delays Detected: {{ delays.length }}</p>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport * as XLSX from \"xlsx\";\r\nimport { ref, uploadBytes } from \"firebase/storage\";\r\nimport { storage } from \"@/firebase\";\r\nimport dayjs from \"dayjs\";\r\n\r\nexport default {\r\n  name: \"RecordsManagement\",\r\n  data() {\r\n    return {\r\n      headers: [],\r\n      data: [],\r\n      delays: [],\r\n    };\r\n  },\r\n  methods: {\r\n    importExcel(event) {\r\n      const file = event.target.files[0];\r\n      const reader = new FileReader();\r\n      reader.onload = (e) => {\r\n        const workbook = XLSX.read(e.target.result, { type: \"binary\" });\r\n        const sheetName = workbook.SheetNames[0];\r\n        const sheet = workbook.Sheets[sheetName];\r\n        const jsonData = XLSX.utils.sheet_to_json(sheet, { header: 1 });\r\n        this.headers = jsonData[0];\r\n        this.data = jsonData.slice(1);\r\n      };\r\n      reader.readAsBinaryString(file);\r\n    },\r\n    exportExcel() {\r\n      const worksheet = XLSX.utils.aoa_to_sheet([this.headers, ...this.data]);\r\n      const workbook = XLSX.utils.book_new();\r\n      XLSX.utils.book_append_sheet(workbook, worksheet, \"Sheet1\");\r\n      XLSX.writeFile(workbook, \"exported_data.xlsx\");\r\n    },\r\n    detectDelays() {\r\n      const today = dayjs();\r\n      this.delays = this.data.filter((row) => {\r\n        const dateIndex = this.headers.indexOf(\"Date\");\r\n        if (dateIndex !== -1) {\r\n          const date = dayjs(row[dateIndex]);\r\n          return today.diff(date, \"day\") > 10;\r\n        }\r\n        return false;\r\n      });\r\n      console.log(\"Delays Detected:\", this.delays);\r\n    },\r\n    async saveToFirestore() {\r\n      const file = new Blob([JSON.stringify({ headers: this.headers, data: this.data })], {\r\n        type: \"application/json\",\r\n      });\r\n      const storageRef = ref(storage, `excel-files/records_${Date.now()}.json`);\r\n      try {\r\n        await uploadBytes(storageRef, file);\r\n        alert(\"File saved to Firestore successfully!\");\r\n      } catch (error) {\r\n        console.error(\"Error saving file to Firestore:\", error);\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.records-container {\r\n  padding: 20px;\r\n  font-family: Arial, sans-serif;\r\n}\r\n.actions {\r\n  margin-bottom: 20px;\r\n}\r\ntable {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n}\r\nth, td {\r\n  border: 1px solid #ddd;\r\n  padding: 8px;\r\n}\r\nth {\r\n  background-color: #f4f4f4;\r\n}\r\n</style>"],"mappings":";;AA2BA,OAAO,KAAKA,IAAG,MAAO,MAAM;AAC5B,SAASC,GAAG,EAAEC,WAAU,QAAS,kBAAkB;AACnD,SAASC,OAAM,QAAS,YAAY;AACpC,OAAOC,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAI,EAAE,mBAAmB;EACzBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,OAAO,EAAE,EAAE;MACXD,IAAI,EAAE,EAAE;MACRE,MAAM,EAAE;IACV,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACPC,WAAWA,CAACC,KAAK,EAAE;MACjB,MAAMC,IAAG,GAAID,KAAK,CAACE,MAAM,CAACC,KAAK,CAAC,CAAC,CAAC;MAClC,MAAMC,MAAK,GAAI,IAAIC,UAAU,CAAC,CAAC;MAC/BD,MAAM,CAACE,MAAK,GAAKC,CAAC,IAAK;QACrB,MAAMC,QAAO,GAAInB,IAAI,CAACoB,IAAI,CAACF,CAAC,CAACL,MAAM,CAACQ,MAAM,EAAE;UAAEC,IAAI,EAAE;QAAS,CAAC,CAAC;QAC/D,MAAMC,SAAQ,GAAIJ,QAAQ,CAACK,UAAU,CAAC,CAAC,CAAC;QACxC,MAAMC,KAAI,GAAIN,QAAQ,CAACO,MAAM,CAACH,SAAS,CAAC;QACxC,MAAMI,QAAO,GAAI3B,IAAI,CAAC4B,KAAK,CAACC,aAAa,CAACJ,KAAK,EAAE;UAAEK,MAAM,EAAE;QAAE,CAAC,CAAC;QAC/D,IAAI,CAACvB,OAAM,GAAIoB,QAAQ,CAAC,CAAC,CAAC;QAC1B,IAAI,CAACrB,IAAG,GAAIqB,QAAQ,CAACI,KAAK,CAAC,CAAC,CAAC;MAC/B,CAAC;MACDhB,MAAM,CAACiB,kBAAkB,CAACpB,IAAI,CAAC;IACjC,CAAC;IACDqB,WAAWA,CAAA,EAAG;MACZ,MAAMC,SAAQ,GAAIlC,IAAI,CAAC4B,KAAK,CAACO,YAAY,CAAC,CAAC,IAAI,CAAC5B,OAAO,EAAE,GAAG,IAAI,CAACD,IAAI,CAAC,CAAC;MACvE,MAAMa,QAAO,GAAInB,IAAI,CAAC4B,KAAK,CAACQ,QAAQ,CAAC,CAAC;MACtCpC,IAAI,CAAC4B,KAAK,CAACS,iBAAiB,CAAClB,QAAQ,EAAEe,SAAS,EAAE,QAAQ,CAAC;MAC3DlC,IAAI,CAACsC,SAAS,CAACnB,QAAQ,EAAE,oBAAoB,CAAC;IAChD,CAAC;IACDoB,YAAYA,CAAA,EAAG;MACb,MAAMC,KAAI,GAAIpC,KAAK,CAAC,CAAC;MACrB,IAAI,CAACI,MAAK,GAAI,IAAI,CAACF,IAAI,CAACmC,MAAM,CAAEC,GAAG,IAAK;QACtC,MAAMC,SAAQ,GAAI,IAAI,CAACpC,OAAO,CAACqC,OAAO,CAAC,MAAM,CAAC;QAC9C,IAAID,SAAQ,KAAM,CAAC,CAAC,EAAE;UACpB,MAAME,IAAG,GAAIzC,KAAK,CAACsC,GAAG,CAACC,SAAS,CAAC,CAAC;UAClC,OAAOH,KAAK,CAACM,IAAI,CAACD