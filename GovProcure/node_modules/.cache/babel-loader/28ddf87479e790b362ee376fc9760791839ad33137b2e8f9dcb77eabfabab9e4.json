{"ast":null,"code":"import \"core-js/modules/esnext.iterator.map.js\";\nimport { ref, onMounted, computed } from \"vue\";\nimport { db, auth } from \"@/firebase\";\nimport { collection, query, where, getDocs } from \"firebase/firestore\";\nexport default {\n  name: \"UserPurchaseRequests\",\n  setup() {\n    const loading = ref(true);\n    const errorMessage = ref(\"\");\n    const userRequests = ref([]);\n    const formatDate = timestamp => {\n      if (!timestamp) return \"N/A\";\n      try {\n        const date = timestamp.toDate ? timestamp.toDate() : new Date(timestamp);\n        return date.toLocaleDateString(\"en-US\", {\n          year: \"numeric\",\n          month: \"short\",\n          day: \"numeric\"\n        });\n      } catch {\n        return \"N/A\";\n      }\n    };\n    const statusClass = status => {\n      if (!status) return '';\n      const s = status.toLowerCase();\n      if (s === 'approved') return 'status-approved';\n      if (s === 'rejected' || s === 'declined') return 'status-rejected';\n      if (s === 'pending') return 'status-pending';\n      return 'status-default';\n    };\n    onMounted(async () => {\n      loading.value = true;\n      try {\n        const currentUser = auth.currentUser;\n        if (!currentUser) {\n          errorMessage.value = \"You must be logged in to view your requests.\";\n          loading.value = false;\n          return;\n        }\n        const prQuery = query(collection(db, \"purchaseRequests\"), where(\"userId\", \"==\", currentUser.uid));\n        const querySnapshot = await getDocs(prQuery);\n        userRequests.value = querySnapshot.docs.map(doc => ({\n          requestId: doc.id,\n          ...doc.data()\n        }));\n      } catch (error) {\n        errorMessage.value = \"Error loading your requests: \" + error.message;\n      } finally {\n        loading.value = false;\n      }\n    });\n    return {\n      loading,\n      errorMessage,\n      userRequests,\n      formatDate,\n      statusClass\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","computed","db","auth","collection","query","where","getDocs","name","setup","loading","errorMessage","userRequests","formatDate","timestamp","date","toDate","Date","toLocaleDateString","year","month","day","statusClass","status","s","toLowerCase","value","currentUser","prQuery","uid","querySnapshot","docs","map","doc","requestId","id","data","error","message"],"sources":["C:\\laragon\\www\\Capstone\\Connected to github\\Procurement\\GovProcure\\src\\components\\UserPurchaseRequests.vue"],"sourcesContent":["<template>\r\n  <div class=\"user-pr-wrapper\">\r\n    <div class=\"user-pr-header\">\r\n      <img src=\"@/assets/proculogo.png\" alt=\"Procurement System Logo\" class=\"logo\" />\r\n      <div class=\"header-text\">\r\n        <h1 class=\"title\">My Purchase Requests</h1>\r\n        <p class=\"subtitle\">View all purchase requests you have submitted.</p>\r\n      </div>\r\n    </div>\r\n    <div class=\"user-pr-content\">\r\n      <div v-if=\"loading\" class=\"loading-state\">\r\n        <div class=\"spinner\"></div>\r\n        <p>Loading your purchase requests...</p>\r\n      </div>\r\n      <div v-else-if=\"errorMessage\" class=\"error-container\">\r\n        <div class=\"error-box\">\r\n          <p>{{ errorMessage }}</p>\r\n        </div>\r\n      </div>\r\n      <div v-else>\r\n        <div v-if=\"userRequests.length === 0\" class=\"no-requests\">\r\n          <p>You have not submitted any purchase requests yet.</p>\r\n        </div>\r\n        <div v-else class=\"pr-list\">\r\n          <div v-for=\"request in userRequests\" :key=\"request.requestId\" class=\"pr-card\">\r\n            <div class=\"pr-info\">\r\n              <div><strong>Item:</strong> {{ request.itemName }}</div>\r\n              <div><strong>Quantity:</strong> {{ request.quantity }}</div>\r\n              <div><strong>Status:</strong> <span :class=\"statusClass(request.status)\">{{ request.status }}</span></div>\r\n              <div><strong>Submitted:</strong> {{ formatDate(request.createdAt) }}</div>\r\n            </div>\r\n            <router-link :to=\"`/request-detail/${request.requestId}`\" class=\"view-link\">View Details</router-link>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted, computed } from \"vue\";\r\nimport { db, auth } from \"@/firebase\";\r\nimport { collection, query, where, getDocs } from \"firebase/firestore\";\r\n\r\nexport default {\r\n  name: \"UserPurchaseRequests\",\r\n  setup() {\r\n    const loading = ref(true);\r\n    const errorMessage = ref(\"\");\r\n    const userRequests = ref([]);\r\n\r\n    const formatDate = (timestamp) => {\r\n      if (!timestamp) return \"N/A\";\r\n      try {\r\n        const date = timestamp.toDate ? timestamp.toDate() : new Date(timestamp);\r\n        return date.toLocaleDateString(\"en-US\", {\r\n          year: \"numeric\",\r\n          month: \"short\",\r\n          day: \"numeric\",\r\n        });\r\n      } catch {\r\n        return \"N/A\";\r\n      }\r\n    };\r\n\r\n    const statusClass = (status) => {\r\n      if (!status) return '';\r\n      const s = status.toLowerCase();\r\n      if (s === 'approved') return 'status-approved';\r\n      if (s === 'rejected' || s === 'declined') return 'status-rejected';\r\n      if (s === 'pending') return 'status-pending';\r\n      return 'status-default';\r\n    };\r\n\r\n    onMounted(async () => {\r\n      loading.value = true;\r\n      try {\r\n        const currentUser = auth.currentUser;\r\n        if (!currentUser) {\r\n          errorMessage.value = \"You must be logged in to view your requests.\";\r\n          loading.value = false;\r\n          return;\r\n        }\r\n        const prQuery = query(\r\n          collection(db, \"purchaseRequests\"),\r\n          where(\"userId\", \"==\", currentUser.uid)\r\n        );\r\n        const querySnapshot = await getDocs(prQuery);\r\n        userRequests.value = querySnapshot.docs.map(doc => ({ requestId: doc.id, ...doc.data() }));\r\n      } catch (error) {\r\n        errorMessage.value = \"Error loading your requests: \" + error.message;\r\n      } finally {\r\n        loading.value = false;\r\n      }\r\n    });\r\n\r\n    return {\r\n      loading,\r\n      errorMessage,\r\n      userRequests,\r\n      formatDate,\r\n      statusClass\r\n    };\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.user-pr-wrapper {\r\n  max-width: 900px;\r\n  margin: 40px auto;\r\n  background: #fff;\r\n  border-radius: 16px;\r\n  box-shadow: 0 10px 30px rgba(0,0,0,0.12);\r\n  padding: 32px;\r\n}\r\n.user-pr-header {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 20px;\r\n  margin-bottom: 32px;\r\n}\r\n.logo {\r\n  width: 60px;\r\n  height: 60px;\r\n  object-fit: contain;\r\n}\r\n.header-text {\r\n  flex: 1;\r\n}\r\n.title {\r\n  font-size: 2rem;\r\n  font-weight: 700;\r\n  margin-bottom: 8px;\r\n}\r\n.subtitle {\r\n  font-size: 1rem;\r\n  color: #64748b;\r\n}\r\n.user-pr-content {\r\n  min-height: 200px;\r\n}\r\n.loading-state {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  color: #64748b;\r\n}\r\n.spinner {\r\n  width: 40px;\r\n  height: 40px;\r\n  border: 3px solid #e2e8f0;\r\n  border-radius: 50%;\r\n  border-top-color: #0f2942;\r\n  animation: spin 1s linear infinite;\r\n  margin-bottom: 16px;\r\n}\r\n@keyframes spin {\r\n  to { transform: rotate(360deg); }\r\n}\r\n.error-container {\r\n  display: flex;\r\n  justify-content: center;\r\n  padding: 24px 0;\r\n}\r\n.error-box {\r\n  background: #fee2e2;\r\n  color: #b91c1c;\r\n  padding: 18px;\r\n  border-radius: 8px;\r\n}\r\n.no-requests {\r\n  text-align: center;\r\n  color: #64748b;\r\n  padding: 32px 0;\r\n}\r\n.pr-list {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 18px;\r\n}\r\n.pr-card {\r\n  background: #f8fafc;\r\n  border-radius: 10px;\r\n  padding: 18px 24px;\r\n  box-shadow: 0 2px 8px rgba(0,0,0,0.04);\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n}\r\n.pr-info {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n}\r\n.status-approved {\r\n  color: #166534;\r\n  font-weight: 600;\r\n}\r\n.status-rejected {\r\n  color: #b91c1c;\r\n  font-weight: 600;\r\n}\r\n.status-pending {\r\n  color: #92400e;\r\n  font-weight: 600;\r\n}\r\n.status-default {\r\n  color: #64748b;\r\n  font-weight: 600;\r\n}\r\n.view-link {\r\n  color: #0f2942;\r\n  font-weight: 600;\r\n  text-decoration: underline;\r\n  transition: color 0.2s;\r\n}\r\n.view-link:hover {\r\n  color: #166534;\r\n}\r\n</style>\r\n"],"mappings":";AAwCA,SAASA,GAAG,EAAEC,SAAS,EAAEC,QAAO,QAAS,KAAK;AAC9C,SAASC,EAAE,EAAEC,IAAG,QAAS,YAAY;AACrC,SAASC,UAAU,EAAEC,KAAK,EAAEC,KAAK,EAAEC,OAAM,QAAS,oBAAoB;AAEtE,eAAe;EACbC,IAAI,EAAE,sBAAsB;EAC5BC,KAAKA,CAAA,EAAG;IACN,MAAMC,OAAM,GAAIX,GAAG,CAAC,IAAI,CAAC;IACzB,MAAMY,YAAW,GAAIZ,GAAG,CAAC,EAAE,CAAC;IAC5B,MAAMa,YAAW,GAAIb,GAAG,CAAC,EAAE,CAAC;IAE5B,MAAMc,UAAS,GAAKC,SAAS,IAAK;MAChC,IAAI,CAACA,SAAS,EAAE,OAAO,KAAK;MAC5B,IAAI;QACF,MAAMC,IAAG,GAAID,SAAS,CAACE,MAAK,GAAIF,SAAS,CAACE,MAAM,CAAC,IAAI,IAAIC,IAAI,CAACH,SAAS,CAAC;QACxE,OAAOC,IAAI,CAACG,kBAAkB,CAAC,OAAO,EAAE;UACtCC,IAAI,EAAE,SAAS;UACfC,KAAK,EAAE,OAAO;UACdC,GAAG,EAAE;QACP,CAAC,CAAC;MACJ,EAAE,MAAM;QACN,OAAO,KAAK;MACd;IACF,CAAC;IAED,MAAMC,WAAU,GAAKC,MAAM,IAAK;MAC9B,IAAI,CAACA,MAAM,EAAE,OAAO,EAAE;MACtB,MAAMC,CAAA,GAAID,MAAM,CAACE,WAAW,CAAC,CAAC;MAC9B,IAAID,CAAA,KAAM,UAAU,EAAE,OAAO,iBAAiB;MAC9C,IAAIA,CAAA,KAAM,UAAS,IAAKA,CAAA,KAAM,UAAU,EAAE,OAAO,iBAAiB;MAClE,IAAIA,CAAA,KAAM,SAAS,EAAE,OAAO,gBAAgB;MAC5C,OAAO,gBAAgB;IACzB,CAAC;IAEDxB,SAAS,CAAC,YAAY;MACpBU,OAAO,CAACgB,KAAI,GAAI,IAAI;MACpB,IAAI;QACF,MAAMC,WAAU,GAAIxB,IAAI,CAACwB,WAAW;QACpC,IAAI,CAACA,WAAW,EAAE;UAChBhB,YAAY,CAACe,KAAI,GAAI,8CAA8C;UACnEhB,OAAO,CAACgB,KAAI,GAAI,KAAK;UACrB;QACF;QACA,MAAME,OAAM,GAAIvB,KAAK,CACnBD,UAAU,CAACF,EAAE,EAAE,kBAAkB,CAAC,EAClCI,KAAK,CAAC,QAAQ,EAAE,IAAI,EAAEqB,WAAW,CAACE,GAAG,CACvC,CAAC;Q