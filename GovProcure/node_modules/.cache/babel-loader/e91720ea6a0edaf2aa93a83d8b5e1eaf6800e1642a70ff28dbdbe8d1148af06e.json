description","_hoisted_20","_hoisted_21","_hoisted_22","estimatedCost","step","_hoisted_23","requiredDate","minDate","_hoisted_24","_hoisted_25","_hoisted_26","justification","_hoisted_27","_hoisted_28","accept","onChange","e","file","target","files","fileError","_hoisted_29","_hoisted_30","onClick","resetForm","isSubmitting","_hoisted_32","_createTextVNode","_hoisted_31","notification","show","_normalizeClass","_hoisted_33","_hoisted_34","xmlns","width","height","viewBox","fill","stroke","d","points","_hoisted_35","cx","cy","r","x1","y1","x2","y2","message","closeNotification"],"sources":["C:\\laragon\\www\\Capstone\\Connected to github\\Procurement\\GovProcure\\src\\components\\PurchaseRequest.vue"],"sourcesContent":["<template>\r\n  <div class=\"flex min-h-screen bg-[#14263d]\">\r\n    <!-- Sidebar -->\r\n    <aside class=\"w-64 h-screen bg-[#14263d] text-white shadow-lg flex-shrink-0\">\r\n      <UserNavigationBar />\r\n    </aside>\r\n    <!-- Main Content -->\r\n    <div class=\"flex-1 min-h-screen bg-transparent\">\r\n      <div class=\"admin-wrapper\">\r\n        <!-- Background Pattern -->\r\n        <div class=\"background-pattern\">\r\n          <div class=\"pattern-overlay\"></div>\r\n        </div>\r\n\r\n        <!-- Admin Card -->\r\n        <div class=\"admin-card\">\r\n          <div class=\"card-header\">\r\n            <div class=\"logo-container\">\r\n              <img src=\"@/assets/proculogo.png\" alt=\"Procurement System Logo\" class=\"logo\" />\r\n            </div>\r\n            <h1 class=\"title\">Purchase Request</h1>\r\n            <p class=\"subtitle\">Submit and manage your purchase requests.</p>\r\n          </div>\r\n\r\n          <div class=\"card-content\">\r\n            <!-- Submit Purchase Request Form -->\r\n            <form @submit.prevent=\"submitRequest\" class=\"form\">\r\n              <div class=\"form-section\">\r\n                <h2 class=\"section-title\">Request Details</h2>\r\n                \r\n                <div class=\"form-row\">\r\n                  <div class=\"form-group\">\r\n                    <label class=\"form-label\" for=\"itemName\">Item Name</label>\r\n                    <input \r\n                      id=\"itemName\"\r\n                      v-model=\"newRequest.itemName\" \r\n                      type=\"text\" \r\n                      class=\"input-field\" \r\n                      placeholder=\"Enter item name\" \r\n                      required \r\n                    />\r\n                    <span v-if=\"validationErrors.itemName\" class=\"error-message\">{{ validationErrors.itemName }}</span>\r\n                  </div>\r\n                  <div class=\"form-group\">\r\n                    <label class=\"form-label\" for=\"quantity\">Quantity</label>\r\n                    <input \r\n                      id=\"quantity\"\r\n                      v-model.number=\"newRequest.quantity\" \r\n                      type=\"number\" \r\n                      min=\"1\"\r\n                      class=\"input-field\" \r\n                      placeholder=\"Enter quantity\" \r\n                      required \r\n                    />\r\n                    <span v-if=\"validationErrors.quantity\" class=\"error-message\">{{ validationErrors.quantity }}</span>\r\n                  </div>\r\n                </div>\r\n                \r\n                <div class=\"form-row\">\r\n                  <div class=\"form-group\">\r\n                    <label class=\"form-label\" for=\"category\">Category</label>\r\n                    <select \r\n                      id=\"category\"\r\n                      v-model=\"newRequest.category\" \r\n                      class=\"input-field\" \r\n                      required\r\n                    >\r\n                      <option value=\"\" disabled>Select a category</option>\r\n                      <option v-for=\"category in categories\" :key=\"category\" :value=\"category\">\r\n                        {{ category }}\r\n                      </option>\r\n                    </select>\r\n                    <span v-if=\"validationErrors.category\" class=\"error-message\">{{ validationErrors.category }}</span>\r\n                  </div>\r\n                  <div class=\"form-group\">\r\n                    <label class=\"form-label\" for=\"priority\">Priority</label>\r\n                    <select \r\n                      id=\"priority\"\r\n                      v-model=\"newRequest.priority\" \r\n                      class=\"input-field\" \r\n                      required\r\n                    >\r\n                      <option value=\"\" disabled>Select priority</option>\r\n                      <option value=\"low\">Low</option>\r\n                      <option value=\"medium\">Medium</option>\r\n                      <option value=\"high\">High</option>\r\n                      <option value=\"urgent\">Urgent</option>\r\n                    </select>\r\n                    <span v-if=\"validationErrors.priority\" class=\"error-message\">{{ validationErrors.priority }}</span>\r\n                  </div>\r\n                </div>\r\n                \r\n                <div class=\"form-group\">\r\n                  <label class=\"form-label\" for=\"description\">Description</label>\r\n                  <textarea \r\n                    id=\"description\"\r\n                    v-model=\"newRequest.description\" \r\n                    class=\"input-field textarea\" \r\n                    placeholder=\"Enter detailed description of the item(s)\" \r\n                    required\r\n                  ></textarea>\r\n                  <span v-if=\"validationErrors.description\" class=\"error-message\">{{ validationErrors.description }}</span>\r\n                </div>\r\n                \r\n                <div class=\"form-row\">\r\n                  <div class=\"form-group\">\r\n                    <label class=\"form-label\" for=\"estimatedCost\">Estimated Cost (₱)</label>\r\n                    <input \r\n                      id=\"estimatedCost\"\r\n                      v-model.number=\"newRequest.estimatedCost\" \r\n                      type=\"number\" \r\n                      min=\"0\" \r\n                      step=\"0.01\"\r\n                      class=\"input-field\" \r\n                      placeholder=\"Enter estimated cost\" \r\n                    />\r\n                  </div>\r\n                  <div class=\"form-group\">\r\n                    <label class=\"form-label\" for=\"requiredDate\">Required By</label>\r\n                    <input \r\n                      id=\"requiredDate\"\r\n                      v-model=\"newRequest.requiredDate\" \r\n                      type=\"date\" \r\n                      class=\"input-field\" \r\n                      :min=\"minDate\"\r\n                      required\r\n                    />\r\n                    <span v-if=\"validationErrors.requiredDate\" class=\"error-message\">{{ validationErrors.requiredDate }}</span>\r\n                  </div>\r\n                </div>\r\n                \r\n                <div class=\"form-group\">\r\n                  <label class=\"form-label\" for=\"justification\">Justification</label>\r\n                  <textarea \r\n                    id=\"justification\"\r\n                    v-model=\"newRequest.justification\" \r\n                    class=\"input-field textarea\" \r\n                    placeholder=\"Explain why this purchase is necessary\" \r\n                    required\r\n                  ></textarea>\r\n                  <span v-if=\"validationErrors.justification\" class=\"error-message\">{{ validationErrors.justification }}</span>\r\n                </div>\r\n\r\n                <!-- File Upload Section -->\r\n                <div class=\"form-group\">\r\n                  <label class=\"form-label\" for=\"prDocument\">PR Document (PDF)</label>\r\n                  <input \r\n                    id=\"prDocument\"\r\n                    type=\"file\"\r\n                    accept=\"application/pdf\"\r\n                    class=\"input-field\"\r\n                    @change=\"e => file = e.target.files[0]\"\r\n                    required\r\n                  />\r\n                  <span v-if=\"fileError\" class=\"error-message\">{{ fileError }}</span>\r\n                </div>\r\n              </div>\r\n              \r\n              <div class=\"form-actions\">\r\n                <button type=\"button\" class=\"btn-secondary\" @click=\"resetForm\">Reset</button>\r\n                <button \r\n                  type=\"submit\" \r\n                  class=\"btn-primary\" \r\n                  :disabled=\"isSubmitting\"\r\n                >\r\n                  <span v-if=\"isSubmitting\" class=\"spinner\"></span>\r\n                  {{ isSubmitting ? 'Submitting...' : 'Submit Request' }}\r\n                </button>\r\n              </div>\r\n            </form>\r\n            \r\n            <!-- Success/Error Notification -->\r\n            <div v-if=\"notification.show\" :class=\"['notification', notification.type]\">\r\n              <div class=\"notification-content\">\r\n                <span v-if=\"notification.type === 'success'\" class=\"notification-icon success\">\r\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path><polyline points=\"22 4 12 14.01 9 11.01\"></polyline></svg>\r\n                </span>\r\n                <span v-else class=\"notification-icon error\">\r\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><line