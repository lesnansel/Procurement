urrentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a2 2 0 01-2 2H7a2 2 0 01-2-2V7a2 2 0 012-2h4a2 2 0 012 2v1\" /></svg><span v-if=\"sidebarOpen\">Log Out</span></span>\r\n        </button>\r\n      </div>\r\n    </aside>\r\n    <!-- Floating Toggle Button (always visible when sidebar is closed) -->\r\n    <button v-if=\"!sidebarOpen\" @click=\"toggleSidebar\" class=\"fixed top-4 left-4 z-50 bg-[#22334a] rounded-full p-2 focus:outline-none focus:ring-2 focus:ring-blue-400 shadow-lg\">\r\n      <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-6 w-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 6h16M4 12h16M4 18h16\" /></svg>\r\n    </button>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  data() {\r\n    return {\r\n      sidebarOpen: true,\r\n    };\r\n  },\r\n  methods: {\r\n    toggleSidebar() {\r\n      this.sidebarOpen = !this.sidebarOpen;\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.sidebar-link {\r\n  display: block;\r\n  padding: 0.75rem 1.5rem;\r\n  color: #e5e7eb;\r\n  border-radius: 0.375rem;\r\n  margin-bottom: 0.25rem;\r\n  font-size: 1rem;\r\n  transition: background 0.2s, color 0.2s;\r\n}\r\n.sidebar-link.active,\r\n.sidebar-link.router-link-exact-active {\r\n  background: #1e3350;\r\n  color: #fff;\r\n}\r\n.sidebar-link:hover {\r\n  background: #22334a;\r\n  color: #fff;\r\n}\r\n.sidebar-link-collapsed {\r\n  justify-content: center;\r\n  text-align: center;\r\n  padding-left: 0.5rem;\r\n  padding-right: 0.5rem;\r\n}\r\n.sidebar-action-btn {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: flex-start;\r\n  padding: 0.75rem 1.5rem;\r\n  background: #1e3350;\r\n  color: #e5e7eb;\r\n  border-radius: 0.375rem;\r\n  font-size: 1rem;\r\n  transition: background 0.2s, color 0.2s;\r\n  border: none;\r\n  cursor: pointer;\r\n}\r\n.