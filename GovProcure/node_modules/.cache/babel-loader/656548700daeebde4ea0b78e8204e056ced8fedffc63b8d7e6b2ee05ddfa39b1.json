{"ast":null,"code":"import \"core-js/modules/esnext.iterator.map.js\";\nimport { ref, onMounted } from \"vue\";\nimport { db } from \"@/firebase\";\nimport { collection, addDoc, getDocs } from \"firebase/firestore\";\nexport default {\n  setup() {\n    const bids = ref([]);\n    const newBid = ref({\n      amount: 0,\n      description: \"\"\n    });\n    const fetchBids = async () => {\n      try {\n        const querySnapshot = await getDocs(collection(db, \"bids\"));\n        bids.value = querySnapshot.docs.map(doc => ({\n          id: doc.id,\n          ...doc.data()\n        }));\n      } catch (error) {\n        console.error(\"Error fetching bids:\", error);\n        alert(\"Failed to fetch bids. Please try again.\");\n      }\n    };\n    const submitBid = async () => {\n      try {\n        await addDoc(collection(db, \"bids\"), newBid.value);\n        alert(\"Bid submitted successfully!\");\n        newBid.value = {\n          amount: 0,\n          description: \"\"\n        };\n        fetchBids();\n      } catch (error) {\n        console.error(\"Error submitting bid:\", error);\n        alert(\"Failed to submit bid. Please try again.\");\n      }\n    };\n    const handleFileUpload = event => {\n      const file = event.target.files[0];\n      if (file) {\n        console.log(\"File uploaded:\", file.name);\n      }\n    };\n    onMounted(fetchBids);\n    return {\n      bids,\n      newBid,\n      submitBid,\n      handleFileUpload\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","db","collection","addDoc","getDocs","setup","bids","newBid","amount","description","fetchBids","querySnapshot","value","docs","map","doc","id","data","error","console","alert","submitBid","handleFileUpload","event","file","target","files","log","name"],"sources":["C:\\laragon\\www\\Capstone\\Connected to github\\Procurement\\GovProcure\\src\\components\\SubmitBid.vue"],"sourcesContent":["<template>\r\n  <div class=\"admin-wrapper\">\r\n    <!-- Background Pattern -->\r\n    <div class=\"background-pattern\">\r\n      <div class=\"pattern-overlay\"></div>\r\n    </div>\r\n\r\n    <!-- Admin Card -->\r\n    <div class=\"admin-card\">\r\n      <div class=\"card-header\">\r\n        <div class=\"logo-container\">\r\n          <img src=\"@/assets/proculogo.png\" alt=\"Procurement System Logo\" class=\"logo\" />\r\n        </div>\r\n        <h1 class=\"title\">Submit Bid</h1>\r\n        <p class=\"subtitle\">Submit your bid for the procurement process.</p>\r\n      </div>\r\n\r\n      <div class=\"card-content\">\r\n        <!-- Submit Bid Form -->\r\n        <form @submit.prevent=\"submitBid\" class=\"form\">\r\n          <div class=\"form-group\">\r\n            <label>Bid Amount</label>\r\n            <input v-model=\"newBid.amount\" type=\"number\" required />\r\n          </div>\r\n          <div class=\"form-group\">\r\n            <label>Bid Description</label>\r\n            <textarea v-model=\"newBid.description\" required></textarea>\r\n          </div>\r\n          <div class=\"form-group\">\r\n            <label>Upload Supporting Documents</label>\r\n            <input type=\"file\" @change=\"handleFileUpload\" />\r\n          </div>\r\n          <button type=\"submit\" class=\"btn-primary\">Submit Bid</button>\r\n        </form>\r\n\r\n        <!-- Submitted Bids List -->\r\n        <div v-if=\"bids.length\" class=\"table-container\">\r\n          <table class=\"bids-table\">\r\n            <thead>\r\n              <tr>\r\n                <th>Bid Amount</th>\r\n                <th>Description</th>\r\n                <th>Status</th>\r\n              </tr>\r\n            </thead>\r\n            <tbody>\r\n              <tr v-for=\"bid in bids\" :key=\"bid.id\">\r\n                <td>{{ bid.amount }}</td>\r\n                <td>{{ bid.description }}</td>\r\n                <td class=\"capitalize\">{{ bid.status }}</td>\r\n              </tr>\r\n            </tbody>\r\n          </table>\r\n        </div>\r\n        <p v-else class=\"loading-state\">No bids submitted yet.</p>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted } from \"vue\";\r\nimport { db } from \"@/firebase\";\r\nimport { collection, addDoc, getDocs } from \"firebase/firestore\";\r\n\r\nexport default {\r\n  setup() {\r\n    const bids = ref([]);\r\n    const newBid = ref({ amount: 0, description: \"\" });\r\n\r\n    const fetchBids = async () => {\r\n      try {\r\n        const querySnapshot = await getDocs(collection(db, \"bids\"));\r\n        bids.value = querySnapshot.docs.map((doc) => ({ id: doc.id, ...doc.data() }));\r\n      } catch (error) {\r\n        console.error(\"Error fetching bids:\", error);\r\n        alert(\"Failed to fetch bids. Please try again.\");\r\n      }\r\n    };\r\n\r\n    const submitBid = async () => {\r\n      try {\r\n        await addDoc(collection(db, \"bids\"), newBid.value);\r\n        alert(\"Bid submitted successfully!\");\r\n        newBid.value = { amount: 0, description: \"\" };\r\n        fetchBids();\r\n      } catch (error) {\r\n        console.error(\"Error submitting bid:\", error);\r\n        alert(\"Failed to submit bid. Please try again.\");\r\n      }\r\n    };\r\n\r\n    const handleFileUpload = (event) => {\r\n      const file = event.target.files[0];\r\n      if (file) {\r\n        console.log(\"File uploaded:\", file.name);\r\n      }\r\n    };\r\n\r\n    onMounted(fetchBids);\r\n\r\n    return {\r\n      bids,\r\n      newBid,\r\n      submitBid,\r\n      handleFileUpload,\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.admin-wrapper {\r\n  min-height: 100vh;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 20px;\r\n  position: relative;\r\n  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;\r\n}\r\n\r\n/* Background Pattern */\r\n.background-pattern {\r\n  position: fixed;\r\n  inset: 0;\r\n  background-color: #1a1a2e;\r\n  z-index: -1;\r\n  overflow: hidden;\r\n}\r\n\r\n.pattern-overlay {\r\n  position: absolute;\r\n  inset: 0;\r\n  background-image: \r\n    linear-gradient(30deg, rgba(16, 42, 66, 0.5) 12%, transparent 12.5%, transparent 87%, rgba(16, 42, 66, 0.5) 87.5%, rgba(16, 42, 66, 0.5)),\r\n    linear-gradient(150deg, rgba(16, 42, 66, 0.5) 12%, transparent 12.5%, transparent 87%, rgba(16, 42, 66, 0.5) 87.5%, rgba(16, 42, 66, 0.5)),\r\n    linear-gradient(60deg, rgba(0, 0, 0, 0.1) 25%, transparent 25.5%, transparent 75%, rgba(0, 0, 0, 0.1) 75%, rgba(0, 0, 0, 0.1));\r\n  background-size: 80px 140px;\r\n  background-position: 0 0, 0 0, 40px 70px, 40px 70px, 0 0, 40px 70px;\r\n  opacity: 0.2;\r\n}\r\n\r\n/* Card Design */\r\n.admin-card {\r\n  width: 100%;\r\n  max-width: 1200px;\r\n  background-color: #fff;\r\n  border-radius: 12px;\r\n  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);\r\n  overflow: hidden;\r\n  position: relative;\r\n}\r\n\r\n.card-header {\r\n  background: linear-gradient(135deg, #0f2942 0%, #102a42 100%);\r\n  padding: 30px;\r\n  text-align: center;\r\n  color: white;\r\n}\r\n\r\n.logo-container {\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.logo {\r\n  width: 70px;\r\n  height: 70px;\r\n  object-fit: contain;\r\n}\r\n\r\n.title {\r\n  font-size: 1.75rem;\r\n  font-weight: 700;\r\n  margin-bottom: 8px;\r\n}\r\n\r\n.subtitle {\r\n  font-size: 0.95rem;\r\n  opacity: 0.8;\r\n}\r\n\r\n.card-content {\r\n  padding: 30px;\r\n}\r\n\r\n/* Table Design */\r\n.table-container {\r\n  overflow-x: auto;\r\n}\r\n\r\n.bids-table {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n}\r\n\r\n.bids-table th,\r\n.bids-table td {\r\n  padding: 12px;\r\n  text-align: left;\r\n  border-bottom: 1px solid #e2e8f0;\r\n}\r\n\r\n.bids-table th {\r\n  background-color: #2b6cb0;\r\n  color: white;\r\n  font-weight: bold;\r\n  font-size: 14px;\r\n}\r\n\r\n.bids-table td {\r\n  color: #2d3748;\r\n  font-size: 14px;\r\n}\r\n\r\n.bids-table tr:hover td {\r\n  background-color: #ebf8ff;\r\n}\r\n\r\n.loading-state {\r\n  text-align: center;\r\n  color: #1a202c;\r\n  font-size: 16px;\r\n  font-weight: bold;\r\n}\r\n\r\n/* Buttons */\r\n.btn-primary {\r\n  background-color: #2563eb;\r\n  color: white;\r\n  padding: 0.5rem 1rem;\r\n  border-radius: 4px;\r\n  border: none;\r\n  cursor: pointer;\r\n}\r\n\r\n.btn-primary:hover {\r\n  background-color: #1d4ed8;\r\n}\r\n</style>\r\n"],"mappings":";AA6DA,SAASA,GAAG,EAAEC,SAAQ,QAAS,KAAK;AACpC,SAASC,EAAC,QAAS,YAAY;AAC/B,SAASC,UAAU,EAAEC,MAAM,EAAEC,OAAM,QAAS,oBAAoB;AAEhE,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN,MAAMC,IAAG,GAAIP,GAAG,CAAC,EAAE,CAAC;IACpB,MAAMQ,MAAK,GAAIR,GAAG,CAAC;MAAES,MAAM,EAAE,CAAC;MAAEC,WAAW,EAAE;IAAG,CAAC,CAAC;IAElD,MAAMC,SAAQ,GAAI,MAAAA,CAAA,KAAY;MAC5B,IAAI;QACF,MAAMC,aAAY,GAAI,MAAMP,OAAO,CAACF,UAAU,CAACD,EAAE,EAAE,MAAM,CAAC,CAAC;QAC3DK,IAAI,CAACM,KAAI,GAAID,aAAa,CAACE,IAAI,CAACC,GAAG,CAAEC,GAAG,KAAM;UAAEC,EAAE,EAAED,GAAG,CAACC,EAAE;UAAE,GAAGD,GAAG,CAACE,IAAI,CAAC;QAAE,CAAC,CAAC,CAAC;MAC/E,EAAE,OAAOC,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,sBAAsB,EAAEA,KAAK,CAAC;QAC5CE,KAAK,CAAC,yCAAyC,CAAC;MAClD;IACF,CAAC;IAED,MAAMC,SAAQ,GAAI,MAAAA,CAAA,KAAY;MAC5B,IAAI;QACF,MAAMlB,MAAM,CAACD,UAAU,CAACD,EAAE,EAAE,MAAM,CAAC,EAAEM,MAAM,CAACK,KAAK,CAAC;QAClDQ,KAAK,CAAC,6BAA6B,CAAC;QACpCb,MAAM,CAACK,KAAI,GAAI;UAAEJ,MAAM,EAAE,CAAC;UAAEC,WAAW,EAAE;QAAG,CAAC;QAC7CC,SAAS,CAAC,CAAC;MACb,EAAE,OAAOQ,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,uBAAuB,EAAEA,KAAK,CAAC;QAC7CE,KAAK,CAAC,yCAAyC,CAAC;MAClD;IACF,CAAC;IAED,MAAME,gBAAe,GAAKC,KAAK,IAAK;MAClC,MAAMC,IAAG,GAAID,KAAK,CAACE,MAAM,CAACC,KAAK,CAAC,CAAC,CAAC;MAClC,IAAIF,IAAI,EAAE;QACRL,OAAO,CAACQ,GAAG,CAAC,gBAAgB,EAAEH,IAAI,CAACI,IAAI,CAAC;MAC1C;IACF,CAAC;IAED5B,SAAS,CAACU,SAAS,CAAC;IAEpB,OAAO;MACLJ,IAAI;MACJC,MAAM;MACNc,SAAS;MACTC;IACF,CAAC;EACH;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}