{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { ref, onMounted } from \"vue\";\nimport { useRouter } from \"vue-router\";\nimport { getAuth } from \"firebase/auth\";\nimport { doc, getDoc, updateDoc } from \"firebase/firestore\";\nimport { ref as storageRef, uploadBytes, getDownloadURL } from \"firebase/storage\";\nimport { signInWithEmailAndPassword } from \"firebase/auth\";\nimport { db, storage } from \"../firebase\";\n\n// Form state\nconst defaultProfilePic = \"https://ui-avatars.com/api/?background=0F2942&color=fff\";\n\n// Load user data\n\nexport default {\n  __name: 'EditUserProfile',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const completeName = ref(\"\");\n    const age = ref(\"\");\n    const birthday = ref(\"\");\n    const cellphone = ref(\"\");\n    const gender = ref(\"\");\n    const address = ref(\"\");\n    const profileImageUrl = ref(\"\");\n    const previewUrl = ref(\"\");\n    const selectedFile = ref(null);\n    const fileInput = ref(null);\n\n    // UI state\n    const isLoading = ref(false);\n    const errorMessage = ref(\"\");\n    const successMessage = ref(\"\");\n    const uploadError = ref(\"\");\n    const showDeactivateModal = ref(false);\n    const password = ref(\"\");\n    const deactivateError = ref(\"\");\n    const router = useRouter();\n    const auth = getAuth();\n    onMounted(async () => {\n      const user = auth.currentUser;\n      if (!user) {\n        router.push(\"/login\");\n        return;\n      }\n      try {\n        const userRef = doc(db, \"users\", user.uid);\n        const userSnap = await getDoc(userRef);\n        if (userSnap.exists()) {\n          const data = userSnap.data();\n          completeName.value = data.completeName || \"\";\n          age.value = data.age || \"\";\n          birthday.value = data.birthday || \"\";\n          cellphone.value = data.cellphone || \"\";\n          gender.value = data.gender || \"\";\n          address.value = data.address || \"\";\n          profileImageUrl.value = data.profileImageUrl || \"\";\n        }\n      } catch (error) {\n        errorMessage.value = \"Failed to load profile data\";\n      }\n    });\n\n    // Profile picture handling\n    const triggerFileInput = () => {\n      fileInput.value.click();\n    };\n    const handleFileUpload = event => {\n      const file = event.target.files[0];\n      if (!file) return;\n      if (!file.type.startsWith('image/')) {\n        uploadError.value = \"Please select an image file\";\n        return;\n      }\n      if (file.size > 5 * 1024 * 1024) {\n        uploadError.value = \"Image size should be less than 5MB\";\n        return;\n      }\n      selectedFile.value = file;\n      previewUrl.value = URL.createObjectURL(file);\n      uploadError.value = \"\";\n    };\n    const updateProfileImage = async () => {\n      const user = auth.currentUser;\n      if (!user || !selectedFile.value) return;\n      isLoading.value = true;\n      uploadError.value = \"\";\n      try {\n        const fileRef = storageRef(storage, `profile_pictures/${user.uid}-${Date.now()}`);\n        await uploadBytes(fileRef, selectedFile.value);\n        const imageUrl = await getDownloadURL(fileRef);\n        const userRef = doc(db, \"users\", user.uid);\n        await updateDoc(userRef, {\n          profileImageUrl: imageUrl\n        });\n        profileImageUrl.value = imageUrl;\n        selectedFile.value = null;\n        successMessage.value = \"Profile picture updated successfully!\";\n      } catch (error) {\n        uploadError.value = \"Failed to upload profile picture\";\n      } finally {\n        isLoading.value = false;\n      }\n    };\n\n    // Profile info update\n    const updateProfileInfo = async () => {\n      const user = auth.currentUser;\n      if (!user) return;\n      isLoading.value = true;\n      errorMessage.value = \"\";\n      successMessage.value = \"\";\n      try {\n        const userRef = doc(db, \"users\", user.uid);\n        await updateDoc(userRef, {\n          completeName: completeName.value,\n          age: age.value,\n          birthday: birthday.value,\n          cellphone: cellphone.value,\n          gender: gender.value,\n          address: address.value\n        });\n        successMessage.value = \"Profile updated successfully!\";\n        setTimeout(() => {\n          router.push(\"/profile-display\");\n        }, 2000);\n      } catch (error) {\n        errorMessage.value = \"Failed to update profile\";\n      } finally {\n        isLoading.value = false;\n      }\n    };\n\n    // Account deactivation\n    const confirmDeactivation = async () => {\n      if (!password.value.trim()) {\n        deactivateError.value = \"Please enter your password\";\n        return;\n      }\n      isLoading.value = true;\n      deactivateError.value = \"\";\n      try {\n        const user = auth.currentUser;\n        await signInWithEmailAndPassword(auth, user.email, password.value);\n        const userRef = doc(db, \"users\", user.uid);\n        await updateDoc(userRef, {\n          status: \"deactivated\"\n        });\n        await auth.signOut();\n        router.push(\"/login\");\n      } catch (error) {\n        deactivateError.value = \"Incorrect password\";\n      } finally {\n        isLoading.value = false;\n      }\n    };\n    const closeModal = () => {\n      showDeactivateModal.value = false;\n      password.value = \"\";\n      deactivateError.value = \"\";\n    };\n    const __returned__ = {\n      completeName,\n      age,\n      birthday,\n      cellphone,\n      gender,\n      address,\n      profileImageUrl,\n      previewUrl,\n      selectedFile,\n      fileInput,\n      isLoading,\n      errorMessage,\n      successMessage,\n      uploadError,\n      showDeactivateModal,\n      password,\n      deactivateError,\n      router,\n      auth,\n      defaultProfilePic,\n      triggerFileInput,\n      handleFileUpload,\n      updateProfileImage,\n      updateProfileInfo,\n      confirmDeactivation,\n      closeModal,\n      ref,\n      onMounted,\n      get useRouter() {\n        return useRouter;\n      },\n      get getAuth() {\n        return getAuth;\n      },\n      get doc() {\n        return doc;\n      },\n      get getDoc() {\n        return getDoc;\n      },\n      get updateDoc() {\n        return updateDoc;\n      },\n      get storageRef() {\n        return storageRef;\n      },\n      get uploadBytes() {\n        return uploadBytes;\n      },\n      get getDownloadURL() {\n        return getDownloadURL;\n      },\n      get signInWithEmailAndPassword() {\n        return signInWithEmailAndPassword;\n      },\n      get db() {\n        return db;\n      },\n      get storage() {\n        return storage;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","onMounted","useRouter","getAuth","doc","getDoc","updateDoc","storageRef","uploadBytes","getDownloadURL","signInWithEmailAndPassword","db","storage","defaultProfilePic","completeName","age","birthday","cellphone","gender","address","profileImageUrl","previewUrl","selectedFile","fileInput","isLoading","errorMessage","successMessage","uploadError","showDeactivateModal","password","deactivateError","router","auth","user","currentUser","push","userRef","uid","userSnap","exists","data","value","error","triggerFileInput","click","handleFileUpload","event","file","target","files","type","startsWith","size","URL","createObjectURL","updateProfileImage","fileRef","Date","now","imageUrl","updateProfileInfo","setTimeout","confirmDeactivation","trim","email","status","signOut","closeModal"],"sources":["C:/laragon/www/Capstone/Connected to github/Procurement/GovProcure/src/components/EditUserProfile.vue"],"sourcesContent":["<template>\r\n  <div class=\"edit-profile-wrapper\">\r\n    <!-- Background Pattern -->\r\n    <div class=\"background-pattern\">\r\n      <div class=\"pattern-overlay\"></div>\r\n    </div>\r\n\r\n    <!-- Edit Profile Card -->\r\n    <div class=\"profile-card\">\r\n      <!-- Improved Section Header -->\r\n      <div class=\"profile-header\">\r\n        <img src=\"/placeholder.svg?height=60&width=60\" alt=\"Procurement System Logo\" class=\"logo\" />\r\n        <h2>Edit Profile</h2>\r\n        <p class=\"subtitle\">Update your personal information</p>\r\n      </div>\r\n\r\n      <div class=\"card-content\">\r\n        <!-- Avatar Enhancement -->\r\n        <div class=\"avatar-container\">\r\n          <div class=\"avatar-ring\">\r\n            <img \r\n              :src=\"previewUrl || profileImageUrl || defaultProfilePic\" \r\n              alt=\"Profile Picture\" \r\n              class=\"profile-img\"\r\n            />\r\n            <button class=\"edit-avatar\" @click=\"triggerFileInput\" title=\"Change Photo\">\r\n              ✏️\r\n            </button>\r\n          </div>\r\n          <input \r\n            type=\"file\" \r\n            ref=\"fileInput\"\r\n            @change=\"handleFileUpload\" \r\n            accept=\"image/*\"\r\n            class=\"hidden\"\r\n          />\r\n          <button \r\n            v-if=\"selectedFile\"\r\n            @click=\"updateProfileImage\" \r\n            :disabled=\"isLoading\"\r\n            class=\"upload-btn\"\r\n          >\r\n            <span v-if=\"!isLoading\">Upload New Picture</span>\r\n            <span v-else class=\"spinner\"></span>\r\n          </button>\r\n          <p v-if=\"uploadError\" class=\"error-message\">\r\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"error-icon\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><line x1=\"12\" x2=\"12\" y1=\"8\" y2=\"12\"/><line x1=\"12\" x2=\"12.01\" y1=\"16\" y2=\"16\"/></svg>\r\n            {{ uploadError }}\r\n          </p>\r\n        </div>\r\n\r\n        <!-- User Info Form -->\r\n        <form @submit.prevent=\"updateProfileInfo\" class=\"edit-form\">\r\n          <div class=\"form-grid\">\r\n            <div class=\"form-group\">\r\n              <label for=\"completeName\">Complete Name</label>\r\n              <input \r\n                type=\"text\" \r\n                id=\"completeName\"\r\n                v-model=\"completeName\" \r\n                required\r\n                autofocus\r\n              />\r\n            </div>\r\n\r\n            <div class=\"form-group\">\r\n              <label for=\"age\">Age</label>\r\n              <input \r\n                type=\"number\" \r\n                id=\"age\"\r\n                v-model=\"age\" \r\n                required\r\n                min=\"1\"\r\n              />\r\n            </div>\r\n\r\n            <div class=\"form-group\">\r\n              <label for=\"birthday\">\r\n                Birthday\r\n                <span class=\"tooltip\" title=\"Enter your date of birth\">(?)</span>\r\n              </label>\r\n              <input \r\n                type=\"date\" \r\n                id=\"birthday\"\r\n                v-model=\"birthday\" \r\n                required\r\n              />\r\n            </div>\r\n\r\n            <div class=\"form-group\">\r\n              <label for=\"cellphone\">Cellphone Number</label>\r\n              <input \r\n                type=\"tel\" \r\n                id=\"cellphone\"\r\n                v-model=\"cellphone\" \r\n                required\r\n              />\r\n            </div>\r\n\r\n            <div class=\"form-group\">\r\n              <label for=\"gender\">\r\n                Gender\r\n                <span class=\"tooltip\" title=\"Select your gender\">(?)</span>\r\n              </label>\r\n              <select \r\n                id=\"gender\"\r\n                v-model=\"gender\" \r\n                required\r\n              >\r\n                <option value=\"\" disabled>Select gender</option>\r\n                <option value=\"male\">Male</option>\r\n                <option value=\"female\">Female</option>\r\n                <option value=\"other\">Other</option>\r\n              </select>\r\n            </div>\r\n\r\n            <div class=\"form-group full-width\">\r\n              <label for=\"address\">Complete Address</label>\r\n              <input \r\n                type=\"text\" \r\n                id=\"address\"\r\n                v-model=\"address\" \r\n                required\r\n              />\r\n            </div>\r\n          </div>\r\n\r\n          <div class=\"button-row\">\r\n            <button \r\n              type=\"submit\" \r\n              class=\"save-btn\"\r\n              :disabled=\"isLoading\"\r\n            >\r\n              <span v-if=\"!isLoading\">Save Changes</span>\r\n              <span v-else class=\"spinner\"></span>\r\n            </button>\r\n\r\n            <button \r\n              type=\"button\"\r\n              class=\"cancel-btn\"\r\n              @click=\"$router.push('/profile-display')\"\r\n            >\r\n              Cancel\r\n            </button>\r\n\r\n            <button \r\n              type=\"button\"\r\n              class=\"deactivate-btn\"\r\n              @click=\"showDeactivateModal = true\"\r\n            >\r\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"user-slash-icon\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><line x1=\"17\" y1=\"4\" x2=\"7\" y2=\"20\"/></svg>\r\n              Deactivate Account\r\n            </button>\r\n          </div>\r\n\r\n          <div v-if=\"successMessage\" class=\"success-message\">\r\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"success-icon\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"/><polyline points=\"22 4 12 14.01 9 11.01\"/></svg>\r\n            {{ successMessage }}\r\n          </div>\r\n\r\n          <div v-if=\"errorMessage\" class=\"error-message\">\r\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"error-icon\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><line x1=\"12\" x2=\"12\" y1=\"8\" y2=\"12\"/><line x1=\"12\" x2=\"12.01\" y1=\"16\" y2=\"16\"/></svg>\r\n            {{ errorMessage }}\r\n          </div>\r\n        </form>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Deactivation Modal -->\r\n    <div v-if=\"showDeactivateModal\" class=\"modal-overlay\" @click=\"closeModal\">\r\n      <div class=\"modal-content\" @click.stop>\r\n        <div class=\"modal-header\">\r\n          <h3>\r\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"warning-icon\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z\"/><path d=\"M12 9v4\"/><path d=\"M12 17h.01\"/></svg>\r\n            Deactivate Account\r\n          </h3>\r\n          <button class=\"close-btn\" @click=\"closeModal\">\r\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"></line><line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"></line></svg>\r\n          </button>\r\n        </div>\r\n\r\n        <div class=\"modal-body\">\r\n          <p class=\"warning-text\">\r\n            This action cannot be undone. Please enter your password to confirm.\r\n          </p>\r\n\r\n          <div class=\"form-group\">\r\n            <label for=\"password\">Password</label>\r\n            <input \r\n              type=\"password\" \r\n              id=\"password\"\r\n              v-model=\"password\"\r\n              required\r\n            />\r\n          </div>\r\n\r\n          <p v-if=\"deactivateError\" class=\"error-message\">\r\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"error-icon\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><line x1=\"12\" x2=\"12\" y1=\"8\" y2=\"12\"/><line x1=\"12\" x2=\"12.01\" y1=\"16\" y2=\"16\"/></svg>\r\n            {{ deactivateError }}\r\n          </p>\r\n        </div>\r\n\r\n        <div class=\"modal-footer\">\r\n          <button class=\"cancel-btn\" @click=\"closeModal\">Cancel</button>\r\n          <button \r\n            class=\"confirm-btn\" \r\n            @click=\"confirmDeactivation\"\r\n            :disabled=\"isLoading\"\r\n          >\r\n            <span v-if=\"!isLoading\">Confirm Deactivation</span>\r\n            <span v-else class=\"spinner\"></span>\r\n          </button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, onMounted } from \"vue\";\r\nimport { useRouter } from \"vue-router\";\r\nimport { getAuth } from \"firebase/auth\";\r\nimport { doc, getDoc, updateDoc } from \"firebase/firestore\";\r\nimport { ref as storageRef, uploadBytes, getDownloadURL } from \"firebase/storage\";\r\nimport { signInWithEmailAndPassword } from \"firebase/auth\";\r\nimport { db, storage } from \"../firebase\";\r\n\r\n// Form state\r\nconst completeName = ref(\"\");\r\nconst age = ref(\"\");\r\nconst birthday = ref(\"\");\r\nconst cellphone = ref(\"\");\r\nconst gender = ref(\"\");\r\nconst address = ref(\"\");\r\nconst profileImageUrl = ref(\"\");\r\nconst previewUrl = ref(\"\");\r\nconst selectedFile = ref(null);\r\nconst fileInput = ref(null);\r\n\r\n// UI state\r\nconst isLoading = ref(false);\r\nconst errorMessage = ref(\"\");\r\nconst successMessage = ref(\"\");\r\nconst uploadError = ref(\"\");\r\nconst showDeactivateModal = ref(false);\r\nconst password = ref(\"\");\r\nconst deactivateError = ref(\"\");\r\n\r\nconst router = useRouter();\r\nconst auth = getAuth();\r\nconst defaultProfilePic = \"https://ui-avatars.com/api/?background=0F2942&color=fff\";\r\n\r\n// Load user data\r\nonMounted(async () => {\r\n  const user = auth.currentUser;\r\n  if (!user) {\r\n    router.push(\"/login\");\r\n    return;\r\n  }\r\n\r\n  try {\r\n    const userRef = doc(db, \"users\", user.uid);\r\n    const userSnap = await getDoc(userRef);\r\n\r\n    if (userSnap.exists()) {\r\n      const data = userSnap.data();\r\n      completeName.value = data.completeName || \"\";\r\n      age.value = data.age || \"\";\r\n      birthday.value = data.birthday || \"\";\r\n      cellphone.value = data.cellphone || \"\";\r\n      gender.value = data.gender || \"\";\r\n      address.value = data.address || \"\";\r\n      profileImageUrl.value = data.profileImageUrl || \"\";\r\n    }\r\n  } catch (error) {\r\n    errorMessage.value = \"Failed to load profile data\";\r\n  }\r\n});\r\n\r\n// Profile picture handling\r\nconst triggerFileInput = () => {\r\n  fileInput.value.click();\r\n};\r\n\r\nconst handleFileUpload = (event) => {\r\n  const file = event.target.files[0];\r\n  if (!file) return;\r\n\r\n  if (!file.type.startsWith('image/')) {\r\n    uploadError.value = \"Please select an image file\";\r\n    return;\r\n  }\r\n\r\n  if (file.size > 5 * 1024 * 1024) {\r\n    uploadError.value = \"Image size should be less than 5MB\";\r\n    return;\r\n  }\r\n\r\n  selectedFile.value = file;\r\n  previewUrl.value = URL.createObjectURL(file);\r\n  uploadError.value = \"\";\r\n};\r\n\r\nconst updateProfileImage = async () => {\r\n  const user = auth.currentUser;\r\n  if (!user || !selectedFile.value) return;\r\n\r\n  isLoading.value = true;\r\n  uploadError.value = \"\";\r\n\r\n  try {\r\n    const fileRef = storageRef(storage, `profile_pictures/${user.uid}-${Date.now()}`);\r\n    await uploadBytes(fileRef, selectedFile.value);\r\n    const imageUrl = await getDownloadURL(fileRef);\r\n\r\n    const userRef = doc(db, \"users\", user.uid);\r\n    await updateDoc(userRef, {\r\n      profileImageUrl: imageUrl,\r\n    });\r\n\r\n    profileImageUrl.value = imageUrl;\r\n    selectedFile.value = null;\r\n    successMessage.value = \"Profile picture updated successfully!\";\r\n  } catch (error) {\r\n    uploadError.value = \"Failed to upload profile picture\";\r\n  } finally {\r\n    isLoading.value = false;\r\n  }\r\n};\r\n\r\n// Profile info update\r\nconst updateProfileInfo = async () => {\r\n  const user = auth.currentUser;\r\n  if (!user) return;\r\n\r\n  isLoading.value = true;\r\n  errorMessage.value = \"\";\r\n  successMessage.value = \"\";\r\n\r\n  try {\r\n    const userRef = doc(db, \"users\", user.uid);\r\n    await updateDoc(userRef, {\r\n      completeName: completeName.value,\r\n      age: age.value,\r\n      birthday: birthday.value,\r\n      cellphone: cellphone.value,\r\n      gender: gender.value,\r\n      address: address.value,\r\n    });\r\n\r\n    successMessage.value = \"Profile updated successfully!\";\r\n    setTimeout(() => {\r\n      router.push(\"/profile-display\");\r\n    }, 2000);\r\n  } catch (error) {\r\n    errorMessage.value = \"Failed to update profile\";\r\n  } finally {\r\n    isLoading.value = false;\r\n  }\r\n};\r\n\r\n// Account deactivation\r\nconst confirmDeactivation = async () => {\r\n  if (!password.value.trim()) {\r\n    deactivateError.value = \"Please enter your password\";\r\n    return;\r\n  }\r\n\r\n  isLoading.value = true;\r\n  deactivateError.value = \"\";\r\n\r\n  try {\r\n    const user = auth.currentUser;\r\n    await signInWithEmailAndPassword(auth, user.email, password.value);\r\n\r\n    const userRef = doc(db, \"users\", user.uid);\r\n    await updateDoc(userRef, {\r\n      status: \"deactivated\",\r\n    });\r\n\r\n    await auth.signOut();\r\n    router.push(\"/login\");\r\n  } catch (error) {\r\n    deactivateError.value = \"Incorrect password\";\r\n  } finally {\r\n    isLoading.value = false;\r\n  }\r\n};\r\n\r\nconst closeModal = () => {\r\n  showDeactivateModal.value = false;\r\n  password.value = \"\";\r\n  deactivateError.value = \"\";\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.edit-profile-wrapper {\r\n  min-height: 100vh;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 20px;\r\n  position: relative;\r\n  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;\r\n  background: #112940;\r\n}\r\n\r\n/* Background Pattern */\r\n.background-pattern {\r\n  position: fixed;\r\n  inset: 0;\r\n  background-color: #112940;\r\n  z-index: -1;\r\n  overflow: hidden;\r\n}\r\n\r\n.pattern-overlay {\r\n  position: absolute;\r\n  inset: 0;\r\n  background-image: \r\n    linear-gradient(30deg, rgba(16, 42, 66, 0.5) 12%, transparent 12.5%, transparent 87%, rgba(16, 42, 66, 0.5) 87.5%, rgba(16, 42, 66, 0.5)),\r\n    linear-gradient(150deg, rgba(16, 42, 66, 0.5) 12%, transparent 12.5%, transparent 87%, rgba(16, 42, 66, 0.5) 87.5%, rgba(16, 42, 66, 0.5)),\r\n    linear-gradient(30deg, rgba(16, 42, 66, 0.5) 12%, transparent 12.5%, transparent 87%, rgba(16, 42, 66, 0.5) 87.5%, rgba(16, 42, 66, 0.5)),\r\n    linear-gradient(150deg, rgba(16, 42, 66, 0.5) 12%, transparent 12.5%, transparent 87%, rgba(16, 42, 66, 0.5) 87.5%, rgba(16, 42, 66, 0.5)),\r\n    linear-gradient(60deg, rgba(0, 0, 0, 0.1) 25%, transparent 25.5%, transparent 75%, rgba(0, 0, 0, 0.1) 75%, rgba(0, 0, 0, 0.1)),\r\n    linear-gradient(60deg, rgba(0, 0, 0, 0.1) 25%, transparent 25.5%, trans