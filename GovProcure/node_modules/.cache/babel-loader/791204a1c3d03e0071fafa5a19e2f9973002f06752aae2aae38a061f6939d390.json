{"ast":null,"code":"export default {\n  name: \"ProcurementStatusBar\",\n  props: {\n    currentStep: {\n      type: String,\n      required: true,\n      validator: val => [\"PR\", \"APP\", \"RFQ\", \"Evaluation\", \"Award\", \"NTP\"].includes(val)\n    },\n    statusHistory: {\n      type: Array,\n      default: () => []\n    }\n  },\n  computed: {\n    steps() {\n      return [\"PR\", \"APP\", \"RFQ\", \"Evaluation\", \"Award\", \"NTP\"];\n    },\n    currentStepIndex() {\n      return this.steps.indexOf(this.currentStep);\n    }\n  },\n  methods: {\n    formatDate(dateStr) {\n      if (!dateStr) return \"\";\n      const date = typeof dateStr === \"object\" && dateStr.toDate ? dateStr.toDate() : new Date(dateStr);\n      return date.toLocaleDateString(\"en-US\", {\n        year: \"numeric\",\n        month: \"short\",\n        day: \"numeric\"\n      });\n    }\n  }\n};","map":{"version":3,"names":["name","props","currentStep","type","String","required","validator","val","includes","statusHistory","Array","default","computed","steps","currentStepIndex","indexOf","methods","formatDate","dateStr","date","toDate","Date","toLocaleDateString","year","month","day"],"sources":["C:\\laragon\\www\\Capstone\\Connected to github\\Procurement\\GovProcure\\src\\components\\ProcurementStatusBar.vue"],"sourcesContent":["<template>\r\n  <div class=\"status-bar-container\" role=\"group\" aria-label=\"Procurement Status Tracker\">\r\n    <div class=\"status-bar\">\r\n      <div\r\n        v-for=\"(step, idx) in steps\"\r\n        :key=\"step\"\r\n        class=\"status-step\"\r\n        :class=\"{\r\n          active: idx <= currentStepIndex,\r\n          current: idx === currentStepIndex\r\n        }\"\r\n      >\r\n        <span class=\"step-label\">{{ step }}</span>\r\n        <span v-if=\"statusHistory && statusHistory[idx]\" class=\"step-date\">\r\n          ({{ formatDate(statusHistory[idx].updatedAt) }})\r\n        </span>\r\n        <span v-if=\"idx < steps.length - 1\" class=\"status-arrow\">→</span>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: \"ProcurementStatusBar\",\r\n  props: {\r\n    currentStep: {\r\n      type: String,\r\n      required: true,\r\n      validator: (val) => [\"PR\", \"APP\", \"RFQ\", \"Evaluation\", \"Award\", \"NTP\"].includes(val)\r\n    },\r\n    statusHistory: {\r\n      type: Array,\r\n      default: () => []\r\n    }\r\n  },\r\n  computed: {\r\n    steps() {\r\n      return [\"PR\", \"APP\", \"RFQ\", \"Evaluation\", \"Award\", \"NTP\"];\r\n    },\r\n    currentStepIndex() {\r\n      return this.steps.indexOf(this.currentStep);\r\n    }\r\n  },\r\n  methods: {\r\n    formatDate(dateStr) {\r\n      if (!dateStr) return \"\";\r\n      const date =\r\n        typeof dateStr === \"object\" && dateStr.toDate\r\n          ? dateStr.toDate()\r\n          : new Date(dateStr);\r\n      return date.toLocaleDateString(\"en-US\", {\r\n        year: \"numeric\",\r\n        month: \"short\",\r\n        day: \"numeric\"\r\n      });\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.status-bar-container {\r\n  overflow-x: auto;\r\n  padding-bottom: 10px;\r\n}\r\n\r\n.status-bar {\r\n  display: flex;\r\n  align-items: center;\r\n  flex-wrap: nowrap;\r\n  gap: 12px;\r\n  background: #f8fafc;\r\n  padding: 12px 18px;\r\n  border-radius: 12px;\r\n  box-shadow: 0 2px 8px rgba(16, 42, 66, 0.07);\r\n  min-width: max-content;\r\n}\r\n\r\n.status-step {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  padding: 8px 16px;\r\n  border-radius: 16px;\r\n  background: #e5eaf5;\r\n  color: #0f2942;\r\n  font-weight: 500;\r\n  font-size: 15px;\r\n  transition: background 0.2s, color 0.2s, transform 0.2s;\r\n  box-shadow: 0 1px 3px rgba(16, 42, 66, 0.04);\r\n  position: relative;\r\n}\r\n\r\n.status-step.active {\r\n  background: linear-gradient(135deg, #4a9fff 0%, #2563eb 100%);\r\n  color: #fff;\r\n  box-shadow: 0 2px 8px rgba(74, 159, 255, 0.12);\r\n}\r\n\r\n.status-step.current::before {\r\n  content: \"\";\r\n  position: absolute;\r\n  top: -6px;\r\n  right: -6px;\r\n  width: 10px;\r\n  height: 10px;\r\n  background: #38bdf8;\r\n  border-radius: 50%;\r\n  animation: pulse 1.4s infinite;\r\n}\r\n\r\n.step-label {\r\n  font-weight: 600;\r\n  letter-spacing: 0.5px;\r\n}\r\n\r\n.step-date {\r\n  font-size: 12px;\r\n  color: #d1d5db;\r\n  margin-left: 2px;\r\n}\r\n\r\n.status-arrow {\r\n  margin: 0 4px;\r\n  color: #94a3b8;\r\n  font-size: 18px;\r\n  font-weight: bold;\r\n}\r\n\r\n@keyframes pulse {\r\n  0% {\r\n    transform: scale(0.9);\r\n    opacity: 1;\r\n  }\r\n  70% {\r\n    transform: scale(1.3);\r\n    opacity: 0.5;\r\n  }\r\n  100% {\r\n    transform: scale(0.9);\r\n    opacity: 1;\r\n  }\r\n}\r\n\r\n@media (max-width: 600px) {\r\n  .status-bar {\r\n    flex-direction: column;\r\n    align-items: flex-start;\r\n    gap: 8px;\r\n    padding: 10px;\r\n  }\r\n\r\n  .status-step {\r\n    width: 100%;\r\n    justify-content: flex-start;\r\n    font-size: 14px;\r\n    padding: 8px 10px;\r\n  }\r\n\r\n  .status-arrow {\r\n    display: none;\r\n  }\r\n}\r\n</style>\r\n"],"mappings":"AAuBA,eAAe;EACbA,IAAI,EAAE,sBAAsB;EAC5BC,KAAK,EAAE;IACLC,WAAW,EAAE;MACXC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE,IAAI;MACdC,SAAS,EAAGC,GAAG,IAAK,CAAC,IAAI,EAAE,KAAK,EAAE,KAAK,EAAE,YAAY,EAAE,OAAO,EAAE,KAAK,CAAC,CAACC,QAAQ,CAACD,GAAG;IACrF,CAAC;IACDE,aAAa,EAAE;MACbN,IAAI,EAAEO,KAAK;MACXC,OAAO,EAAEA,CAAA,KAAM;IACjB;EACF,CAAC;EACDC,QAAQ,EAAE;IACRC,KAAKA,CAAA,EAAG;MACN,OAAO,CAAC,IAAI,EAAE,KAAK,EAAE,KAAK,EAAE,YAAY,EAAE,OAAO,EAAE,KAAK,CAAC;IAC3D,CAAC;IACDC,gBAAgBA,CAAA,EAAG;MACjB,OAAO,IAAI,CAACD,KAAK,CAACE,OAAO,CAAC,IAAI,CAACb,WAAW,CAAC;IAC7C;EACF,CAAC;EACDc,OAAO,EAAE;IACPC,UAAUA,CAACC,OAAO,EAAE;MAClB,IAAI,CAACA,OAAO,EAAE,OAAO,EAAE;MACvB,MAAMC,IAAG,GACP,OAAOD,OAAM,KAAM,QAAO,IAAKA,OAAO,CAACE,MAAK,GACxCF,OAAO,CAACE,MAAM,CAAC,IACf,IAAIC,IAAI,CAACH,OAAO,CAAC;MACvB,OAAOC,IAAI,CAACG,kBAAkB,CAAC,OAAO,EAAE;QACtCC,IAAI,EAAE,SAAS;QACfC,KAAK,EAAE,OAAO;QACdC