{"ast":null,"code":"import \"core-js/modules/esnext.iterator.map.js\";\nimport { ref, onMounted } from \"vue\";\nimport { db } from \"@/firebase\";\nimport { collection, getDocs, query, where } from \"firebase/firestore\";\nexport default {\n  setup() {\n    const approvedPurchases = ref([]);\n    const fetchApprovedPurchases = async () => {\n      try {\n        const q = query(collection(db, \"purchaseRequests\"), where(\"status\", \"==\", \"Approved\"));\n        const querySnapshot = await getDocs(q);\n        approvedPurchases.value = querySnapshot.docs.map(doc => ({\n          id: doc.id,\n          ...doc.data()\n        }));\n      } catch (error) {\n        console.error(\"Error fetching approved purchases:\", error);\n      }\n    };\n    const formatDate = date => {\n      return new Date(date).toLocaleDateString(\"en-US\", {\n        year: \"numeric\",\n        month: \"long\",\n        day: \"numeric\"\n      });\n    };\n    onMounted(fetchApprovedPurchases);\n    return {\n      approvedPurchases,\n      formatDate\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","db","collection","getDocs","query","where","setup","approvedPurchases","fetchApprovedPurchases","q","querySnapshot","value","docs","map","doc","id","data","error","console","formatDate","date","Date","toLocaleDateString","year","month","day"],"sources":["C:\\laragon\\www\\Capstone\\Connected to github\\Procurement\\GovProcure\\src\\components\\Approved_Purchases.vue"],"sourcesContent":["<template>\r\n  <div class=\"admin-wrapper\">\r\n    <!-- Background Pattern -->\r\n    <div class=\"background-pattern\">\r\n      <div class=\"pattern-overlay\"></div>\r\n    </div>\r\n\r\n    <!-- Admin Card -->\r\n    <div class=\"admin-card\">\r\n      <div class=\"card-header\">\r\n        <div class=\"logo-container\">\r\n          <img src=\"@/assets/proculogo.png\" alt=\"Procurement System Logo\" class=\"logo\" />\r\n        </div>\r\n        <h1 class=\"title\">Approved Purchases</h1>\r\n        <p class=\"subtitle\">View all approved purchase requests</p>\r\n      </div>\r\n\r\n      <div class=\"card-content\">\r\n        <!-- Loading State -->\r\n        <div v-if=\"approvedPurchases.length === 0\" class=\"loading-state\">\r\n          <p>No approved purchases available.</p>\r\n        </div>\r\n\r\n        <template v-else>\r\n          <!-- Approved Purchases Table -->\r\n          <div class=\"table-container\">\r\n            <table class=\"purchases-table\">\r\n              <thead>\r\n                <tr>\r\n                  <th>Request ID</th>\r\n                  <th>Item Name</th>\r\n                  <th>Quantity</th>\r\n                  <th>Approved By</th>\r\n                  <th>Date Approved</th>\r\n                </tr>\r\n              </thead>\r\n              <tbody>\r\n                <tr v-for=\"purchase in approvedPurchases\" :key=\"purchase.id\">\r\n                  <td>{{ purchase.requestId }}</td>\r\n                  <td>{{ purchase.itemName }}</td>\r\n                  <td>{{ purchase.quantity }}</td>\r\n                  <td>{{ purchase.approvedBy }}</td>\r\n                  <td>{{ formatDate(purchase.dateApproved) }}</td>\r\n                </tr>\r\n              </tbody>\r\n            </table>\r\n          </div>\r\n        </template>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted } from \"vue\";\r\nimport { db } from \"@/firebase\";\r\nimport { collection, getDocs, query, where } from \"firebase/firestore\";\r\n\r\nexport default {\r\n  setup() {\r\n    const approvedPurchases = ref([]);\r\n\r\n    const fetchApprovedPurchases = async () => {\r\n      try {\r\n        const q = query(\r\n          collection(db, \"purchaseRequests\"),\r\n          where(\"status\", \"==\", \"Approved\")\r\n        );\r\n        const querySnapshot = await getDocs(q);\r\n        approvedPurchases.value = querySnapshot.docs.map((doc) => ({ id: doc.id, ...doc.data() }));\r\n      } catch (error) {\r\n        console.error(\"Error fetching approved purchases:\", error);\r\n      }\r\n    };\r\n\r\n    const formatDate = (date) => {\r\n      return new Date(date).toLocaleDateString(\"en-US\", {\r\n        year: \"numeric\",\r\n        month: \"long\",\r\n        day: \"numeric\",\r\n      });\r\n    };\r\n\r\n    onMounted(fetchApprovedPurchases);\r\n\r\n    return {\r\n      approvedPurchases,\r\n      formatDate,\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.admin-wrapper {\r\n  min-height: 100vh;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 20px;\r\n  position: relative;\r\n  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;\r\n}\r\n\r\n/* Background Pattern */\r\n.background-pattern {\r\n  position: fixed;\r\n  inset: 0;\r\n  background-color: #1a1a2e;\r\n  z-index: -1;\r\n  overflow: hidden;\r\n}\r\n\r\n.pattern-overlay {\r\n  position: absolute;\r\n  inset: 0;\r\n  background-image: \r\n    linear-gradient(30deg, rgba(16, 42, 66, 0.5) 12%, transparent 12.5%, transparent 87%, rgba(16, 42, 66, 0.5) 87.5%, rgba(16, 42, 66, 0.5)),\r\n    linear-gradient(150deg, rgba(16, 42, 66, 0.5) 12%, transparent 12.5%, transparent 87%, rgba(16, 42, 66, 0.5) 87.5%, rgba(16, 42, 66, 0.5)),\r\n    linear-gradient(30deg, rgba(16, 42, 66, 0.5) 12%, transparent 12.5%, transparent 87%, rgba(16, 42, 66, 0.5) 87.5%, rgba(16, 42, 66, 0.5)),\r\n    linear-gradient(150deg, rgba(16, 42, 66, 0.5) 12%, transparent 12.5%, transparent 87%, rgba(16, 42, 66, 0.5) 87.5%, rgba(16, 42, 66, 0.5)),\r\n    linear-gradient(60deg, rgba(0, 0, 0, 0.1) 25%, transparent 25.5%, transparent 75%, rgba(0, 0, 0, 0.1) 75%, rgba(0, 0, 0, 0.1)),\r\n    linear-gradient(60deg, rgba(0, 0, 0, 0.1) 25%, transparent 25.5%, transparent 75%, rgba(0, 0, 0, 0.1) 75%, rgba(0, 0, 0, 0.1));\r\n  background-size: 80px 140px;\r\n  background-position: 0 0, 0 0, 40px 70px, 40px 70px, 0 0, 40px 70px;\r\n  opacity: 0.2;\r\n}\r\n\r\n/* Card Design */\r\n.admin-card {\r\n  width: 100%;\r\n  max-width: 1200px;\r\n  background-color: #fff;\r\n  border-radius: 12px;\r\n  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);\r\n  overflow: hidden;\r\n  position: relative;\r\n}\r\n\r\n.card-header {\r\n  background: linear-gradient(135deg, #0f2942 0%, #102a42 100%);\r\n  padding: 30px;\r\n  text-align: center;\r\n  color: white;\r\n}\r\n\r\n.logo-container {\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.logo {\r\n  width: 70px;\r\n  height: 70px;\r\n  object-fit: contain;\r\n}\r\n\r\n.title {\r\n  font-size: 1.75rem;\r\n  font-weight: 700;\r\n  margin-bottom: 8px;\r\n}\r\n\r\n.subtitle {\r\n  font-size: 0.95rem;\r\n  opacity: 0.8;\r\n}\r\n\r\n.card-content {\r\n  padding: 30px;\r\n}\r\n\r\n/* Table Design */\r\n.table-container {\r\n  overflow-x: auto;\r\n}\r\n\r\n.purchases-table {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n}\r\n\r\n.purchases-table th,\r\n.purchases-table td {\r\n  padding: 12px;\r\n  text-align: center;\r\n  border-bottom: 1px solid #e2e8f0;\r\n}\r\n\r\n.purchases-table th {\r\n  background-color: #2b6cb0;\r\n  color: white;\r\n  font-weight: bold;\r\n  font-size: 15px;\r\n}\r\n\r\n.purchases-table td {\r\n  color: #2d3748;\r\n  font-size: 14px;\r\n}\r\n\r\n.purchases-table tr:hover td {\r\n  background-color: #ebf8ff;\r\n}\r\n\r\n.loading-state {\r\n  text-align: center;\r\n  color: #1a202c;\r\n  font-size: 16px;\r\n  font-weight: bold;\r\n}\r\n</style>"],"mappings":";AAsDA,SAASA,GAAG,EAAEC,SAAQ,QAAS,KAAK;AACpC,SAASC,EAAC,QAAS,YAAY;AAC/B,SAASC,UAAU,EAAEC,OAAO,EAAEC,KAAK,EAAEC,KAAI,QAAS,oBAAoB;AAEtE,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN,MAAMC,iBAAgB,GAAIR,GAAG,CAAC,EAAE,CAAC;IAEjC,MAAMS,sBAAqB,GAAI,MAAAA,CAAA,KAAY;MACzC,IAAI;QACF,MAAMC,CAAA,GAAIL,KAAK,CACbF,UAAU,CAACD,EAAE,EAAE,kBAAkB,CAAC,EAClCI,KAAK,CAAC,QAAQ,EAAE,IAAI,EAAE,UAAU,CAClC,CAAC;QACD,MAAMK,aAAY,GAAI,MAAMP,OAAO,CAACM,CAAC,CAAC;QACtCF,iBAAiB,CAACI,KAAI,GAAID,aAAa,CAACE,IAAI,CAACC,GAAG,CAAEC,GAAG,KAAM;UAAEC,EAAE,EAAED,GAAG,C