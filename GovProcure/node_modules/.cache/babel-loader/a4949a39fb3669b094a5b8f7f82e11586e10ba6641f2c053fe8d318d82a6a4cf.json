{"ast":null,"code":"import \"core-js/modules/esnext.iterator.map.js\";\nimport { ref, onMounted } from \"vue\";\nimport { db } from \"@/firebase\";\nimport { collection, addDoc, getDocs } from \"firebase/firestore\"; // Removed unused imports\n\nexport default {\n  setup() {\n    const contracts = ref([]);\n    const newContract = ref({\n      supplier: \"\",\n      poNumber: \"\",\n      status: \"Pending\"\n    });\n    const fetchContracts = async () => {\n      const querySnapshot = await getDocs(collection(db, \"contracts\"));\n      contracts.value = querySnapshot.docs.map(doc => ({\n        id: doc.id,\n        ...doc.data()\n      }));\n    };\n    const addContract = async () => {\n      try {\n        await addDoc(collection(db, \"contracts\"), newContract.value);\n        alert(\"Contract added successfully\");\n        newContract.value = {\n          supplier: \"\",\n          poNumber: \"\",\n          status: \"Pending\"\n        };\n        fetchContracts();\n      } catch (error) {\n        console.error(\"Error adding contract:\", error);\n        alert(\"Failed to add contract. Please try again.\");\n      }\n    };\n    onMounted(fetchContracts);\n    return {\n      contracts,\n      newContract,\n      addContract\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","db","collection","addDoc","getDocs","setup","contracts","newContract","supplier","poNumber","status","fetchContracts","querySnapshot","value","docs","map","doc","id","data","addContract","alert","error","console"],"sources":["C:\\laragon\\www\\Capstone\\Connected to github\\Procurement\\GovProcure\\src\\components\\ContractManagement.vue"],"sourcesContent":["<template>\r\n  <div class=\"contract-management\">\r\n    <!-- Sidebar -->\r\n    <div class=\"sidebar\">\r\n      <div class=\"logo\">\r\n        <img src=\"logo.png\" alt=\"Company Logo\" />\r\n        <p>COMPANY Logo</p>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Main Content -->\r\n    <div class=\"main-content\">\r\n      <div class=\"header\">\r\n        <h1>Contract Management</h1>\r\n        <p>Manage all contracts efficiently</p>\r\n      </div>\r\n\r\n      <!-- Form Section -->\r\n      <div class=\"form-section\">\r\n        <form @submit.prevent=\"addContract\" class=\"form\">\r\n          <div class=\"form-group\">\r\n            <label for=\"supplier\">Supplier</label>\r\n            <input v-model=\"newContract.supplier\" id=\"supplier\" type=\"text\" placeholder=\"Enter supplier name\" required />\r\n          </div>\r\n          <div class=\"form-group\">\r\n            <label for=\"poNumber\">PO Number</label>\r\n            <input v-model=\"newContract.poNumber\" id=\"poNumber\" type=\"text\" placeholder=\"Enter PO number\" required />\r\n          </div>\r\n          <div class=\"form-group\">\r\n            <label>Status</label>\r\n            <div class=\"status-options\">\r\n              <label>\r\n                <input type=\"radio\" value=\"Active\" v-model=\"newContract.status\" /> Active\r\n              </label>\r\n              <label>\r\n                <input type=\"radio\" value=\"Pending\" v-model=\"newContract.status\" /> Pending\r\n              </label>\r\n            </div>\r\n          </div>\r\n          <button type=\"submit\" class=\"btn-primary\">Add Contract</button>\r\n        </form>\r\n      </div>\r\n\r\n      <!-- No Contracts Message -->\r\n      <p v-if=\"!contracts.length\" class=\"no-contracts\">No contacts available.</p>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted } from \"vue\";\r\nimport { db } from \"@/firebase\";\r\nimport { collection, addDoc, getDocs } from \"firebase/firestore\"; // Removed unused imports\r\n\r\nexport default {\r\n  setup() {\r\n    const contracts = ref([]);\r\n    const newContract = ref({ supplier: \"\", poNumber: \"\", status: \"Pending\" });\r\n\r\n    const fetchContracts = async () => {\r\n      const querySnapshot = await getDocs(collection(db, \"contracts\"));\r\n      contracts.value = querySnapshot.docs.map((doc) => ({ id: doc.id, ...doc.data() }));\r\n    };\r\n\r\n    const addContract = async () => {\r\n      try {\r\n        await addDoc(collection(db, \"contracts\"), newContract.value);\r\n        alert(\"Contract added successfully\");\r\n        newContract.value = { supplier: \"\", poNumber: \"\", status: \"Pending\" };\r\n        fetchContracts();\r\n      } catch (error) {\r\n        console.error(\"Error adding contract:\", error);\r\n        alert(\"Failed to add contract. Please try again.\");\r\n      }\r\n    };\r\n\r\n    onMounted(fetchContracts);\r\n\r\n    return {\r\n      contracts,\r\n      newContract,\r\n      addContract,\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.contract-management {\r\n  display: flex;\r\n  min-height: 100vh;\r\n  background: url('@/assets/theme-selection-qyoN-HxFCRg-unsplash.jpg') no-repeat center center; /* Set new background image */\r\n  background-size: cover; /* Ensure the image covers the entire area */\r\n  color: #ffffff;\r\n}\r\n\r\n.sidebar {\r\n  width: 20%;\r\n  background-color: rgba(15, 41, 66, 0.9); /* Add transparency for better contrast */\r\n  color: white;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  padding: 20px;\r\n}\r\n\r\n.sidebar .logo {\r\n  text-align: center;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.sidebar .logo img {\r\n  width: 50px;\r\n  height: 50px;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.main-content {\r\n  width: 80%;\r\n  padding: 40px;\r\n  background-color: rgba(255, 255, 255, 0.9); /* Add transparency for better contrast */\r\n  border-radius: 12px;\r\n  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);\r\n  margin: auto;\r\n}\r\n\r\n.header {\r\n  text-align: center;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.header h1 {\r\n  font-size: 24px;\r\n  font-weight: bold;\r\n  color: #0f2942;\r\n}\r\n\r\n.header p {\r\n  font-size: 14px;\r\n  color: #718096;\r\n}\r\n\r\n.form-section {\r\n  margin-top: 20px;\r\n}\r\n\r\n.form-group {\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.form-group label {\r\n  display: block;\r\n  font-size: 14px;\r\n  font-weight: 500;\r\n  color: #0f2942;\r\n  margin-bottom: 5px;\r\n}\r\n\r\n.form-group input {\r\n  width: 100%;\r\n  padding: 10px;\r\n  border: 1px solid #cbd5e0;\r\n  border-radius: 4px;\r\n  font-size: 14px;\r\n}\r\n\r\n.status-options {\r\n  display: flex;\r\n  gap: 10px;\r\n}\r\n\r\n.status-options label {\r\n  font-size: 14px;\r\n  color: #4a5568;\r\n}\r\n\r\n.btn-primary {\r\n  background-color: #3182ce;\r\n  color: white;\r\n  padding: 10px 20px;\r\n  border: none;\r\n  border-radius: 4px;\r\n  font-size: 14px;\r\n  cursor: pointer;\r\n}\r\n\r\n.btn-primary:hover {\r\n  background-color: #2b6cb0;\r\n}\r\n\r\n.no-contracts {\r\n  text-align: center;\r\n  color: #718096;\r\n  font-size: 14px;\r\n  margin-top: 20px;\r\n}\r\n</style>"],"mappings":";AAkDA,SAASA,GAAG,EAAEC,SAAQ,QAAS,KAAK;AACpC,SAASC,EAAC,QAAS,YAAY;AAC/B,SAASC,UAAU,EAAEC,MAAM,EAAEC,OAAM,QAAS,oBAAoB,EAAE;;AAElE,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN,MAAMC,SAAQ,GAAIP,GAAG,CAAC,EAAE,CAAC;IACzB,MAAMQ,WAAU,GAAIR,GAAG,CAAC;MAAES,QAAQ,EAAE,EAAE;MAAEC,QAAQ,EAAE,EAAE;MAAEC,MAAM,EAAE;IAAU,CAAC,CAAC;IAE1E,MAAMC,cAAa,GAAI,MAAAA,CAAA,KAAY;MACjC,MAAMC,aAAY,GAAI,MAAMR,OAAO,CAACF,UAAU,CAACD,EAAE,EAAE,WAAW,CAAC,CAAC;MAChEK,SAAS,CAACO,KAAI,GAAID,aAAa,CAACE,IAAI,CAACC,GAAG,CAAEC,GAAG,KAAM;QAAEC,EAAE,EAAED,GAAG,CAACC,EAAE;QAAE,GAAGD,GAAG,CAACE,IAAI,CAAC;MAAE,CAAC,CAAC,CAAC;IACpF,CAAC;IAED,MAAMC,WAAU,GAAI,MAAAA,CAAA,KAAY;MAC9B,IAAI;QACF,MAAMhB,MAAM,CAACD,UAAU,CAACD,EAAE,EAAE,WAAW,CAAC,EAAEM,WAAW,CAACM,KAAK,CAAC;QAC5DO,KAAK,CAAC,6BAA6B,CAAC;QACpCb,WAAW,CAACM,KAAI,GAAI;UAAEL,QAAQ,EAAE,EAAE;UAAEC,QAAQ,EAAE,EAAE;UAAEC,MAAM,EAAE;QAAU,CAAC;QACrEC,cAAc,CAAC,CAAC;MAClB,EAAE,OAAOU,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,wBAAwB,EAAEA,KAAK,CAAC;QAC9CD,KAAK,CAAC,2CAA2C,CAAC;MACpD;IACF,CAAC;IAEDpB,SAAS,CAACW,cAAc,CAAC;IAEzB,OAAO;MACLL,SAAS;MACTC,WAAW;MACXY;IACF,CAAC;EACH;AACF,CAAC","ig